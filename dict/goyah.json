{"root":"goyah","ipa":"/ˈɡojah/","core":"形容物体或状态不稳、摇晃、动摇，常用于描述物理结构或抽象的意志、立场。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈɡojah/","zh":"摇晃的，不稳的，动摇的","phrases":[{"t":"goyah karena angin","zh":"因风而摇晃"},{"t":"pendirian yang goyah","zh":"动摇的立场"},{"t":"goyah dan tidak stabil","zh":"摇晃且不稳定"}],"examples":[{"t":"Tiang jembatan itu sudah goyah.","zh":"那座桥的桥墩已经摇晃了。"},{"t":"Imannya mulai goyah menghadapi cobaan.","zh":"面对考验，他的信仰开始动摇。"}]},"ders":[{"w":"goyah","ipa":"/ˈɡojah/","zh":"摇晃的","phrase":{"t":"goyah sedikit","zh":"轻微摇晃"},"example":{"t":"Meja ini goyah.","zh":"这张桌子摇晃。"}},{"w":"menggoyahkan","ipa":"/məŋɡojaɦkan/","zh":"使动摇，使摇晃","phrase":{"t":"menggoyahkan iman","zh":"动摇信仰"},"example":{"t":"Berita bohong itu bertujuan menggoyahkan kepercayaan publik.","zh":"那则假新闻旨在动摇公众的信任。"}},{"w":"tergoyah","ipa":"/tərɡojaɦ/","zh":"被动摇的，受到震动的","phrase":{"t":"tergoyah oleh keadaan","zh":"被局势所动摇"},"example":{"t":"Posisi politiknya tergoyah oleh skandal tersebut.","zh":"他的政治立场因那起丑闻而动摇。"}},{"w":"goyahan","ipa":"/ɡojaɦan/","zh":"摇晃（名词），动摇的状态","phrase":{"t":"goyahan hebat","zh":"剧烈的摇晃"},"example":{"t":"Goyahan gempa itu terasa hingga ke lantai atas.","zh":"地震的摇晃感一直传到了顶楼。"}}],"derSlugs":["goyah","menggoyahkan","tergoyah","goyahan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-30T15:34:02.694Z","src":"base"}