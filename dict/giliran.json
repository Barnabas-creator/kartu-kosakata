{"root":"giliran","ipa":"/ɡiliran/","core":"轮流，依次，轮到","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ɡiliran/","zh":"轮次，轮流，机会","phrases":[{"t":"giliran siapa","zh":"轮到谁了"},{"t":"mendapat giliran","zh":"得到轮次"},{"t":"giliran berikutnya","zh":"下一轮"}],"examples":[{"t":"Sekarang sudah giliran saya untuk masuk ke dalam.","zh":"现在轮到我进去了。"},{"t":"Kita harus sabar menunggu giliran.","zh":"我们必须耐心等待轮次。"}]},"ders":[{"w":"giliran","ipa":"/ɡiliran/","zh":"轮流，轮次","phrase":{"t":"sesuai giliran","zh":"按照轮流"},"example":{"t":"Tunggulah giliranmu dengan tertib.","zh":"请井然有序地等待你的轮次。"}},{"w":"bergiliran","ipa":"/bərɡiliran/","zh":"轮流地，交替","phrase":{"t":"bekerja bergiliran","zh":"轮流工作"},"example":{"t":"Mereka menjaga malam secara bergiliran.","zh":"他们轮流值夜班。"}},{"w":"menggilirkan","ipa":"/məŋɡilirkan/","zh":"使轮流，使交替","phrase":{"t":"menggilirkan tugas","zh":"轮流分派任务"},"example":{"t":"Guru itu menggilirkan tugas piket kepada setiap siswa.","zh":"老师将值日任务轮流分派给每个学生。"}}],"derSlugs":["giliran","bergiliran","menggilirkan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T02:28:06.806Z","src":"base"}