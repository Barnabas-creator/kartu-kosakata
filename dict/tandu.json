{"root":"tandu","ipa":"/tandu/","core":"抬，肩扛，用担架运送","pos":["动词"],"scenes":["生活"],"rootBlock":{"ipa":"/tandu/","zh":"抬，用担架或担子运送","phrases":[{"t":"tandu darurat","zh":"急救担架"},{"t":"mengusung tandu","zh":"抬担架"},{"t":"tidur di tandu","zh":"睡在担架上"}],"examples":[{"t":"Mereka membawa pasien itu dengan tandu.","zh":"他们用担架把那个病人抬走了。"},{"t":"Tandu itu terbuat dari bambu dan kain.","zh":"那个担架是用竹子和布做的。"}]},"ders":[{"w":"tandu","ipa":"/tandu/","zh":"担架，抬具","phrase":{"t":"membuat tandu","zh":"制作担架"},"example":{"t":"Petugas menyiapkan tandu untuk korban.","zh":"工作人员为伤员准备了担架。"}},{"w":"menandu","ipa":"/mənandu/","zh":"抬，扛","phrase":{"t":"menandu orang sakit","zh":"抬病人"},"example":{"t":"Empat orang pria menandu pasien ke puskesmas.","zh":"四个男人把病人抬到社区卫生所。"}},{"w":"tanduan","ipa":"/tanduan/","zh":"抬运的东西，担架运载量","phrase":{"t":"hasil tanduan","zh":"抬运的成果"},"example":{"t":"Tanduan itu sangat berat.","zh":"那个抬运的东西非常重。"}},{"w":"penandu","ipa":"/pənandu/","zh":"抬担架的人，轿夫","phrase":{"t":"penandu andal","zh":"可靠的抬轿人"},"example":{"t":"Para penandu berjalan dengan cepat.","zh":"抬担架的人走得很快。"}}],"derSlugs":["tandu","menandu","tanduan","penandu"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T17:29:46.780Z","src":"base"}