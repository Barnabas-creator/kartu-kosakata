{"root":"jelas","ipa":"/dʒəlas/","core":"清晰的，明确的，明白的","pos":["形容词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/dʒəlas/","zh":"形容事物、声音或表达方式清晰、易懂、无歧义。","phrases":[{"t":"jelas sekali","zh":"非常清楚"},{"t":"sudah jelas","zh":"已经很明确了"},{"t":"kurang jelas","zh":"不太清楚"}],"examples":[{"t":"Suaranya terdengar sangat jelas.","zh":"他的声音听起来非常清晰。"},{"t":"Alasannya tidak jelas.","zh":"理由不明确。"}]},"ders":[{"w":"jelas","ipa":"/dʒəlas/","zh":"清晰的","phrase":{"t":"jelas terlihat","zh":"清晰可见"},"example":{"t":"Tujuannya sudah jelas.","zh":"目标已经很明确了。"}},{"w":"menjelaskan","ipa":"/mən.dʒə.las.kan/","zh":"解释，说明","phrase":{"t":"menjelaskan masalah","zh":"解释问题"},"example":{"t":"Dia mencoba menjelaskan situasi itu.","zh":"他试图解释那种情况。"}},{"w":"penjelasan","ipa":"/pən.dʒə.la.san/","zh":"解释，说明（名词）","phrase":{"t":"meminta penjelasan","zh":"要求解释"},"example":{"t":"Saya butuh penjelasan lebih lanjut.","zh":"我需要进一步的解释。"}},{"w":"kejelasan","ipa":"/kə.dʒə.la.san/","zh":"清晰度，明确性","phrase":{"t":"kejelasan suara","zh":"声音的清晰度"},"example":{"t":"Kejelasan aturan itu sangat penting.","zh":"规则的明确性非常重要。"}},{"w":"memperjelas","ipa":"/məm.pər.dʒə.las/","zh":"使清晰，阐明","phrase":{"t":"memperjelas maksud","zh":"阐明意图"},"example":{"t":"Dia memperjelas poin tersebut.","zh":"他阐明了那一点。"}}],"derSlugs":["jelas","menjelaskan","penjelasan","kejelasan","memperjelas"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:29:26.408Z","src":"base"}