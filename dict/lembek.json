{"root":"lembek","ipa":"/lɛmbɛk/","core":"柔软的，软弱的，无力的","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/lɛmbɛk/","zh":"柔软的，松软的，意志薄弱的","phrases":[{"t":"tanah lembek","zh":"松软的土地"},{"t":"mental lembek","zh":"软弱的意志"},{"t":"nasi lembek","zh":"煮得太烂的米饭"}],"examples":[{"t":"Jalan di sini sangat lembek setelah hujan lebat.","zh":"大雨过后这里的路非常泥泞松软。"},{"t":"Jangan menjadi orang yang lembek saat menghadapi masalah.","zh":"面对问题时不要做一个软弱的人。"}]},"ders":[{"w":"lembek","ipa":"/lɛmbɛk/","zh":"柔软的，松软的","phrase":{"t":"tanah lembek","zh":"松软的土壤"},"example":{"t":"Kue ini teksturnya sangat lembek.","zh":"这款糕点的质地非常松软。"}},{"w":"kelembekan","ipa":"/kəlɛmbɛkan/","zh":"柔软度，软弱，优柔寡断","phrase":{"t":"kelembekan sikap","zh":"态度的软弱"},"example":{"t":"Kelembekan kepemimpinannya dikritik banyak orang.","zh":"他领导风格的软弱受到了许多人的批评。"}},{"w":"melembek","ipa":"/məlɛmbɛk/","zh":"变软，变得软弱","phrase":{"t":"roti melembek","zh":"面包变软"},"example":{"t":"Kue itu melembek karena dibiarkan di tempat terbuka.","zh":"那块蛋糕因为放在露天地方而变软了。"}},{"w":"melembekkan","ipa":"/məlɛmbɛkan/","zh":"使变软，使软化","phrase":{"t":"melembekkan daging","zh":"使肉变软"},"example":{"t":"Rebuslah daging itu untuk melembekkannya.","zh":"把那块肉煮一下以使它变软。"}}],"derSlugs":["lembek","kelembekan","melembek","melembekkan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-10-01T02:41:44.174Z","src":"base"}