{"root":"copot","ipa":"/ˈtʃopot/","core":"脱落、掉下、摘除","pos":["动词","形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈtʃopot/","zh":"指物体从原位脱落、掉下，或指将某物从固定处摘除、拆卸。","phrases":[{"t":"copot dari tempatnya","zh":"从原位脱落"},{"t":"gigi copot","zh":"掉牙"},{"t":"copot kancing","zh":"扣子掉了"}],"examples":[{"t":"Kancing bajunya copot satu.","zh":"他衬衫上掉了一颗扣子。"},{"t":"Gigi susunya sudah copot.","zh":"他的乳牙已经掉了。"}]},"ders":[{"w":"copot","ipa":"/ˈtʃopot/","zh":"脱落；摘除","phrase":{"t":"copot sepatu","zh":"脱鞋"},"example":{"t":"Tolong copot sepatumu sebelum masuk.","zh":"进屋前请把鞋脱掉。"}},{"w":"mencopot","ipa":"/mənˈtʃopot/","zh":"使脱落；摘下；撤职","phrase":{"t":"mencopot jabatan","zh":"撤销职务"},"example":{"t":"Direktur itu mencopot bawahannya yang tidak disiplin.","zh":"那位主管撤职了不守纪律的下属。"}},{"w":"mencopotkan","ipa":"/mənˈtʃopotkan/","zh":"使……脱落；把……摘下","phrase":{"t":"mencopotkan baut","zh":"把螺丝卸下"},"example":{"t":"Dia mencopotkan roda mobil yang rusak itu.","zh":"他把那辆坏掉的车轮卸了下来。"}},{"w":"tercopot","ipa":"/tərˈtʃopot/","zh":"意外脱落的；被摘下的","phrase":{"t":"tercopot sendiri","zh":"自己掉下来了"},"example":{"t":"Pegangan pintu itu tercopot karena sudah tua.","zh":"那个门把手因为太旧而脱落了。"}},{"w":"copotan","ipa":"/tʃopoˈtan/","zh":"拆卸下来的零件；脱落物","phrase":{"t":"barang copotan","zh":"拆机件（二手零件）"},"example":{"t":"Dia membeli mesin copotan untuk motornya.","zh":"他为他的摩托车买了一个拆机引擎。"}}],"derSlugs":["copot","mencopot","mencopotkan","tercopot","copotan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-10-01T02:17:24.056Z","src":"base"}