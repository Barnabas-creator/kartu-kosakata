{"root":"kawasan","ipa":"/kaˈwasan/","core":"指具有特定特征、行政规划或经济功能的广阔区域、地带或范围。","pos":["名词"],"scenes":["高频","工作"],"rootBlock":{"ipa":"/kaˈwasan/","zh":"区域，地带，范围","phrases":[{"t":"kawasan industri","zh":"工业区"},{"t":"kawasan perumahan","zh":"住宅区"},{"t":"kawasan konservasi","zh":"保护区"}],"examples":[{"t":"Pemerintah membangun kawasan industri baru di luar kota.","zh":"政府在城外建设了一个新的工业区。"},{"t":"Dilarang merokok di kawasan ini.","zh":"此区域内禁止吸烟。"}]},"ders":[{"w":"kawasan","ipa":"/kaˈwasan/","zh":"区域，地带","phrase":{"t":"kawasan bebas pajak","zh":"免税区"},"example":{"t":"Kawasan itu kini berkembang pesat.","zh":"那个区域现在发展迅速。"}},{"w":"berkawasan","ipa":"/bər.kaˈwasan/","zh":"具有区域特征的，分区的","phrase":{"t":"wilayah berkawasan","zh":"有区域划分的地区"},"example":{"t":"Proyek ini bersifat berkawasan.","zh":"这个项目具有区域性特征。"}},{"w":"mengkasawasan","ipa":"/məŋ.kaˈwasan/","zh":"区域化，规划为区域","phrase":{"t":"mengkasawasan tanah","zh":"土地区域化"},"example":{"t":"Mereka berencana mengkasawasan area tersebut.","zh":"他们计划将该地区进行区域化规划。"}}],"derSlugs":["kawasan","berkawasan","mengkasawasan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-28T09:11:45.541Z","src":"base"}