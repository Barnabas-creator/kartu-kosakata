{"root":"cepat","ipa":"/tʃepat/","core":"形容词：快的，迅速的；副词：快地，迅速地","pos":["形容词","动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/tʃepat/","zh":"形容动作、过程或时间发生得迅速、敏捷。","phrases":[{"t":"cepat sekali","zh":"非常快"},{"t":"jalan cepat","zh":"快走"},{"t":"cepat tanggap","zh":"反应迅速"}],"examples":[{"t":"Dia berlari sangat cepat.","zh":"他跑得非常快。"},{"t":"Tolong datang secepat mungkin.","zh":"请尽快赶来。"}]},"ders":[{"w":"cepat","ipa":"/tʃepat/","zh":"快的，迅速的","phrase":{"t":"cepat saji","zh":"快餐"},"example":{"t":"Waktu berlalu begitu cepat.","zh":"时间过得真快。"}},{"w":"secepatnya","ipa":"/sətʃepatɲa/","zh":"尽快地","phrase":{"t":"secepatnya mungkin","zh":"尽可能快地"},"example":{"t":"Harap kirim dokumen ini secepatnya.","zh":"请尽快发送这份文件。"}},{"w":"mempercepat","ipa":"/məmərtʃepat/","zh":"加速，加快","phrase":{"t":"mempercepat proses","zh":"加快进程"},"example":{"t":"Pemerintah berupaya mempercepat pembangunan.","zh":"政府正努力加快建设。"}},{"w":"percepatan","ipa":"/pərtʃəpatan/","zh":"加速，加速度","phrase":{"t":"percepatan ekonomi","zh":"经济加速"},"example":{"t":"Mobil itu memiliki percepatan yang tinggi.","zh":"那辆车有很高的加速度。"}},{"w":"kecepatan","ipa":"/kətʃəpatan/","zh":"速度","phrase":{"t":"kecepatan tinggi","zh":"高速"},"example":{"t":"Kereta itu melaju dengan kecepatan penuh.","zh":"那列火车以全速行驶。"}}],"derSlugs":["cepat","secepatnya","mempercepat","percepatan","kecepatan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:21:24.823Z","src":"base"}