{"root":"gagal","ipa":"/ˈɡa.ɡal/","core":"失败，未成功，破产","pos":["动词","形容词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/ˈɡa.ɡal/","zh":"失败，未能达到预期目标","phrases":[{"t":"gagal jantung","zh":"心力衰竭"},{"t":"gagal paham","zh":"理解错误"},{"t":"gagal total","zh":"彻底失败"}],"examples":[{"t":"Ujian ini membuat dia gagal.","zh":"这次考试让他失败了。"},{"t":"Usaha mereka gagal di tengah jalan.","zh":"他们的生意在半途失败了。"}]},"ders":[{"w":"gagal","ipa":"/ˈɡa.ɡal/","zh":"失败的，未成功的","phrase":{"t":"upaya gagal","zh":"失败的尝试"},"example":{"t":"Proyek itu gagal karena kurang dana.","zh":"那个项目因资金不足而失败了。"}},{"w":"kegagalan","ipa":"/kə.ɡaˈɡa.lan/","zh":"失败，故障，挫折","phrase":{"t":"kegagalan sistem","zh":"系统故障"},"example":{"t":"Kegagalan adalah awal dari kesuksesan.","zh":"失败是成功之母。"}},{"w":"menggagalkan","ipa":"/məŋˈɡa.ɡal.kan/","zh":"挫败，阻止，使失败","phrase":{"t":"menggagalkan rencana","zh":"挫败计划"},"example":{"t":"Polisi berhasil menggagalkan aksi perampokan itu.","zh":"警方成功挫败了那起抢劫案。"}},{"w":"tergagal","ipa":"/tərˈɡa.ɡal/","zh":"最失败的","phrase":{"t":"proyek tergagal","zh":"最失败的项目"},"example":{"t":"Itu adalah pengalaman tergagal dalam hidupnya.","zh":"那是他生命中最失败的经历。"}},{"w":"kegagal-gagalan","ipa":"/kə.ɡa.ɡalˈɡa.ɡa.lan/","zh":"有点失败的，表现出失败倾向的","phrase":{"t":"sikap kegagal-gagalan","zh":"显得有些失败的态度"},"example":{"t":"Dia menunjukkan gelagat kegagal-gagalan dalam ujian itu.","zh":"他在考试中表现出了一些要失败的迹象。"}},{"w":"penggagal","ipa":"/pəŋˈɡa.ɡal/","zh":"导致失败的人或事物，破坏者","phrase":{"t":"penggagal sistem","zh":"系统的破坏者"},"example":{"t":"Dia dianggap sebagai penggagal kesepakatan itu.","zh":"他被认为是那项协议的破坏者。"}},{"w":"penggagalan","ipa":"/pəŋ.ɡaˈɡa.lan/","zh":"挫败，阻挠，使失败（名词）","phrase":{"t":"penggagalan kudeta","zh":"挫败政变"},"example":{"t":"Penggagalan serangan itu menyelamatkan banyak nyawa.","zh":"挫败那次袭击拯救了许多生命。"}},{"w":"menggagalkan-nggagalkan","ipa":"/məŋˈɡa.ɡal.kan.ŋɡaˈɡa.lkan/","zh":"屡次挫败，一再破坏","phrase":{"t":"menggagalkan-nggagalkan usaha","zh":"一再破坏努力"},"example":{"t":"Mereka terus menggagalkan-nggagalkan perdamaian.","zh":"他们一直在屡次破坏和平努力。"}},{"w":"tergagalkan","ipa":"/tər.ɡaˈɡal.kan/","zh":"能够被挫败的，可能失败的","phrase":{"t":"dapat tergagalkan","zh":"可以被挫败的"},"example":{"t":"Rencana jahat itu akhirnya tergagalkan.","zh":"那个邪恶的计划最终被挫败了。"}},{"w":"segagal-gagalnya","ipa":"/sə.ɡa.ɡalˈɡa.ɡal.nya/","zh":"无论如何失败，就算再失败","phrase":{"t":"segagal-gagalnya usaha","zh":"无论努力多么失败"},"example":{"t":"Segagal-gagalnya dia, dia tetap mencoba.","zh":"不管怎么失败，他依然在尝试。"}},{"w":"gagal-gagalan","ipa":"/ɡa.ɡalˈɡa.ɡa.lan/","zh":"半途而废的，不彻底失败的","phrase":{"t":"usaha gagal-gagalan","zh":"半途而废的努力"},"example":{"t":"Jangan melakukan sesuatu secara gagal-gagalan.","zh":"做事不要半途而废。"}},{"w":"mempergagal","ipa":"/məm.pərˈɡa.ɡal/","zh":"使变得更加失败（罕用）","phrase":{"t":"mempergagal keadaan","zh":"使局势更糟"},"example":{"t":"Tindakannya justru mempergagal situasi.","zh":"他的举动反而使局势雪上加霜。"}},{"w":"mempergagalkan","ipa":"/məm.pərˈɡa.ɡal.kan/","zh":"使遭受失败","phrase":{"t":"mempergagalkan proyek","zh":"使项目遭受失败"},"example":{"t":"Keputusan itu mempergagalkan semua rencana.","zh":"那个决定让所有的计划都泡汤了。"}},{"w":"dipergagal","ipa":"/di.pərˈɡa.ɡal/","zh":"被弄得失败的","phrase":{"t":"keadaan dipergagal","zh":"被搞砸的情况"},"example":{"t":"Proyek itu dipergagal oleh kesalahan sendiri.","zh":"那个项目由于自身的错误而被搞砸了。"}},{"w":"dipergagalkan","ipa":"/di.pərˈɡa.ɡal.kan/","zh":"被使之失败的","phrase":{"t":"rencana dipergagalkan","zh":"被使之失败的计划"},"example":{"t":"Rencana tersebut telah dipergagalkan pihak lawan.","zh":"该计划已被对手破坏。"}},{"w":"sepertigagal","ipa":"/sə.pər.tiˈɡa.ɡal/","zh":"类似于失败的","phrase":{"t":"hasil sepertigagal","zh":"类似失败的结果"},"example":{"t":"Kondisinya sepertigagal tahun lalu.","zh":"他的情况和去年差不多算失败。"}},{"w":"berkegagalan","ipa":"/bər.kə.ɡaˈɡa.lan/","zh":"经历失败，带有失败特质","phrase":{"t":"hidup berkegagalan","zh":"充满失败的生活"},"example":{"t":"Dia tidak takut hidup berkegagalan.","zh":"他不害怕充满挫折的人生。"}},{"w":"taktergagal","ipa":"/tak.tərˈɡa.ɡal/","zh":"不可挫败的，不会失败的","phrase":{"t":"tekad taktergagal","zh":"不可动摇的决心"},"example":{"t":"Mereka memiliki semangat taktergagal.","zh":"他们拥有不可被挫败的精神。"}},{"w":"kegagalan-kegagalan","ipa":"/kə.ɡaˈɡa.lan.kə.ɡaˈɡa.lan/","zh":"多次失败，各种挫折（复数形式）","phrase":{"t":"kegagalan-kegagalan masa lalu","zh":"过去的种种失败"},"example":{"t":"Kegagalan-kegagalan itu membuatnya lebih kuat.","zh":"那些失败使他变得更坚强。"}},{"w":"penggagal-penggagal","ipa":"/pəŋˈɡa.ɡal.pəŋˈɡa.ɡal/","zh":"破坏者们，失败制造者们","phrase":{"t":"penggagal-penggagal perdamaian","zh":"和平的破坏者们"},"example":{"t":"Para penggagal-penggagal itu berhasil ditangkap.","zh":"那些破坏者们都被成功抓获了。"}},{"w":"pengegagal","ipa":"/pəŋ.əˈɡa.ɡal/","zh":"习惯性失败者","phrase":{"t":"menjadi penegegal","zh":"变成常败将军"},"example":{"t":"Dia tidak mau menjadi penegegal.","zh":"他不想当个屡战屡败的人。"}},{"w":"tergagal-gagal","ipa":"/tər.ɡa.ɡalˈɡa.ɡal/","zh":"不断陷入失败的","phrase":{"t":"situasi tergagal-gagal","zh":"不断失败的局面"},"example":{"t":"Perusahaan itu berada dalam fase tergagal-gagal.","zh":"那家公司正处于不断失败的阶段。"}},{"w":"megagal","ipa":"/məˈɡa.ɡal/","zh":"失败（口语变体）","phrase":{"t":"megagal lagi","zh":"又失败了"},"example":{"t":"Dia megagal dalam ujian praktik.","zh":"他在实操考试中失败了。"}},{"w":"megagalkan","ipa":"/məˈɡa.ɡal.kan/","zh":"挫败（口语变体）","phrase":{"t":"megagalkan aksi","zh":"挫败行动"},"example":{"t":"Warga megagalkan pencurian itu.","zh":"居民们挫败了那起偷盗。"}},{"w":"tergagalkan-gagalkan","ipa":"/tər.ɡa.ɡal.kan.ɡaˈɡa.lkan/","zh":"一再被破坏的","phrase":{"t":"upaya tergagalkan-gagalkan","zh":"一再被破坏的努力"},"example":{"t":"Upaya mereka tergagalkan-gagalkan oleh cuaca.","zh":"他们的努力一再被天气破坏。"}},{"w":"kegagalanmu","ipa":"/kə.ɡaˈɡa.lan.mu/","zh":"你的失败","phrase":{"t":"akui kegagalanmu","zh":"承认你的失败"},"example":{"t":"Jangan pernah sesali kegagalanmu.","zh":"永远不要后悔你的失败。"}},{"w":"kegagalannya","ipa":"/kə.ɡaˈɡa.lan.nya/","zh":"他的失败","phrase":{"t":"penyebab kegagalannya","zh":"他失败的原因"},"example":{"t":"Semua orang tahu alasan kegagalannya.","zh":"所有人都知道他失败的原因。"}},{"w":"gagalnya","ipa":"/ɡaˈɡal.nya/","zh":"……的失败","phrase":{"t":"gagalnya negosiasi","zh":"谈判的失败"},"example":{"t":"Gagalnya proyek ini sangat disayangkan.","zh":"这个项目的失败令人感到非常遗憾。"}},{"w":"menggagalkannya","ipa":"/məŋˈɡa.ɡal.kan.nya/","zh":"使之失败，挫败它","phrase":{"t":"menggagalkannya dengan cepat","zh":"迅速挫败它"},"example":{"t":"Polisi langsung bertindak dan menggagalkannya.","zh":"警方立刻采取行动并将其挫败。"}},{"w":"segagalnya","ipa":"/sə.ɡaˈɡal.nya/","zh":"尽其所能失败（比喻极端情况）","phrase":{"t":"berusaha segagalnya","zh":"彻底搞砸一切"},"example":{"t":"Dia tidak ingin mencoba segagalnya.","zh":"他不想把所有事情都搞砸。"}}],"derSlugs":["gagal","kegagalan","menggagalkan","tergagal","kegagal-gagalan","penggagal","penggagalan","menggagalkan-nggagalkan","tergagalkan","segagal-gagalnya","gagal-gagalan","mempergagal","mempergagalkan","dipergagal","dipergagalkan","sepertigagal","berkegagalan","taktergagal","kegagalan-kegagalan","penggagal-penggagal","pengegagal","tergagal-gagal","megagal","megagalkan","tergagalkan-gagalkan","kegagalanmu","kegagalannya","gagalnya","menggagalkannya","segagalnya"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-25T10:01:54.939Z","src":"base"}