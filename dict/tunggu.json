{"root":"tunggu","ipa":"/tuŋɡu/","core":"等待，等候；停留，逗留","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/tuŋɡu/","zh":"等待，等候；停留，逗留","phrases":[{"t":"tunggu sebentar","zh":"等一会儿"},{"t":"menunggu giliran","zh":"等待轮次"},{"t":"tunggu kabar","zh":"等待消息"}],"examples":[{"t":"Tunggu saya di depan stasiun.","zh":"在车站前面等我。"},{"t":"Kita harus tunggu keputusan dari atasan.","zh":"我们必须等待上级的决定。"}]},"ders":[{"w":"tunggu","ipa":"/tuŋɡu/","zh":"等待（原型词）","phrase":{"t":"tunggu dulu","zh":"先等一下"},"example":{"t":"Tunggu di sini sampai saya kembali.","zh":"在这里等我直到我回来。"}},{"w":"menunggu","ipa":"/mənuŋɡu/","zh":"正在等待","phrase":{"t":"menunggu waktu","zh":"等待时机"},"example":{"t":"Ibu sedang menunggu kedatangan tamu.","zh":"母亲正在等待客人的到来。"}},{"w":"menunggukan","ipa":"/mənuŋɡukan/","zh":"使……等待","phrase":{"t":"menunggukan orang","zh":"让人等待"},"example":{"t":"Jangan menunggukan tamu terlalu lama.","zh":"不要让客人等太久。"}},{"w":"penunggu","ipa":"/pənuŋɡu/","zh":"守候者，看守人，（传说中的）守护灵","phrase":{"t":"penunggu rumah","zh":"看家的人"},"example":{"t":"Dia adalah penunggu setia toko itu.","zh":"他是那家店忠实的看守人。"}},{"w":"penungguan","ipa":"/pənuŋɡuan/","zh":"等待的过程，等候","phrase":{"t":"ruang penungguan","zh":"等候室"},"example":{"t":"Penungguan yang lama itu membuatnya bosan.","zh":"那漫长的等待让他感到厌烦。"}},{"w":"tertunggu-tunggu","ipa":"/tərtuŋɡutuŋɡu/","zh":"一直期待着，焦急地等待","phrase":{"t":"tertunggu-tunggu kabar","zh":"焦急地等待消息"},"example":{"t":"Kami tertunggu-tunggu kedatangannya.","zh":"我们一直焦急地等待着他的到来。"}}],"derSlugs":["tunggu","menunggu","menunggukan","penunggu","penungguan","tertunggu-tunggu"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:19:20.611Z","src":"base"}