{"root":"tar","ipa":"/tar/","core":"拉，拖，拽；（通过拉动）移动物体；（引申为）吸引、招引。","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/tar/","zh":"拉，拖，拽","phrases":[{"t":"tar napas","zh":"深呼吸"},{"t":"tar diri","zh":"退出，撤退"},{"t":"tar perhatian","zh":"吸引注意力"}],"examples":[{"t":"Dia menarik kursi itu ke dekat meja.","zh":"他把那把椅子拉到桌子旁边。"},{"t":"Jangan menarik rambut temanmu.","zh":"不要拉你朋友的头发。"}]},"ders":[{"w":"tarik","ipa":"/ta.rik/","zh":"拉，拽（tar 的完整动词形式）","phrase":{"t":"tarik ulur","zh":"拉锯战，反复博弈"},"example":{"t":"Tariklah tali ini dengan kuat.","zh":"用力拉这根绳子。"}},{"w":"tarikan","ipa":"/ta.ri.kan/","zh":"拉力，牵引力","phrase":{"t":"tarikan gravitasi","zh":"重力牵引"},"example":{"t":"Tarikan mesin mobil itu sangat kuat.","zh":"那辆车的引擎牵引力非常强。"}},{"w":"penarik","ipa":"/pə.na.rik/","zh":"拉动者，牵引装置","phrase":{"t":"penarik becak","zh":"三轮车夫"},"example":{"t":"Dia bekerja sebagai penarik gerobak.","zh":"他以拉板车为生。"}},{"w":"tertarik","ipa":"/tər.ta.rik/","zh":"被吸引的，感兴趣的","phrase":{"t":"tertarik pada","zh":"对……感兴趣"},"example":{"t":"Saya sangat tertarik dengan tawaran itu.","zh":"我对那个提议很感兴趣。"}},{"w":"ketertarikan","ipa":"/kə.tər.ta.ri.kan/","zh":"兴趣，吸引力","phrase":{"t":"ketertarikan seksual","zh":"性吸引力"},"example":{"t":"Dia menunjukkan ketertarikan yang besar pada seni.","zh":"他对艺术表现出了浓厚的兴趣。"}}],"derSlugs":["tar","tarik","tarikan","penarik","tertarik","ketertarikan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T08:49:07.155Z","src":"base"}