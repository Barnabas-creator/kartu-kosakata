{"root":"sedih","ipa":"/səˈdɪh/","core":"形容词，表示悲伤、难过、忧伤，指内心感到痛苦或不快乐的状态。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/səˈdɪh/","zh":"悲伤的，难过的","phrases":[{"t":"merasa sedih","zh":"感到悲伤"},{"t":"sangat sedih","zh":"非常难过"},{"t":"berita sedih","zh":"悲伤的消息"}],"examples":[{"t":"Saya merasa sedih mendengar kabar itu.","zh":"听到那个消息我感到很难过。"},{"t":"Jangan sedih, semuanya akan baik-baik saja.","zh":"别难过，一切都会好起来的。"}]},"ders":[{"w":"sedih","ipa":"/səˈdɪh/","zh":"悲伤的","phrase":{"t":"wajah sedih","zh":"悲伤的脸庞"},"example":{"t":"Dia tampak sedih hari ini.","zh":"他今天看起来很悲伤。"}},{"w":"kesedihan","ipa":"/kəsəˈdɪhan/","zh":"悲伤（名词），忧伤","phrase":{"t":"mendalam kesedihan","zh":"深切的悲伤"},"example":{"t":"Dia tidak bisa menyembunyikan kesedihannya.","zh":"他无法掩饰自己的悲伤。"}},{"w":"menyedihkan","ipa":"/mənəˈdɪhkan/","zh":"令人悲伤的，可悲的","phrase":{"t":"hal yang menyedihkan","zh":"令人难过的事情"},"example":{"t":"Kondisi rumah itu sangat menyedihkan.","zh":"那房子的状况非常令人难过。"}},{"w":"tersedih","ipa":"/tərˈsədɪh/","zh":"最悲伤的","phrase":{"t":"momen tersedih","zh":"最悲伤的时刻"},"example":{"t":"Itu adalah hari tersedih dalam hidupnya.","zh":"那是他生命中最悲伤的一天。"}}],"derSlugs":["sedih","kesedihan","menyedihkan","tersedih"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:55:18.609Z","src":"base"}