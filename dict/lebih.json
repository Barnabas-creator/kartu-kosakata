{"root":"lebih","ipa":"/ˈlɛbih/","core":"表示程度的增加、超过或多于某一点，常用于比较级或表达剩余。","pos":["形容词","虚词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/ˈlɛbih/","zh":"多，超过，更","phrases":[{"t":"lebih baik","zh":"更好"},{"t":"lebih banyak","zh":"更多"},{"t":"lebih kurang","zh":"大约，或多或少"}],"examples":[{"t":"Dia lebih tinggi daripada kakaknya.","zh":"他比他哥哥更高。"},{"t":"Saya tidak punya uang lebih.","zh":"我没有多余的钱。"}]},"ders":[{"w":"lebih","ipa":"/ˈlɛbih/","zh":"多，超过","phrase":{"t":"lebih dari","zh":"超过"},"example":{"t":"Harganya lebih dari seratus ribu.","zh":"价格超过十万。"}},{"w":"melebihkan","ipa":"/məˈlɛbihkan/","zh":"增加，多给，夸大","phrase":{"t":"melebihkan porsi","zh":"增加份量"},"example":{"t":"Jangan melebihkan cerita itu.","zh":"不要夸大那个故事。"}},{"w":"berlebihan","ipa":"/bərlɛˈbihan/","zh":"过度的，过分的","phrase":{"t":"secara berlebihan","zh":"过度地"},"example":{"t":"Makan terlalu berlebihan tidak sehat.","zh":"吃得太过度不健康。"}},{"w":"kelebihan","ipa":"/kəlɛˈbihan/","zh":"优点，过剩，多余","phrase":{"t":"kelebihan berat badan","zh":"超重"},"example":{"t":"Salah satu kelebihannya adalah jujur.","zh":"他的优点之一是诚实。"}}],"derSlugs":["lebih","melebihkan","berlebihan","kelebihan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:15:07.101Z","src":"base"}