{"root":"maaf","ipa":"/maʔaf/","core":"原谅、抱歉、对不起。用于表示歉意或请求宽恕。","pos":["名词","动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/maʔaf/","zh":"原谅、抱歉","phrases":[{"t":"minta maaf","zh":"道歉"},{"t":"maafkan saya","zh":"请原谅我"},{"t":"kata maaf","zh":"道歉的话"}],"examples":[{"t":"Saya minta maaf atas kesalahan saya.","zh":"我为我的错误道歉。"},{"t":"Maaf, bolehkah saya lewat?","zh":"对不起，我可以过去吗？"}]},"ders":[{"w":"maaf","ipa":"/maʔaf/","zh":"原谅、抱歉","phrase":{"t":"maaf lahir batin","zh":"请求身心宽恕（开斋节常用语）"},"example":{"t":"Maaf, saya terlambat.","zh":"抱歉，我迟到了。"}},{"w":"memaafkan","ipa":"/məmaʔafkan/","zh":"原谅（某人）","phrase":{"t":"sulit memaafkan","zh":"难以原谅"},"example":{"t":"Dia akhirnya memaafkan kesalahan temannya.","zh":"他最终原谅了朋友的过错。"}},{"w":"pemaaf","ipa":"/pəmaʔaf/","zh":"宽宏大量的人","phrase":{"t":"orang pemaaf","zh":"宽容的人"},"example":{"t":"Dia dikenal sebagai orang yang pemaaf.","zh":"他以宽宏大量而闻名。"}},{"w":"kemaafan","ipa":"/kəmaʔafan/","zh":"宽恕、原谅（名词）","phrase":{"t":"memohon kemaafan","zh":"请求宽恕"},"example":{"t":"Dia datang untuk memohon kemaafan.","zh":"他来请求宽恕。"}}],"derSlugs":["maaf","memaafkan","pemaaf","kemaafan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:18:03.370Z","src":"base"}