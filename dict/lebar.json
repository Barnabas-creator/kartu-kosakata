{"root":"lebar","ipa":"/lɛbar/","core":"形容词，指物体在横向上的尺寸，即宽度、宽阔或广阔。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/lɛbar/","zh":"宽的，宽阔的","phrases":[{"t":"lebar jalan","zh":"道路宽度"},{"t":"lebar dada","zh":"胸围"},{"t":"seluas dan selebar","zh":"尽可能广阔"}],"examples":[{"t":"Sungai itu sangat lebar.","zh":"那条河非常宽。"},{"t":"Berapa lebar meja ini?","zh":"这张桌子有多宽？"}]},"ders":[{"w":"lebar","ipa":"/lɛbar/","zh":"宽的","phrase":{"t":"lebar bahu","zh":"肩宽"},"example":{"t":"Kain ini memiliki lebar dua meter.","zh":"这块布有两米宽。"}},{"w":"melebarkan","ipa":"/məlɛbarkan/","zh":"使变宽，扩宽","phrase":{"t":"melebarkan jalan","zh":"拓宽道路"},"example":{"t":"Pemerintah berencana melebarkan jalan raya itu.","zh":"政府计划拓宽那条公路。"}},{"w":"kelebaran","ipa":"/kələbaran/","zh":"宽度，过宽","phrase":{"t":"kelebaran baju","zh":"衣服的宽度"},"example":{"t":"Baju ini kelebaran untuk saya.","zh":"这件衣服对我来说太宽了。"}},{"w":"selebar","ipa":"/sələbar/","zh":"一样宽，宽达","phrase":{"t":"selebar telapak tangan","zh":"手掌般宽"},"example":{"t":"Lukisan itu selebar dinding kamar.","zh":"那幅画和房间墙壁一样宽。"}}],"derSlugs":["lebar","melebarkan","kelebaran","selebar"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T02:36:12.907Z","src":"base"}