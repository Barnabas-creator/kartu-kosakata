{"root":"goyang","ipa":"/ɡo.jaŋ/","core":"摇动、晃动、摆动，指物体或身体的左右或前后摆动。","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ɡo.jaŋ/","zh":"摇动、晃动","phrases":[{"t":"goyang lidah","zh":"品尝美食、享受口福"},{"t":"goyang kaki","zh":"闲着没事做、无所事事"},{"t":"goyang badan","zh":"扭动身体"}],"examples":[{"t":"Pohon itu bergoyang ditiup angin kencang.","zh":"那棵树在强风的吹拂下摇晃。"},{"t":"Jangan goyang meja ini saat saya menulis.","zh":"我写字的时候不要晃动这张桌子。"}]},"ders":[{"w":"goyang","ipa":"/ɡo.jaŋ/","zh":"摇动","phrase":{"t":"goyang kepala","zh":"摇头"},"example":{"t":"Gigi susunya sudah mulai goyang.","zh":"他的乳牙已经开始松动了。"}},{"w":"bergoyang","ipa":"/bər.ɡo.jaŋ/","zh":"摇晃着、摆动着","phrase":{"t":"bergoyang-goyang","zh":"不停地摇晃"},"example":{"t":"Mereka bergoyang mengikuti irama musik.","zh":"他们随着音乐的节奏摇摆。"}},{"w":"menggoyangkan","ipa":"/məŋ.ɡo.jaŋ.kan/","zh":"使……摇动","phrase":{"t":"menggoyangkan badan","zh":"使身体摇动"},"example":{"t":"Dia menggoyangkan pohon itu agar buahnya jatuh.","zh":"他摇动那棵树以便让果实掉下来。"}},{"w":"goyangan","ipa":"/ɡo.ja.ŋan/","zh":"摇晃、摆动（名词）","phrase":{"t":"goyangan pinggul","zh":"臀部的扭动"},"example":{"t":"Goyangan penari itu sangat luwes.","zh":"那位舞者的摆动非常灵活。"}}],"derSlugs":["goyang","bergoyang","menggoyangkan","goyangan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T02:46:26.742Z","src":"base"}