{"root":"tua","ipa":"/tu.a/","core":"指生物或物体存在时间长，即“老”、“旧”、“年长”或“成熟”。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/tu.a/","zh":"老，年长，旧","phrases":[{"t":"orang tua","zh":"父母"},{"t":"sudah tua","zh":"已经老了"},{"t":"hari tua","zh":"晚年"}],"examples":[{"t":"Kakek saya sudah sangat tua.","zh":"我的祖父已经非常老了。"},{"t":"Dia lebih tua daripada saya.","zh":"他比我年长。"}]},"ders":[{"w":"tua","ipa":"/tu.a/","zh":"老，年长","phrase":{"t":"tua bangka","zh":"老态龙钟的"},"example":{"t":"Pohon itu sudah tua.","zh":"那棵树已经老了。"}},{"w":"menua","ipa":"/mə.nu.a/","zh":"变老，衰老","phrase":{"t":"proses menua","zh":"衰老过程"},"example":{"t":"Semua makhluk hidup pasti menua.","zh":"所有生物都会变老。"}},{"w":"penuaan","ipa":"/pə.nu.a.an/","zh":"老化，衰老（过程）","phrase":{"t":"penuaan dini","zh":"早衰"},"example":{"t":"Krim ini mencegah penuaan kulit.","zh":"这款面霜可以防止皮肤老化。"}},{"w":"ketuaan","ipa":"/kə.tu.a.an/","zh":"太老，过老","phrase":{"t":"buah ketuaan","zh":"过熟的水果"},"example":{"t":"Sayur ini sudah ketuaan sehingga keras.","zh":"这蔬菜太老了，所以很硬。"}}],"derSlugs":["tua","menua","penuaan","ketuaan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:33:22.643Z","src":"base"}