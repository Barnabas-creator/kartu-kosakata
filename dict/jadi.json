{"root":"jadi","ipa":"/ˈdʒadi/","core":"成为，变成，发生，所以","pos":["动词","虚词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈdʒadi/","zh":"成为、变成；作为连词表示“所以、因此”。","phrases":[{"t":"jadi apa","zh":"变成什么"},{"t":"jadi kenyataan","zh":"成为现实"},{"t":"jadi begini","zh":"变成这样"}],"examples":[{"t":"Dia ingin jadi dokter.","zh":"他想成为一名医生。"},{"t":"Hujan turun, jadi saya tidak pergi.","zh":"下雨了，所以我没去。"}]},"ders":[{"w":"jadi","ipa":"/ˈdʒadi/","zh":"成为，所以","phrase":{"t":"jadi orang","zh":"成为一个有用的人"},"example":{"t":"Semua sudah jadi.","zh":"一切都完成了。"}},{"w":"menjadi","ipa":"/məˈndʒadi/","zh":"变成，成为","phrase":{"t":"menjadi saksi","zh":"成为证人"},"example":{"t":"Dia menjadi ketua kelas.","zh":"他成为了班长。"}},{"w":"menjadikan","ipa":"/mənˈdʒadikan/","zh":"使成为，使变成","phrase":{"t":"menjadikan alasan","zh":"作为理由"},"example":{"t":"Pengalaman itu menjadikannya lebih kuat.","zh":"那次经历使他变得更强大。"}},{"w":"kejadian","ipa":"/kəˈdʒadian/","zh":"事件，发生","phrase":{"t":"kejadian aneh","zh":"奇怪的事件"},"example":{"t":"Bagaimana kejadian itu bermula?","zh":"那件事是怎么开始的？"}},{"w":"terjadi","ipa":"/tərˈdʒadi/","zh":"发生","phrase":{"t":"apa yang terjadi","zh":"发生了什么"},"example":{"t":"Kecelakaan itu terjadi kemarin.","zh":"那起事故发生在昨天。"}}],"derSlugs":["jadi","menjadi","menjadikan","kejadian","terjadi"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:11:41.898Z","src":"base"}