{"root":"datang","ipa":"/da.taŋ/","core":"指从别处移动到说话人所在的位置或目的地，即“来”或“到达”。","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/da.taŋ/","zh":"来，到达","phrases":[{"t":"datang terlambat","zh":"迟到"},{"t":"datang berkunjung","zh":"来访"},{"t":"datang tepat waktu","zh":"准时到达"}],"examples":[{"t":"Dia datang ke rumah saya kemarin.","zh":"他昨天来我家了。"},{"t":"Kapan kamu akan datang?","zh":"你什么时候会来？"}]},"ders":[{"w":"datang","ipa":"/da.taŋ/","zh":"来","phrase":{"t":"datang tiba-tiba","zh":"突然到来"},"example":{"t":"Musim hujan sudah datang.","zh":"雨季已经来了。"}},{"w":"kedatangan","ipa":"/kə.da.ta.ŋan/","zh":"到达，到来（名词）","phrase":{"t":"jadwal kedatangan","zh":"到达时刻表"},"example":{"t":"Kami menunggu kedatangan tamu penting.","zh":"我们正在等待重要客人的到来。"}},{"w":"mendatangi","ipa":"/mən.da.ta.ŋi/","zh":"前往，造访","phrase":{"t":"mendatangi lokasi","zh":"前往现场"},"example":{"t":"Polisi mendatangi tempat kejadian perkara.","zh":"警察前往案发现场。"}},{"w":"mendatangkan","ipa":"/mən.da.taŋ.kan/","zh":"带来，引起，引进","phrase":{"t":"mendatangkan keuntungan","zh":"带来利润"},"example":{"t":"Keputusan itu mendatangkan masalah baru.","zh":"那个决定带来了新的问题。"}}],"derSlugs":["datang","kedatangan","mendatangi","mendatangkan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:16:48.035Z","src":"base"}