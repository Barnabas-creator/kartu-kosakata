{"root":"saya","ipa":"/sa.ja/","core":"第一人称代词，意为“我”。在正式、半正式或礼貌场合使用，用于指代说话者本人。","pos":["名词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/sa.ja/","zh":"我","phrases":[{"t":"saya sendiri","zh":"我自己"},{"t":"terima kasih saya","zh":"我的感谢"},{"t":"kepada saya","zh":"对我"}],"examples":[{"t":"Saya sedang belajar bahasa Indonesia.","zh":"我正在学习印尼语。"},{"t":"Apakah Anda bisa membantu saya?","zh":"你能帮我吗？"}]},"ders":[{"w":"saya","ipa":"/sa.ja/","zh":"我","phrase":{"t":"nama saya","zh":"我的名字"},"example":{"t":"Saya ingin pergi ke pasar.","zh":"我想去市场。"}},{"w":"menyaya","ipa":"/mə.ɲa.ja/","zh":"（罕见）自称，以“我”自居","phrase":{"t":"menyaya diri","zh":"自称"},"example":{"t":"Dia menyaya sebagai orang penting.","zh":"他自称是一个重要人物。"}}],"derSlugs":["saya","menyaya"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:12:22.565Z","src":"base"}