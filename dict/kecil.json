{"root":"kecil","ipa":"/kətʃil/","core":"形容词。指体积、面积、程度、数量或年龄较小；也指微不足道或不重要的事物。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/kətʃil/","zh":"小","phrases":[{"t":"anak kecil","zh":"小孩"},{"t":"kecil hati","zh":"灰心，气馁"},{"t":"sedikit-sedikit","zh":"一点一点地"}],"examples":[{"t":"Rumah itu sangat kecil.","zh":"那间房子非常小。"},{"t":"Jangan meremehkan hal yang kecil.","zh":"不要轻视微小的事情。"}]},"ders":[{"w":"kecil","ipa":"/kətʃil/","zh":"小的","phrase":{"t":"kecil sekali","zh":"非常小"},"example":{"t":"Dia masih kecil.","zh":"他还很小。"}},{"w":"mengecil","ipa":"/məŋətʃil/","zh":"变小，缩小","phrase":{"t":"mengecil perlahan","zh":"慢慢变小"},"example":{"t":"Api itu mulai mengecil.","zh":"火势开始变小了。"}},{"w":"mengecilkan","ipa":"/məŋətʃilkan/","zh":"使变小，缩小（某物）","phrase":{"t":"mengecilkan volume","zh":"调小音量"},"example":{"t":"Tolong kecilkan suara radio itu.","zh":"请把收音机的声音调小。"}},{"w":"terkecil","ipa":"/tərkətʃil/","zh":"最小的","phrase":{"t":"bagian terkecil","zh":"最小的部分"},"example":{"t":"Ini adalah masalah terkecil kita.","zh":"这是我们最小的问题。"}},{"w":"kekecilan","ipa":"/kəkətʃilan/","zh":"太小（形容尺寸不合身）","phrase":{"t":"baju kekecilan","zh":"衣服太小了"},"example":{"t":"Sepatu ini kekecilan bagi saya.","zh":"这双鞋对我来说太小了。"}}],"derSlugs":["kecil","mengecil","mengecilkan","terkecil","kekecilan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:26:37.101Z","src":"base"}