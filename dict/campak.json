{"root":"campak","ipa":"/tʃampak/","core":"丢弃，扔掉，抛弃","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/tʃampak/","zh":"扔，抛，丢弃","phrases":[{"t":"campak jauh-jauh","zh":"远远地扔掉"},{"t":"campak ke laut","zh":"扔进海里"},{"t":"campak barang","zh":"扔东西"}],"examples":[{"t":"Dia campak surat itu ke tempat sampah.","zh":"他把那封信扔进了垃圾桶。"},{"t":"Jangan campak sampah sembarangan.","zh":"不要随地乱扔垃圾。"}]},"ders":[{"w":"campak","ipa":"/tʃampak/","zh":"扔，抛","phrase":{"t":"campak ke bawah","zh":"扔到下面"},"example":{"t":"Dia campak tasnya di lantai.","zh":"他把包扔在地板上。"}},{"w":"mencampak","ipa":"/mən.tʃampak/","zh":"投掷，抛弃","phrase":{"t":"mencampak sesuatu","zh":"投掷某物"},"example":{"t":"Ia mencampak batu itu ke sungai.","zh":"他把那块石头扔进了河里。"}},{"w":"mencampakkan","ipa":"/mən.tʃampak.kan/","zh":"抛弃，遗弃（某人或某物）","phrase":{"t":"mencampakkan kekasih","zh":"抛弃恋人"},"example":{"t":"Dia merasa dicampakkan oleh keluarganya.","zh":"他感到被家人抛弃了。"}},{"w":"tercampak","ipa":"/tər.tʃampak/","zh":"被扔掉，被抛弃","phrase":{"t":"tercampak jauh","zh":"被扔得很远"},"example":{"t":"Barang-barang itu tercampak di pinggir jalan.","zh":"那些东西被扔在路边。"}},{"w":"campakan","ipa":"/tʃampak.an/","zh":"被扔掉的东西，废弃物","phrase":{"t":"campakan orang","zh":"别人扔掉的东西"},"example":{"t":"Ini hanyalah campakan yang tidak berguna.","zh":"这只不过是没用的废弃物。"}}],"derSlugs":["campak","mencampak","mencampakkan","tercampak","campakan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T08:43:26.774Z","src":"base"}