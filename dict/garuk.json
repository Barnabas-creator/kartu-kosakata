{"root":"garuk","ipa":"/ˈɡarʊk/","core":"抓，挠，搔","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈɡarʊk/","zh":"抓，挠，搔（指用指甲或工具在皮肤表面摩擦）","phrases":[{"t":"garuk kepala","zh":"挠头"},{"t":"garuk tanah","zh":"刨土"},{"t":"garuk punggung","zh":"挠背"}],"examples":[{"t":"Dia garuk kepalanya karena bingung.","zh":"他因为困惑而挠了挠头。"},{"t":"Jangan garuk luka itu agar tidak infeksi.","zh":"不要去挠那个伤口，以免感染。"}]},"ders":[{"w":"garuk","ipa":"/ˈɡarʊk/","zh":"抓，挠","phrase":{"t":"garuk gatal","zh":"止痒"},"example":{"t":"Kulitnya terasa gatal sehingga ia terus garuk.","zh":"他的皮肤感觉很痒，所以他不停地抓。"}},{"w":"menggaruk","ipa":"/məˈŋɡarʊk/","zh":"正在抓，进行抓挠动作","phrase":{"t":"menggaruk kulit","zh":"抓挠皮肤"},"example":{"t":"Kucing itu sedang menggaruk pintu kayu.","zh":"那只猫正在抓挠木门。"}},{"w":"garukan","ipa":"/ɡaˈrʊkan/","zh":"抓痕，抓挠的动作","phrase":{"t":"bekas garukan","zh":"抓痕"},"example":{"t":"Ada bekas garukan di lengannya.","zh":"他的手臂上有抓痕。"}},{"w":"penggaruk","ipa":"/pəˈŋɡarʊk/","zh":"抓挠工具，耙子","phrase":{"t":"penggaruk punggung","zh":"挠痒耙"},"example":{"t":"Dia menggunakan penggaruk untuk membersihkan daun kering.","zh":"他用耙子清理干枯的叶子。"}}],"derSlugs":["garuk","menggaruk","garukan","penggaruk"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-30T15:47:27.369Z","src":"base"}