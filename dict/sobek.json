{"root":"sobek","ipa":"/so.bɛk/","core":"撕裂，扯破，撕开","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/so.bɛk/","zh":"撕裂，扯破，撕开","phrases":[{"t":"sobek sedikit","zh":"撕开一点"},{"t":"kertas sobek","zh":"纸张撕裂"},{"t":"sobek-sobek","zh":"撕得粉碎"}],"examples":[{"t":"Bajunya sobek karena tersangkut paku.","zh":"他的衣服因为挂在钉子上而撕破了。"},{"t":"Jangan sobek surat itu.","zh":"不要把那封信撕掉。"}]},"ders":[{"w":"sobek","ipa":"/so.bɛk/","zh":"撕裂的（状态）","phrase":{"t":"baju sobek","zh":"破衣服"},"example":{"t":"Celananya sobek di bagian lutut.","zh":"他的裤子在膝盖处破了。"}},{"w":"menyobek","ipa":"/mə.ɲo.bɛk/","zh":"撕开，扯破（动作）","phrase":{"t":"menyobek amplop","zh":"撕开信封"},"example":{"t":"Dia menyobek kertas itu menjadi dua bagian.","zh":"他把那张纸撕成了两半。"}},{"w":"sobekan","ipa":"/so.bɛ.kan/","zh":"撕裂物，碎片","phrase":{"t":"sobekan kertas","zh":"纸屑"},"example":{"t":"Ada sobekan kain di lantai.","zh":"地板上有块碎布。"}},{"w":"tersobek","ipa":"/tər.so.bɛk/","zh":"被撕破的，意外撕裂的","phrase":{"t":"buku tersobek","zh":"被撕坏的书"},"example":{"t":"Halaman buku itu tersobek secara tidak sengaja.","zh":"那本书的页面不小心被撕破了。"}}],"derSlugs":["sobek","menyobek","sobekan","tersobek"],"model":"gemini-3.1-flash-lite","createdAt":"2026-10-01T02:08:12.838Z","src":"base"}