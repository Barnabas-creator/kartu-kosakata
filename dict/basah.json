{"root":"basah","ipa":"/ba.sah/","core":"形容词：湿的，潮湿的；动词：弄湿，浸湿","pos":["形容词","动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ba.sah/","zh":"形容物体表面含有水分或被液体浸透的状态。","phrases":[{"t":"basah kuyup","zh":"湿透的"},{"t":"kering basah","zh":"干湿"},{"t":"basah kering","zh":"湿漉漉的"}],"examples":[{"t":"Baju saya basah karena hujan.","zh":"我的衣服因为下雨湿了。"},{"t":"Jangan menyentuh kabel itu dengan tangan basah.","zh":"不要用湿手触碰那根电线。"}]},"ders":[{"w":"basah","ipa":"/ba.sah/","zh":"湿的","phrase":{"t":"lantai basah","zh":"湿的地板"},"example":{"t":"Lantai itu masih basah setelah dipel.","zh":"拖完地后地板还是湿的。"}},{"w":"membasahi","ipa":"/məm.ba.sa.hi/","zh":"弄湿，浸湿（某物）","phrase":{"t":"membasahi bibir","zh":"润湿嘴唇"},"example":{"t":"Hujan mulai membasahi bumi.","zh":"雨开始打湿大地。"}},{"w":"membasahkan","ipa":"/məm.ba.sa.kan/","zh":"使……变湿","phrase":{"t":"membasahkan kain","zh":"弄湿布料"},"example":{"t":"Dia membasahkan handuk itu dengan air dingin.","zh":"他用冷水弄湿了那条毛巾。"}},{"w":"kebasahan","ipa":"/kə.ba.sa.han/","zh":"被淋湿，受潮","phrase":{"t":"karena kebasahan","zh":"因为被淋湿了"},"example":{"t":"Kami kebasahan di tengah jalan.","zh":"我们在半路上被淋湿了。"}}],"derSlugs":["basah","membasahi","membasahkan","kebasahan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:28:35.489Z","src":"base"}