{"root":"rumor","ipa":"/rumor/","core":"传闻，谣言，流言蜚语","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/rumor/","zh":"指未经证实的传闻、流言或谣言。","phrases":[{"t":"rumor yang beredar","zh":"流传的谣言"},{"t":"menyebarkan rumor","zh":"散布谣言"},{"t":"rumor tidak berdasar","zh":"毫无根据的传闻"}],"examples":[{"t":"Rumor itu ternyata tidak benar.","zh":"那个传闻结果是不真实的。"},{"t":"Jangan mudah percaya pada rumor.","zh":"不要轻易相信谣言。"}]},"ders":[{"w":"rumor","ipa":"/rumor/","zh":"传闻，谣言","phrase":{"t":"rumor negatif","zh":"负面传闻"},"example":{"t":"Rumor itu menyebar dengan cepat.","zh":"那个传闻传播得很快。"}},{"w":"merumorkan","ipa":"/mərumorkan/","zh":"传言，散布关于某事的谣言","phrase":{"t":"merumorkan sesuatu","zh":"传言某事"},"example":{"t":"Orang-orang merumorkan kepergiannya.","zh":"人们在传言他的离去。"}},{"w":"dirumorkan","ipa":"/dirumorkan/","zh":"被传言，被谣传","phrase":{"t":"dirumorkan akan menikah","zh":"被传言即将结婚"},"example":{"t":"Dia dirumorkan akan pindah ke luar negeri.","zh":"他被传言即将搬到国外。"}}],"derSlugs":["rumor","merumorkan","dirumorkan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T01:23:49.161Z","src":"base"}