{"root":"sapa","ipa":"/sa.pa/","core":"问候，打招呼","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/sa.pa/","zh":"问候，打招呼，向某人致意","phrases":[{"t":"sapa menyapa","zh":"互相问候"},{"t":"tidak disapa","zh":"没被理睬"},{"t":"sapa orang asing","zh":"向陌生人打招呼"}],"examples":[{"t":"Dia menyapa saya dengan ramah.","zh":"他友好地向我问候。"},{"t":"Jangan lupa untuk menyapa tetangga.","zh":"别忘了向邻居打招呼。"}]},"ders":[{"w":"sapa","ipa":"/sa.pa/","zh":"问候","phrase":{"t":"sapa hangat","zh":"热情的问候"},"example":{"t":"Sapaannya membuat saya merasa diterima.","zh":"他的问候让我感到被接纳。"}},{"w":"menyapa","ipa":"/mə.ɲa.pa/","zh":"向...打招呼","phrase":{"t":"menyapa tamu","zh":"向客人问候"},"example":{"t":"Ibu guru menyapa murid-murid di kelas.","zh":"老师在教室里向学生们问候。"}},{"w":"menyapai","ipa":"/mə.ɲa.pa.i/","zh":"反复地问候","phrase":{"t":"menyapai teman","zh":"不断地向朋友问候"},"example":{"t":"Dia terus menyapai orang yang lewat.","zh":"他不停地向路过的人打招呼。"}},{"w":"sapaan","ipa":"/sa.pa.an/","zh":"问候语，称呼","phrase":{"t":"sapaan akrab","zh":"亲切的称呼"},"example":{"t":"Itu adalah sapaan yang sopan.","zh":"那是一种礼貌的问候语。"}},{"w":"penyapa","ipa":"/pə.ɲa.pa/","zh":"打招呼的人","phrase":{"t":"penyapa ramah","zh":"友好的问候者"},"example":{"t":"Dia dikenal sebagai penyapa yang baik di lingkungan ini.","zh":"他在这片社区以善于打招呼而闻名。"}}],"derSlugs":["sapa","menyapa","menyapai","sapaan","penyapa"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T02:37:39.362Z","src":"base"}