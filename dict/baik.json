{"root":"baik","ipa":"/ba.ɪk/","core":"好的，良好的，善良的。用于表示赞同、质量优良或道德高尚。","pos":["形容词"],"scenes":["高频","生活","工作"],"rootBlock":{"ipa":"/ba.ɪk/","zh":"好的，良好的，善良的","phrases":[{"t":"baik hati","zh":"心地善良"},{"t":"baik sekali","zh":"非常好"},{"t":"baik buruknya","zh":"好坏，利弊"}],"examples":[{"t":"Dia adalah orang yang baik.","zh":"他是一个好人。"},{"t":"Kabar ini sangat baik bagi kita.","zh":"这个消息对我们来说非常好。"}]},"ders":[{"w":"baik","ipa":"/ba.ɪk/","zh":"好的","phrase":{"t":"baik-baik saja","zh":"一切安好"},"example":{"t":"Semoga kamu baik-baik saja.","zh":"希望你一切都好。"}},{"w":"memperbaiki","ipa":"/məm.pər.ba.ɪ.ki/","zh":"修理，改善","phrase":{"t":"memperbaiki mobil","zh":"修理汽车"},"example":{"t":"Dia sedang memperbaiki jam yang rusak.","zh":"他正在修理坏掉的时钟。"}},{"w":"perbaikan","ipa":"/pər.ba.ɪ.kan/","zh":"改进，修理","phrase":{"t":"perbaikan kualitas","zh":"质量改进"},"example":{"t":"Perbaikan jalan itu akan segera selesai.","zh":"那条道路的维修工程很快就会完成。"}},{"w":"kebaikan","ipa":"/kə.ba.ɪ.kan/","zh":"善良，好处","phrase":{"t":"membalas kebaikan","zh":"报答恩情"},"example":{"t":"Terima kasih atas kebaikan Anda.","zh":"感谢您的善意。"}},{"w":"terbaik","ipa":"/tər.ba.ɪk/","zh":"最好的","phrase":{"t":"yang terbaik","zh":"最好的那个"},"example":{"t":"Dia memberikan yang terbaik dalam pekerjaannya.","zh":"他在工作中表现出了最好的一面。"}}],"derSlugs":["baik","memperbaiki","perbaikan","kebaikan","terbaik"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:12:37.028Z","src":"base"}