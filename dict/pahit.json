{"root":"pahit","ipa":"/pa.hɪt/","core":"苦的，苦味","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/pa.hɪt/","zh":"形容味道苦，或比喻经历痛苦、艰难的。","phrases":[{"t":"obat pahit","zh":"苦药"},{"t":"pahit getir","zh":"酸甜苦辣，艰辛"},{"t":"terasa pahit","zh":"感到苦"}],"examples":[{"t":"Kopi ini rasanya sangat pahit.","zh":"这杯咖啡味道非常苦。"},{"t":"Dia telah mengalami banyak pahit getir kehidupan.","zh":"他已经历了人生中的许多酸甜苦辣。"}]},"ders":[{"w":"pahit","ipa":"/pa.hɪt/","zh":"苦的","phrase":{"t":"buah pahit","zh":"苦果"},"example":{"t":"Jangan makan buah yang pahit itu.","zh":"不要吃那种苦的果子。"}},{"w":"memahitkan","ipa":"/mə.ma.hɪt.kan/","zh":"使变苦","phrase":{"t":"memahitkan suasana","zh":"使气氛变得沉重/苦涩"},"example":{"t":"Komentarnya justru memahitkan suasana rapat.","zh":"他的评论反而让会议气氛变得苦涩。"}},{"w":"kepahitan","ipa":"/kə.pa.hi.tan/","zh":"苦味，痛苦，苦难","phrase":{"t":"kepahitan hidup","zh":"生活的苦难"},"example":{"t":"Dia menyimpan banyak kepahitan di hatinya.","zh":"他心中藏着许多痛苦。"}}],"derSlugs":["pahit","memahitkan","kepahitan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T09:05:05.140Z","src":"base"}