{"root":"lain","ipa":"/la.in/","core":"指与当前事物不同、另外的、其他的或剩余的部分。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/la.in/","zh":"其他的，另外的，不同的","phrases":[{"t":"orang lain","zh":"其他人"},{"t":"hal lain","zh":"其他事情"},{"t":"lain kali","zh":"下次"}],"examples":[{"t":"Saya ingin membeli buku yang lain.","zh":"我想买另一本书。"},{"t":"Dia memiliki pendapat yang lain.","zh":"他有不同的意见。"}]},"ders":[{"w":"lain","ipa":"/la.in/","zh":"其他的","phrase":{"t":"lain daripada yang lain","zh":"与众不同"},"example":{"t":"Itu masalah lain.","zh":"那是另一回事。"}},{"w":"lainnya","ipa":"/la.in.ɲa/","zh":"其他的（部分），其余的","phrase":{"t":"dan lainnya","zh":"以及其他"},"example":{"t":"Mana yang lainnya?","zh":"其他的在哪里？"}},{"w":"melainkan","ipa":"/mə.la.in.kan/","zh":"而是（用于否定后的转折）","phrase":{"t":"bukan ini melainkan itu","zh":"不是这个而是那个"},"example":{"t":"Dia bukan guru, melainkan dokter.","zh":"他不是老师，而是医生。"}},{"w":"selain","ipa":"/sə.la.in/","zh":"除了...之外","phrase":{"t":"selain itu","zh":"此外"},"example":{"t":"Selain dia, tidak ada yang tahu.","zh":"除了他，没有人知道。"}},{"w":"berlainan","ipa":"/bər.la.i.nan/","zh":"不同的，有差异的","phrase":{"t":"berlainan pendapat","zh":"意见不合"},"example":{"t":"Mereka berasal dari latar belakang yang berlainan.","zh":"他们来自不同的背景。"}},{"w":"lain-lain","ipa":"/la.in.la.in/","zh":"等等，其他各种","phrase":{"t":"dan lain-lain","zh":"等等"},"example":{"t":"Saya membeli buah, sayur, dan lain-lain.","zh":"我买了水果、蔬菜等等。"}}],"derSlugs":["lain","lainnya","melainkan","selain","berlainan","lain-lain"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:18:33.551Z","src":"base"}