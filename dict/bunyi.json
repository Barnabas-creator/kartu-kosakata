{"root":"bunyi","ipa":"/buɲi/","core":"声音、响声、音响，指通过听觉感知的物理振动或发出的声响。","pos":["名词","动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/buɲi/","zh":"声音、响声","phrases":[{"t":"bunyi gaduh","zh":"嘈杂声"},{"t":"bunyi jantung","zh":"心跳声"},{"t":"bunyi aneh","zh":"奇怪的声音"}],"examples":[{"t":"Saya mendengar bunyi yang keras dari luar.","zh":"我听到外面传来巨大的响声。"},{"t":"Bunyi musik itu sangat merdu.","zh":"那音乐的声音非常悦耳。"}]},"ders":[{"w":"bunyi","ipa":"/buɲi/","zh":"声音","phrase":{"t":"bunyi alam","zh":"自然之声"},"example":{"t":"Bunyi ombak menenangkan hati.","zh":"海浪声令人心旷神怡。"}},{"w":"berbunyi","ipa":"/bərbuɲi/","zh":"发出声音、响起来","phrase":{"t":"telepon berbunyi","zh":"电话响了"},"example":{"t":"Bel sekolah sudah berbunyi.","zh":"学校的铃声已经响了。"}},{"w":"membunyikan","ipa":"/məmbuɲikan/","zh":"使发出声音、鸣响","phrase":{"t":"membunyikan klakson","zh":"按喇叭"},"example":{"t":"Dia membunyikan peluit untuk memulai pertandingan.","zh":"他吹响哨子以开始比赛。"}},{"w":"bunyian","ipa":"/buɲian/","zh":"声响、音响效果","phrase":{"t":"bunyian musik","zh":"音乐声响"},"example":{"t":"Terdengar bunyian aneh dari dalam mesin itu.","zh":"机器内部传来了奇怪的声响。"}}],"derSlugs":["bunyi","berbunyi","membunyikan","bunyian"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:17:21.099Z","src":"base"}