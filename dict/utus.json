{"root":"utus","ipa":"/ˈutus/","core":"派遣，委派，指派某人去执行特定任务或传达信息。","pos":["动词"],"scenes":["高频","工作"],"rootBlock":{"ipa":"/ˈutus/","zh":"派遣，委派","phrases":[{"t":"mengutus seseorang","zh":"派遣某人"},{"t":"utusan khusus","zh":"特使"},{"t":"mengutus delegasi","zh":"派遣代表团"}],"examples":[{"t":"Presiden mengutus menteri untuk menghadiri pertemuan itu.","zh":"总统派遣部长出席了那次会议。"},{"t":"Dia diutus oleh perusahaannya ke luar negeri.","zh":"他被他的公司派往国外。"}]},"ders":[{"w":"utus","ipa":"/ˈutus/","zh":"派遣（原型词）","phrase":{"t":"mengutus utusan","zh":"派遣使者"},"example":{"t":"Pemerintah mengutus tim penyelamat.","zh":"政府派遣了救援队。"}},{"w":"utusan","ipa":"/uˈtusan/","zh":"使者，代表，信使","phrase":{"t":"utusan perdamaian","zh":"和平使者"},"example":{"t":"Dia datang sebagai utusan resmi.","zh":"他作为正式使者前来。"}},{"w":"mengutus","ipa":"/məˈŋutus/","zh":"派遣，委派（及物动词）","phrase":{"t":"mengutus wakil","zh":"委派代表"},"example":{"t":"Mereka mengutus seseorang untuk bernegosiasi.","zh":"他们派遣某人去进行谈判。"}},{"w":"pengutusan","ipa":"/pəŋuˈtusan/","zh":"派遣（行为或过程），差遣","phrase":{"t":"misi pengutusan","zh":"派遣任务"},"example":{"t":"Pengutusan misionaris itu berjalan lancar.","zh":"传教士的派遣工作进展顺利。"}}],"derSlugs":["utus","utusan","mengutus","pengutusan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T02:38:03.722Z","src":"base"}