{"root":"keluar","ipa":"/kəluar/","core":"出去、离开、出来、产出","pos":["动词"],"scenes":["高频","生活","工作"],"rootBlock":{"ipa":"/kəluar/","zh":"指从内部向外部移动，或指某物被生产、发布、显露出来。","phrases":[{"t":"keluar rumah","zh":"出门"},{"t":"keluar negeri","zh":"出国"},{"t":"keluar uang","zh":"花钱"}],"examples":[{"t":"Dia baru saja keluar dari kantor.","zh":"他刚从办公室出来。"},{"t":"Buku baru itu akan keluar bulan depan.","zh":"那本新书下个月会出版。"}]},"ders":[{"w":"keluar","ipa":"/kəluar/","zh":"出去，离开","phrase":{"t":"keluar masuk","zh":"进进出出"},"example":{"t":"Tolong keluar dari ruangan ini.","zh":"请离开这个房间。"}},{"w":"mengeluarkan","ipa":"/məŋəluarkan/","zh":"使...出来，取出，发布，支出","phrase":{"t":"mengeluarkan biaya","zh":"支付费用"},"example":{"t":"Dia mengeluarkan dompet dari sakunya.","zh":"他从口袋里掏出了钱包。"}},{"w":"pengeluaran","ipa":"/pəŋəluaran/","zh":"支出，开销，产出","phrase":{"t":"pengeluaran bulanan","zh":"月度支出"},"example":{"t":"Pengeluaran perusahaan meningkat tahun ini.","zh":"公司今年的开销增加了。"}},{"w":"terkeluar","ipa":"/tərkəluar/","zh":"被挤出，意外地出来","phrase":{"t":"terkeluar dari daftar","zh":"被排除在名单之外"},"example":{"t":"Bola itu terkeluar dari lapangan.","zh":"球被挤出了场地。"}}],"derSlugs":["keluar","mengeluarkan","pengeluaran","terkeluar"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:19:03.446Z","src":"base"}