{"root":"kang","ipa":"/kaŋ/","core":"指代兄长、年长男性或特定职业的尊称，源自爪哇语。","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/kaŋ/","zh":"兄长；对年长男性的尊称；（爪哇语）指代某种职业或身份的人。","phrases":[{"t":"Kang Mas","zh":"哥哥（对年长男性的亲昵称呼）"},{"t":"Kang ojek","zh":"摩托车出租车司机"},{"t":"Kang parkir","zh":"停车管理员"}],"examples":[{"t":"Kang, minta tolong sebentar.","zh":"大哥，请帮个忙。"},{"t":"Dia sudah lama bekerja sebagai kang parkir di pasar itu.","zh":"他在那个市场当停车管理员已经很久了。"}]},"ders":[{"w":"kang","ipa":"/kaŋ/","zh":"兄长；尊称","phrase":{"t":"Kang Asep","zh":"阿塞普大哥"},"example":{"t":"Kang, kapan kita berangkat?","zh":"大哥，我们什么时候出发？"}},{"w":"kangmas","ipa":"/kaŋmas/","zh":"哥哥；夫君（较古雅或爪哇风格的称呼）","phrase":{"t":"Wahai kangmas","zh":"噢，亲爱的夫君"},"example":{"t":"Kangmas akan selalu menjagamu.","zh":"哥哥会一直守护着你。"}}],"derSlugs":["kang","kangmas"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:10:04.713Z","src":"base"}