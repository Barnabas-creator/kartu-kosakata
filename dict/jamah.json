{"root":"jamah","ipa":"/dʒamah/","core":"聚集，群众，会众，宗教聚会（源自阿拉伯语）","pos":["名词"],"scenes":["教会","高频"],"rootBlock":{"ipa":"/dʒamah/","zh":"会众，聚会群众","phrases":[{"t":"jamah jemaat","zh":"信徒会众"},{"t":"tuan jamah","zh":"聚会主人"},{"t":"rapat jamah","zh":"会众会议"}],"examples":[{"t":"Jamah itu berkumpul di gereja untuk berdoa.","zh":"会众聚集在教堂里祈祷。"},{"t":"Keputusan itu diambil bersama jamah.","zh":"该决定是与会众共同做出的。"}]},"ders":[{"w":"jamah","ipa":"/dʒamah/","zh":"接触，触摸","phrase":{"t":"jamah tangan","zh":"触摸"},"example":{"t":"Jangan jamah barang itu.","zh":"不要触摸那个东西。"}},{"w":"menjamah","ipa":"/mənʒamah/","zh":"触摸，抚摸","phrase":{"t":"menjamah makanan","zh":"拿食物吃"},"example":{"t":"Dia menjamah lengan anak itu.","zh":"他抚摸了那个孩子的胳膊。"}},{"w":"penjamahan","ipa":"/pənʒamahan/","zh":"接触，触摸过程","phrase":{"t":"penjamahan langsung","zh":"直接接触"},"example":{"t":"Penjamahan dapat menyebarkan kuman.","zh":"接触会传播病菌。"}},{"w":"terjamah","ipa":"/tərʒamah/","zh":"被触及的，可触及的","phrase":{"t":"belum terjamah","zh":"未被触及的"},"example":{"t":"Tempat itu masih belum terjamah manusia.","zh":"那个地方尚未被人类涉足。"}},{"w":"sejamah","ipa":"/səʒamah/","zh":"一会儿，片刻","phrase":{"t":"sejamah saja","zh":"仅一会儿"},"example":{"t":"Dia berhenti sejamah untuk beristirahat.","zh":"他停下来休息了一会儿。"}}],"derSlugs":["jamah","menjamah","penjamahan","terjamah","sejamah"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T16:58:20.730Z","src":"base"}