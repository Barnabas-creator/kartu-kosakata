{"root":"cerah","ipa":"/tʃərah/","core":"形容天气晴朗、明亮，或形容心情愉快、面容开朗。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/tʃərah/","zh":"晴朗的，明亮的","phrases":[{"t":"cuaca cerah","zh":"晴朗的天气"},{"t":"wajah cerah","zh":"开朗的面容"},{"t":"masa depan cerah","zh":"光明的前途"}],"examples":[{"t":"Hari ini cuacanya sangat cerah.","zh":"今天天气非常晴朗。"},{"t":"Dia tersenyum dengan wajah yang cerah.","zh":"他带着开朗的笑容。"}]},"ders":[{"w":"cerah","ipa":"/tʃərah/","zh":"晴朗的","phrase":{"t":"langit cerah","zh":"晴朗的天空"},"example":{"t":"Langit tampak cerah pagi ini.","zh":"今天早晨天空看起来很晴朗。"}},{"w":"mencerahkan","ipa":"/mənʃərahkan/","zh":"使明亮，使开朗","phrase":{"t":"mencerahkan suasana","zh":"活跃气氛"},"example":{"t":"Berita itu mencerahkan suasana hatinya.","zh":"那个消息使他的心情变得开朗。"}},{"w":"kecerahan","ipa":"/kəʃərahan/","zh":"亮度，明亮程度","phrase":{"t":"tingkat kecerahan","zh":"亮度等级"},"example":{"t":"Atur tingkat kecerahan layar ponsel Anda.","zh":"调整你手机屏幕的亮度。"}}],"derSlugs":["cerah","mencerahkan","kecerahan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-27T16:36:37.946Z","src":"base"}