{"root":"bukti","ipa":"/ˈbukti/","core":"证据、证明、凭据，指能够证实某事真实性的事实、材料或迹象。","pos":["名词"],"scenes":["高频","工作"],"rootBlock":{"ipa":"/ˈbukti/","zh":"证据、证明","phrases":[{"t":"bukti nyata","zh":"确凿的证据"},{"t":"bukti pembayaran","zh":"付款凭证"},{"t":"memberi bukti","zh":"提供证据"}],"examples":[{"t":"Polisi mencari bukti di tempat kejadian perkara.","zh":"警察在案发现场寻找证据。"},{"t":"Ini adalah bukti bahwa dia tidak bersalah.","zh":"这是他无罪的证明。"}]},"ders":[{"w":"bukti","ipa":"/ˈbukti/","zh":"证据","phrase":{"t":"bukti diri","zh":"身份证明"},"example":{"t":"Tunjukkan bukti diri Anda.","zh":"请出示您的身份证明。"}},{"w":"membuktikan","ipa":"/məmˈbukti.kan/","zh":"证明、证实","phrase":{"t":"membuktikan kebenaran","zh":"证实真相"},"example":{"t":"Dia berhasil membuktikan teorinya.","zh":"他成功地证明了他的理论。"}},{"w":"pembuktian","ipa":"/pəmˈbuk.ti.an/","zh":"证明过程、论证","phrase":{"t":"proses pembuktian","zh":"证明过程"},"example":{"t":"Pembuktian di pengadilan sangat ketat.","zh":"法庭上的举证过程非常严格。"}},{"w":"terbukti","ipa":"/tərˈbukti/","zh":"被证明的、已证实的","phrase":{"t":"terbukti bersalah","zh":"被证实有罪"},"example":{"t":"Obat ini terbukti efektif.","zh":"这种药已被证明是有效的。"}}],"derSlugs":["bukti","membuktikan","pembuktian","terbukti"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:42:29.738Z","src":"base"}