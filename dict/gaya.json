{"root":"gaya","ipa":"/ˈɡaja/","core":"指风格、样式、姿态或某种特定的方式，也常用于描述人的举止或时尚感。","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈɡaja/","zh":"风格；样式；姿态","phrases":[{"t":"gaya hidup","zh":"生活方式"},{"t":"gaya bahasa","zh":"修辞手法"},{"t":"gaya tarik","zh":"吸引力；引力"}],"examples":[{"t":"Dia memiliki gaya bicara yang unik.","zh":"他有一种独特的说话风格。"},{"t":"Gaya berpakaiannya sangat modis.","zh":"她的穿衣风格非常时尚。"}]},"ders":[{"w":"gaya","ipa":"/ˈɡaja/","zh":"风格；样式","phrase":{"t":"gaya bebas","zh":"自由式"},"example":{"t":"Itu gaya saya.","zh":"那是我的风格。"}},{"w":"bergaya","ipa":"/bərˈɡaja/","zh":"有风格的；摆姿势；时髦的","phrase":{"t":"suka bergaya","zh":"喜欢摆姿势；爱显摆"},"example":{"t":"Dia sedang bergaya di depan kamera.","zh":"他正在镜头前摆姿势。"}},{"w":"gayanya","ipa":"/ɡaˈjaja/","zh":"他的风格；其姿态","phrase":{"t":"gayanya keren","zh":"他的样子很酷"},"example":{"t":"Gayanya sangat santai.","zh":"他的姿态非常放松。"}},{"w":"menggayakan","ipa":"/məŋɡaˈjakan/","zh":"使具有某种风格；设计样式","phrase":{"t":"menggayakan rambut","zh":"设计发型"},"example":{"t":"Dia menggayakan rumahnya dengan tema minimalis.","zh":"他以极简主义主题来设计他的房子。"}}],"derSlugs":["gaya","bergaya","gayanya","menggayakan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T15:56:58.095Z","src":"base"}