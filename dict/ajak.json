{"root":"ajak","ipa":"/a.dʒak/","core":"邀请，劝说，号召","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/a.dʒak/","zh":"邀请某人做某事，动员或劝说他人参与","phrases":[{"t":"ajak ngobrol","zh":"找人聊天"},{"t":"ajak jalan","zh":"约出去逛街"},{"t":"ajak makan","zh":"邀请吃饭"}],"examples":[{"t":"Dia mengajak saya pergi ke bioskop.","zh":"他邀请我去电影院。"},{"t":"Jangan ajak dia ikut campur.","zh":"别叫他插手。"}]},"ders":[{"w":"ajak","ipa":"/a.dʒak/","zh":"邀请，劝说","phrase":{"t":"ajak teman","zh":"邀请朋友"},"example":{"t":"Saya ingin ajak kamu ke pesta.","zh":"我想邀请你去派对。"}},{"w":"mengajak","ipa":"/mə.ŋa.dʒak/","zh":"邀请，动员，促使","phrase":{"t":"mengajak diskusi","zh":"邀请讨论"},"example":{"t":"Ibu mengajak adiknya berbelanja.","zh":"母亲叫弟弟去购物。"}},{"w":"mengajak-ajak","ipa":"/mə.ŋa.dʒak a.dʒak/","zh":"反复邀请，不断劝说","phrase":{"t":"suka mengajak-ajak","zh":"喜欢到处拉人"},"example":{"t":"Dia selalu mengajak-ajak orang untuk bergabung.","zh":"他总是不断劝说别人加入。"}},{"w":"terajak","ipa":"/tə.ra.dʒak/","zh":"被邀请的，被带动起来的","phrase":{"t":"tidak terajak","zh":"无法被邀请到的"},"example":{"t":"Karena sibuk, dia akhirnya terajak juga.","zh":"因为忙碌，他最终也被动员加入了。"}},{"w":"ajakan","ipa":"/a.dʒa.kan/","zh":"邀请，号召，劝导","phrase":{"t":"menolak ajakan","zh":"拒绝邀请"},"example":{"t":"Kami menerima ajakan mereka dengan senang hati.","zh":"我们愉快地接受了他们的邀请。"}}],"derSlugs":["ajak","mengajak","mengajak-ajak","terajak","ajakan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T02:07:51.321Z","src":"base"}