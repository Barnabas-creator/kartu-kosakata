{"root":"genggam","ipa":"/ˈɡɛŋ.ɡam/","core":"用手紧紧握住、抓牢，亦可比喻掌握或控制某事","pos":["动词","名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈɡɛŋ.ɡam/","zh":"紧握，抓紧","phrases":[{"t":"genggam tangan","zh":"握手"},{"t":"dalam genggaman","zh":"在掌握中"},{"t":"genggam erat","zh":"紧紧握住"}],"examples":[{"t":"Dia menggenggam erat tangan ibunya.","zh":"他紧紧握着母亲的手。"},{"t":"Kemenangan itu kini ada di dalam genggaman kita.","zh":"胜利现在掌握在我们的手中。"}]},"ders":[{"w":"genggam","ipa":"/ˈɡɛŋ.ɡam/","zh":"一把（量词），握住","phrase":{"t":"satu genggam beras","zh":"一把大米"},"example":{"t":"Ambil satu genggam gula pasir.","zh":"抓一把白糖。"}},{"w":"menggenggam","ipa":"/mənˈɡɛŋ.ɡam/","zh":"握住，抓取，掌控","phrase":{"t":"menggenggam kekuasaan","zh":"掌握权力"},"example":{"t":"Anak itu menggenggam mainannya.","zh":"那个孩子抓着他的玩具。"}},{"w":"menggenggamkan","ipa":"/mən.ɡɛŋˈɡam.kan/","zh":"替某人握住，把...塞在手里握着","phrase":{"t":"menggenggamkan uang","zh":"把钱塞在手里握住"},"example":{"t":"Ibu menggenggamkan koin kepada anak itu.","zh":"母亲把硬币塞进孩子手里让他握着。"}},{"w":"tergenggam","ipa":"/tərˈɡɛŋ.ɡam/","zh":"被握住的，被掌控的","phrase":{"t":"nasib tergenggam","zh":"命运被掌控"},"example":{"t":"Peluang itu sudah tergenggam di tangannya.","zh":"那个机会已经被他握在手里了。"}},{"w":"genggaman","ipa":"/ɡɛŋˈɡa.man/","zh":"握力，掌控，把柄","phrase":{"t":"dalam genggaman","zh":"在掌控之中"},"example":{"t":"Lepaskan genggamanmu!","zh":"松开你的手！"}}],"derSlugs":["genggam","menggenggam","menggenggamkan","tergenggam","genggaman"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-28T04:14:28.327Z","src":"base"}