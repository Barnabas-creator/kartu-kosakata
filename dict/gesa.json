{"root":"gesa","ipa":"/ˈɡesa/","core":"意为急促、催促，常用于形容情况紧急或行动匆忙的状态。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈɡesa/","zh":"急忙的，匆促的","phrases":[{"t":"dengan gesa","zh":"匆忙地"},{"t":"tergesa-gesa","zh":"匆忙，仓促"},{"t":"langkah gesa","zh":"急促的步伐"}],"examples":[{"t":"Jangan pergi dengan gesa.","zh":"不要走得那么匆忙。"},{"t":"Keputusan itu diambil secara gesa.","zh":"那个决定是在仓促中做出的。"}]},"ders":[{"w":"gesa","ipa":"/ˈɡesa/","zh":"急忙的，匆促的","phrase":{"t":"terlalu gesa","zh":"过于匆忙"},"example":{"t":"Dia bertindak secara gesa.","zh":"他行事有些仓促。"}},{"w":"tergesa-gesa","ipa":"/tərˈɡesa ɡesa/","zh":"匆匆忙忙的","phrase":{"t":"berjalan tergesa-gesa","zh":"匆匆忙忙地走路"},"example":{"t":"Mereka lari tergesa-gesa ke stesen.","zh":"他们匆匆忙忙地跑向车站。"}},{"w":"menggesa","ipa":"/məŋˈɡesa/","zh":"催促，敦促","phrase":{"t":"menggesa rakan","zh":"催促同伴"},"example":{"t":"Ibu menggesa saya supaya cepat.","zh":"母亲催促我快一点。"}},{"w":"tergesa","ipa":"/tərˈɡesa/","zh":"被催促的，仓促的","phrase":{"t":"keadaan tergesa","zh":"仓促的情况"},"example":{"t":"Penyataan itu dibuat dalam keadaan tergesa.","zh":"那份声明是在仓促的情况下发表的。"}},{"w":"gesaan","ipa":"/ɡəˈsaan/","zh":"催促，压力，敦促","phrase":{"t":"mendapat gesaan","zh":"受到催促"},"example":{"t":"Dia menurut gesaan ketuanya.","zh":"他听从了上司的敦促。"}},{"w":"penggesa","ipa":"/pəŋˈɡesa/","zh":"催促者，敦促者","phrase":{"t":"menjadi penggesa","zh":"成为催促者"},"example":{"t":"Dia bertindak sebagai penggesa dalam projek itu.","zh":"他在该项目中担任催促者的角色。"}}],"derSlugs":["gesa","tergesa-gesa","menggesa","tergesa","gesaan","penggesa"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T16:57:50.373Z","src":"base"}