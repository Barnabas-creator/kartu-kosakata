{"root":"benci","ipa":"/bəntʃi/","core":"指对某人或某事产生强烈的厌恶、憎恨或反感的情绪。","pos":["动词","形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/bəntʃi/","zh":"憎恨，厌恶","phrases":[{"t":"benci setengah mati","zh":"恨之入骨"},{"t":"rasa benci","zh":"憎恨感"},{"t":"saling benci","zh":"互相憎恨"}],"examples":[{"t":"Saya sangat benci dengan kebohongan.","zh":"我非常讨厌谎言。"},{"t":"Jangan biarkan rasa benci menguasai dirimu.","zh":"不要让憎恨占据你的内心。"}]},"ders":[{"w":"benci","ipa":"/bəntʃi/","zh":"憎恨","phrase":{"t":"benci sekali","zh":"非常讨厌"},"example":{"t":"Dia benci hujan.","zh":"他讨厌下雨。"}},{"w":"membenci","ipa":"/məmbəntʃi/","zh":"憎恨（及物动词）","phrase":{"t":"membenci seseorang","zh":"憎恨某人"},"example":{"t":"Dia mulai membenci perilaku temannya.","zh":"他开始憎恨他朋友的行为。"}},{"w":"kebencian","ipa":"/kəbəntʃian/","zh":"仇恨，厌恶（名词）","phrase":{"t":"penuh kebencian","zh":"充满仇恨"},"example":{"t":"Kebencian hanya akan membawa kehancuran.","zh":"仇恨只会带来毁灭。"}},{"w":"pembenci","ipa":"/pəmbəntʃi/","zh":"憎恨者，黑粉","phrase":{"t":"para pembenci","zh":"黑粉们"},"example":{"t":"Jangan pedulikan komentar para pembenci.","zh":"不要理会那些黑粉的评论。"}}],"derSlugs":["benci","membenci","kebencian","pembenci"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:44:58.665Z","src":"base"}