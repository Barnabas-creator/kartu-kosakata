{"root":"konsisten","ipa":"/kɔnsistɛn/","core":"指行为、态度或原则保持一致、连贯，不随时间或环境改变，即“始终如一的”或“一贯的”。","pos":["形容词"],"scenes":["高频","工作"],"rootBlock":{"ipa":"/kɔnsistɛn/","zh":"一致的，始终如一的","phrases":[{"t":"tetap konsisten","zh":"保持一致"},{"t":"sikap konsisten","zh":"一贯的态度"},{"t":"konsisten dengan aturan","zh":"符合规定"}],"examples":[{"t":"Dia selalu konsisten dalam pekerjaannya.","zh":"他在工作中始终如一。"},{"t":"Kita harus konsisten dengan apa yang kita katakan.","zh":"我们必须言行一致。"}]},"ders":[{"w":"konsisten","ipa":"/kɔnsistɛn/","zh":"一致的","phrase":{"t":"tindakan konsisten","zh":"一致的行动"},"example":{"t":"Hasilnya sangat konsisten.","zh":"结果非常一致。"}},{"w":"inkonsisten","ipa":"/inkɔnsistɛn/","zh":"不一致的","phrase":{"t":"perilaku inkonsisten","zh":"不一致的行为"},"example":{"t":"Data tersebut terlihat inkonsisten.","zh":"那些数据看起来不一致。"}},{"w":"konsistensi","ipa":"/kɔnsistɛnsi/","zh":"一致性","phrase":{"t":"menjaga konsistensi","zh":"保持一致性"},"example":{"t":"Konsistensi adalah kunci kesuksesan.","zh":"一致性是成功的关键。"}}],"derSlugs":["konsisten","inkonsisten","konsistensi"],"model":"gemini-3.1-flash-lite","createdAt":"2026-10-01T02:03:17.917Z","src":"base"}