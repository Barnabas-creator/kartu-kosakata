{"root":"erang","ipa":"/eˈraŋ/","core":"呻吟，痛苦时的哼声","pos":["名词","动词"],"scenes":["生活","高频"],"rootBlock":{"ipa":"/eˈraŋ/","zh":"因疼痛、悲伤或疲惫而发出的呻吟声。","phrases":[{"t":"erang kesakitan","zh":"痛苦的呻吟"},{"t":"erang penderitaan","zh":"苦难的呻吟"},{"t":"mendengar erang","zh":"听到呻吟"}],"examples":[{"t":"Terdengar erang pelan dari kamar sebelah.","zh":"隔壁房间传来了轻微的呻吟声。"},{"t":"Dia menahan erang saat lukanya diobati.","zh":"当他的伤口被处理时，他忍住了呻吟。"}]},"ders":[{"w":"erang","ipa":"/eˈraŋ/","zh":"呻吟","phrase":{"t":"tanpa erang","zh":"没有呻吟"},"example":{"t":"Dia jatuh tanpa erang.","zh":"他倒下时没有发出呻吟。"}},{"w":"mengerang","ipa":"/məŋˈeˈraŋ/","zh":"呻吟，发出痛苦的叫声","phrase":{"t":"mengerang kesakitan","zh":"痛苦地呻吟"},"example":{"t":"Pasien itu mengerang kesakitan sepanjang malam.","zh":"那个病人在整夜痛苦地呻吟。"}},{"w":"mengerang-ngerang","ipa":"/məŋeˌraŋˈeˈraŋ/","zh":"不断地呻吟","phrase":{"t":"mengerang-ngerang di tempat tidur","zh":"在床上不停地呻吟"},"example":{"t":"Anak itu mengerang-ngerang karena demam tinggi.","zh":"那孩子因为高烧在不停地呻吟。"}},{"w":"pengerang","ipa":"/pəŋˈeˈraŋ/","zh":"呻吟者","phrase":{"t":"seorang pengerang","zh":"一个呻吟的人"},"example":{"t":"Suara pengerang itu mengganggu tidurku.","zh":"那个呻吟者的声音打扰了我的睡眠。"}},{"w":"pengerangan","ipa":"/pəŋeˈraŋan/","zh":"呻吟状态，呻吟声","phrase":{"t":"pengerangan malam","zh":"夜晚的呻吟声"},"example":{"t":"Pengerangan itu berhenti menjelang pagi.","zh":"呻吟声在清晨临近时停止了。"}}],"derSlugs":["erang","mengerang","mengerang-ngerang","pengerang","pengerangan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-28T03:38:13.915Z","src":"base"}