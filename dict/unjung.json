{"root":"unjung","ipa":"/ˈʊndʒʊŋ/","core":"意指末端、尽头、极端或极限，多用于地理位置、时间或程度的终点。","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈʊndʒʊŋ/","zh":"末端，尽头，顶点","phrases":[{"t":"di ujung jalan","zh":"在路的尽头"},{"t":"di ujung tanduk","zh":"危在旦夕，千钧一发"},{"t":"ujung tombak","zh":"矛头，先锋"}],"examples":[{"t":"Rumahnya terletak di ujung kampung.","zh":"他的房子位于村子的尽头。"},{"t":"Kita harus berjalan sampai ke ujung.","zh":"我们必须步行直到尽头。"}]},"ders":[{"w":"ujung","ipa":"/ˈʊndʒʊŋ/","zh":"末端，尽头","phrase":{"t":"ujung jari","zh":"指尖"},"example":{"t":"Dia memegang pensil di ujung jarinya.","zh":"他用指尖拿着铅笔。"}},{"w":"berujung","ipa":"/bərˈʊndʒʊŋ/","zh":"有尽头的，以...告终","phrase":{"t":"berujung manis","zh":"有个甜蜜的结局"},"example":{"t":"Kisah cinta mereka berujung bahagia.","zh":"他们的爱情故事以幸福告终。"}},{"w":"menujung","ipa":"/məˈnʊndʒʊŋ/","zh":"呈尖顶状，向上凸起","phrase":{"t":"bentuk menujung","zh":"尖顶形状"},"example":{"t":"Atap rumah itu menujung tinggi ke langit.","zh":"那座房子的屋顶高高地呈尖顶指向天空。"}}],"derSlugs":["unjung","ujung","berujung","menujung"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T02:22:14.233Z","src":"base"}