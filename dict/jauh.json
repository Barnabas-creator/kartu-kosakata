{"root":"jauh","ipa":"/dʒaʊh/","core":"指空间、时间或抽象概念上的距离遥远，或程度上的差异巨大。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/dʒaʊh/","zh":"远，遥远","phrases":[{"t":"jauh sekali","zh":"非常远"},{"t":"jauh dari","zh":"远离..."},{"t":"jauh berbeda","zh":"大不相同"}],"examples":[{"t":"Rumahnya jauh dari sekolah.","zh":"他的家离学校很远。"},{"t":"Jangan pergi terlalu jauh.","zh":"不要走得太远。"}]},"ders":[{"w":"jauh","ipa":"/dʒaʊh/","zh":"远","phrase":{"t":"jauh di mata","zh":"远在天边"},"example":{"t":"Dia tinggal jauh di sana.","zh":"他住在很远的地方。"}},{"w":"menjauh","ipa":"/mən.dʒaʊh/","zh":"远离，走开","phrase":{"t":"menjauh dari keramaian","zh":"远离喧嚣"},"example":{"t":"Dia menjauh saat melihatku.","zh":"他看到我时便走开了。"}},{"w":"menjauhi","ipa":"/mən.dʒaʊ.hi/","zh":"避开，疏远","phrase":{"t":"menjauhi bahaya","zh":"避开危险"},"example":{"t":"Kita harus menjauhi narkoba.","zh":"我们必须远离毒品。"}},{"w":"menjauhkan","ipa":"/mən.dʒaʊh.kan/","zh":"使远离，把...移开","phrase":{"t":"menjauhkan diri","zh":"使自己远离"},"example":{"t":"Tolong jauhkan benda tajam itu.","zh":"请把那个尖锐的东西移开。"}},{"w":"kejauhan","ipa":"/kə.dʒaʊ.han/","zh":"太远，距离感","phrase":{"t":"terlalu kejauhan","zh":"太远了"},"example":{"t":"Jarak ini terasa kejauhan bagi saya.","zh":"这段距离对我来说感觉太远了。"}}],"derSlugs":["jauh","menjauh","menjauhi","menjauhkan","kejauhan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:27:18.673Z","src":"base"}