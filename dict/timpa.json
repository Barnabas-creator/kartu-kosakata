{"root":"timpa","ipa":"/ˈtimpa/","core":"重叠，压在上面，盖上","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈtimpa/","zh":"重叠，叠加，压","phrases":[{"t":"timpa tumpuk","zh":"层层叠加"},{"t":"menimpa nasib","zh":"遭遇命运打击"},{"t":"batu timpa","zh":"压在上面的石头"}],"examples":[{"t":"Genteng rumah itu tertimpa pohon tumbang.","zh":"那所房子的瓦片被倒下的树压坏了。"},{"t":"Bencana demi bencana menimpa negeri ini.","zh":"灾难接二连三地降临这个国家。"}]},"ders":[{"w":"timpa","ipa":"/ˈtimpa/","zh":"重叠，压","phrase":{"t":"timpa batu","zh":"压石块"},"example":{"t":"Jangan timpa barang berat di atas kertas itu.","zh":"不要把重物压在那张纸上面。"}},{"w":"menimpa","ipa":"/məˈnimpa/","zh":"压在…上面，降临，袭击","phrase":{"t":"menimpa korban","zh":"降临在受害者身上"},"example":{"t":"Musibah besar menimpa keluarga mereka.","zh":"巨大的灾难降临在他们家庭。"}},{"w":"tertimpa","ipa":"/tərˈtimpa/","zh":"遭压，受累于，不幸遇到","phrase":{"t":"tertimpa sial","zh":"倒霉"},"example":{"t":"Dia tertimpa musibah kemarin.","zh":"他昨天遭遇了不幸。"}},{"w":"timpaan","ipa":"/timˈpaan/","zh":"压着的重物，负担","phrase":{"t":"timpaan beban","zh":"负担的压力"},"example":{"t":"Timpaan batu itu sangat berat.","zh":"那块压着的石头非常重。"}}],"derSlugs":["timpa","menimpa","tertimpa","timpaan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-28T03:17:12.665Z","src":"base"}