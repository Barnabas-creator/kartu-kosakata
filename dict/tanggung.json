{"root":"tanggung","ipa":"/taŋ.ɡʊŋ/","core":"承担，负责；半大不小，不够彻底","pos":["动词","形容词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/taŋ.ɡʊŋ/","zh":"承担；不足的","phrases":[{"t":"tanggung jawab","zh":"责任"},{"t":"tanggung renteng","zh":"连带责任"},{"t":"kerja tanggung","zh":"未完成的工作"}],"examples":[{"t":"Dia harus tanggung semua kerugian itu.","zh":"他必须承担所有的损失。"},{"t":"Pekerjaan ini jangan dilakukan setengah-tanggung.","zh":"这项工作不要做得半途而废。"}]},"ders":[{"w":"tanggung","ipa":"/taŋ.ɡʊŋ/","zh":"承担，负责","phrase":{"t":"tanggung risiko","zh":"承担风险"},"example":{"t":"Risiko ini saya yang tanggung.","zh":"这个风险由我来承担。"}},{"w":"bertanggung","ipa":"/bər.taŋ.ɡʊŋ/","zh":"负有责任","phrase":{"t":"bertanggung penuh","zh":"负全责"},"example":{"t":"Manajer itu bertanggung atas proyek baru.","zh":"那位经理负责新项目。"}},{"w":"pertanggungjawaban","ipa":"/pər.taŋ.ɡʊŋ.ja.wa.bɔn/","zh":"交代，问责，责任汇报","phrase":{"t":"minta pertanggungjawaban","zh":"追究责任"},"example":{"t":"Kami butuh pertanggungjawaban atas kejadian ini.","zh":"我们需要针对这件事的交代。"}},{"w":"menanggung","ipa":"/mə.naŋ.ɡʊŋ/","zh":"忍受，负担，蒙受","phrase":{"t":"menanggung derita","zh":"遭受痛苦"},"example":{"t":"Dia menanggung rasa sakit yang luar biasa.","zh":"他承受着极大的痛苦。"}},{"w":"tanggungan","ipa":"/taŋ.ɡʊŋ.an/","zh":"家属，负担，债务","phrase":{"t":"anak tanggungan","zh":"被抚养的儿童"},"example":{"t":"Banyak tanggungan membuat dia harus bekerja keras.","zh":"众多的负担让他必须努力工作。"}},{"w":"bertanggung jawab","ipa":"/bər.taŋ.ɡʊŋ ja.wap/","zh":"负责任的","phrase":{"t":"orang yang bertanggung jawab","zh":"负责人"},"example":{"t":"Kita harus menjadi warga negara yang bertanggung jawab.","zh":"我们必须成为负责任的公民。"}}],"derSlugs":["tanggung","bertanggung","pertanggungjawaban","menanggung","tanggungan","bertanggung jawab"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-25T10:02:00.073Z","src":"base"}