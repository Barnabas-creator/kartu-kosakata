{"root":"tetes","ipa":"/tətəs/","core":"指液体的一滴或滴落的状态，常用于描述雨水、眼泪或汗水。","pos":["名词","动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/tətəs/","zh":"滴；滴落","phrases":[{"t":"tetes air mata","zh":"眼泪"},{"t":"tetes hujan","zh":"雨滴"},{"t":"setetes darah","zh":"一滴血"}],"examples":[{"t":"Ada tetes air yang jatuh dari atap.","zh":"有水滴从屋顶落下。"},{"t":"Dia meneteskan obat ke matanya.","zh":"他往眼睛里滴了药水。"}]},"ders":[{"w":"tetes","ipa":"/tətəs/","zh":"滴（名词）","phrase":{"t":"tetes terakhir","zh":"最后一滴"},"example":{"t":"Setetes air sangat berharga di gurun.","zh":"在沙漠里，一滴水都非常珍贵。"}},{"w":"menetes","ipa":"/mənətəs/","zh":"滴落（动词）","phrase":{"t":"air menetes","zh":"水滴落"},"example":{"t":"Keringat menetes dari dahinya.","zh":"汗水从他的额头上滴落。"}},{"w":"meneteskan","ipa":"/mənətəskan/","zh":"使滴下（动词）","phrase":{"t":"meneteskan air mata","zh":"流下眼泪"},"example":{"t":"Ibu meneteskan minyak kayu putih ke kain.","zh":"母亲往布上滴了几滴桉树油。"}},{"w":"tetesan","ipa":"/tətəsan/","zh":"滴下的液体（名词）","phrase":{"t":"tetesan embun","zh":"露珠"},"example":{"t":"Tetesan air itu membasahi lantai.","zh":"那些滴下的水弄湿了地板。"}}],"derSlugs":["tetes","menetes","meneteskan","tetesan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T02:44:46.711Z","src":"base"}