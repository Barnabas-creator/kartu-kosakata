{"root":"benar","ipa":"/bənar/","core":"正确的，真实的，确实的","pos":["形容词","虚词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/bənar/","zh":"形容某事符合事实、逻辑或道德标准；亦可作副词表示确认或强调。","phrases":[{"t":"benar sekali","zh":"非常正确"},{"t":"jawaban yang benar","zh":"正确的答案"},{"t":"benar-benar","zh":"确实地，真正地"}],"examples":[{"t":"Apa yang kamu katakan itu benar.","zh":"你所说的是正确的。"},{"t":"Dia benar tidak tahu apa-apa.","zh":"他确实什么都不知道。"}]},"ders":[{"w":"benar","ipa":"/bənar/","zh":"正确的","phrase":{"t":"jalan yang benar","zh":"正确的道路"},"example":{"t":"Keputusan itu sudah benar.","zh":"那个决定是正确的。"}},{"w":"kebenaran","ipa":"/kəbənaran/","zh":"真理，真相","phrase":{"t":"mencari kebenaran","zh":"寻求真理"},"example":{"t":"Kebenaran akan terungkap pada akhirnya.","zh":"真相最终会大白。"}},{"w":"membenarkan","ipa":"/məmənarkan/","zh":"证实，认可，纠正","phrase":{"t":"membenarkan laporan","zh":"证实报告"},"example":{"t":"Dia membenarkan berita itu.","zh":"他证实了那个消息。"}},{"w":"pembenaran","ipa":"/pəmənaran/","zh":"辩解，证明，正当化","phrase":{"t":"mencari pembenaran","zh":"寻找借口"},"example":{"t":"Itu hanyalah pembenaran atas kesalahannya.","zh":"那只不过是他为自己错误所做的辩解。"}}],"derSlugs":["benar","kebenaran","membenarkan","pembenaran"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:14:32.692Z","src":"base"}