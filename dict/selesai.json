{"root":"selesai","ipa":"/sə.lə.sai/","core":"完成，结束，完毕","pos":["形容词","动词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/sə.lə.sai/","zh":"指某事、工作或过程达到终点，不再继续或已经完成。","phrases":[{"t":"selesai tugas","zh":"任务完成"},{"t":"belum selesai","zh":"尚未完成"},{"t":"selesai sudah","zh":"已经结束了"}],"examples":[{"t":"Pekerjaan itu sudah selesai kemarin.","zh":"那项工作昨天已经完成了。"},{"t":"Kami akan pulang setelah rapat selesai.","zh":"会议结束后我们将回家。"}]},"ders":[{"w":"selesai","ipa":"/sə.lə.sai/","zh":"完成，结束","phrase":{"t":"selesai dikerjakan","zh":"已完成处理"},"example":{"t":"Ujiannya sudah selesai.","zh":"考试已经结束了。"}},{"w":"menyelesaikan","ipa":"/mə.ɲə.lə.sai.kan/","zh":"完成某事，解决某问题","phrase":{"t":"menyelesaikan masalah","zh":"解决问题"},"example":{"t":"Dia sedang menyelesaikan tugasnya.","zh":"他正在完成他的任务。"}},{"w":"penyelesaian","ipa":"/pə.ɲə.lə.sai.an/","zh":"完成，解决，终结","phrase":{"t":"penyelesaian sengketa","zh":"纠纷解决"},"example":{"t":"Penyelesaian masalah ini butuh waktu.","zh":"这个问题的解决需要时间。"}},{"w":"terselesaikan","ipa":"/tər.sə.lə.sai.kan/","zh":"被完成的，可被解决的","phrase":{"t":"mudah terselesaikan","zh":"容易被解决"},"example":{"t":"Kasus itu akhirnya terselesaikan.","zh":"那个案件最终被解决了。"}}],"derSlugs":["selesai","menyelesaikan","penyelesaian","terselesaikan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:28:05.886Z","src":"base"}