{"root":"lancar","ipa":"/lantʃar/","core":"形容词：流利的、顺畅的、顺利的；动词：使顺畅、促进。","pos":["形容词","动词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/lantʃar/","zh":"形容事物进展顺利、没有阻碍，或指语言表达流利。","phrases":[{"t":"lancar jaya","zh":"非常顺利"},{"t":"berbicara dengan lancar","zh":"流利地说话"},{"t":"lalu lintas lancar","zh":"交通顺畅"}],"examples":[{"t":"Proyek itu berjalan dengan lancar.","zh":"那个项目进展得很顺利。"},{"t":"Dia bisa berbahasa Indonesia dengan lancar.","zh":"他能流利地说印尼语。"}]},"ders":[{"w":"lancar","ipa":"/lantʃar/","zh":"流利的、顺畅的","phrase":{"t":"lancar sekali","zh":"非常流利"},"example":{"t":"Pekerjaannya lancar.","zh":"他的工作很顺畅。"}},{"w":"melancarkan","ipa":"/məlantʃarkan/","zh":"使顺畅、促进、发动（攻击等）","phrase":{"t":"melancarkan serangan","zh":"发动攻击"},"example":{"t":"Pemerintah melancarkan program baru.","zh":"政府推行了一项新计划。"}},{"w":"kelancaran","ipa":"/kəlantʃaran/","zh":"顺畅、流利度","phrase":{"t":"kelancaran arus lalu lintas","zh":"交通流的顺畅度"},"example":{"t":"Kelancaran acara ini sangat penting.","zh":"这次活动的顺利进行非常重要。"}}],"derSlugs":["lancar","melancarkan","kelancaran"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-27T16:33:25.070Z","src":"base"}