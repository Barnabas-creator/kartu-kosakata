{"root":"turut","ipa":"/tu.rut/","core":"跟随，参与，随同","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/tu.rut/","zh":"跟随、参与、随同","phrases":[{"t":"turut serta","zh":"参与，加入"},{"t":"turut campur","zh":"插手，干预"},{"t":"turut berduka","zh":"表示哀悼"}],"examples":[{"t":"Dia turut hadir dalam rapat itu.","zh":"他也参加了那次会议。"},{"t":"Saya turut senang mendengar kabar itu.","zh":"听到那个消息我也感到很高兴。"}]},"ders":[{"w":"turut","ipa":"/tu.rut/","zh":"跟随，参与","phrase":{"t":"turut bicara","zh":"参与讨论"},"example":{"t":"Anak itu turut bermain di taman.","zh":"那个孩子在公园里一起玩耍。"}},{"w":"menurut","ipa":"/mə.nu.rut/","zh":"根据，听从，按照","phrase":{"t":"menurut pendapat saya","zh":"依我之见"},"example":{"t":"Menurut aturan, kita tidak boleh merokok di sini.","zh":"根据规定，我们不可以在这里吸烟。"}},{"w":"turutan","ipa":"/tu.ru.tan/","zh":"跟随者，模仿物，顺序","phrase":{"t":"turutan kejadian","zh":"事件顺序"},"example":{"t":"Dia hanya pengikut turutan saja.","zh":"他只是一个盲目的跟随者。"}},{"w":"menuruti","ipa":"/mə.nu.ru.ti/","zh":"顺从，听从，满足","phrase":{"t":"menuruti kemauan","zh":"顺从意愿"},"example":{"t":"Jangan selalu menuruti keinginan anak.","zh":"不要总是顺从孩子的要求。"}},{"w":"keturutan","ipa":"/kə.tu.ru.tan/","zh":"被顺从的，被满足的","phrase":{"t":"keturutan keinginan","zh":"愿望得到满足"},"example":{"t":"Akhirnya semua keinginannya keturutan.","zh":"最终他所有的愿望都得到了满足。"}}],"derSlugs":["turut","menurut","turutan","menuruti","keturutan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:30:16.547Z","src":"base"}