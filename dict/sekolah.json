{"root":"sekolah","ipa":"/səˈko.lah/","core":"指进行教育活动的场所，即学校；也指受教育的过程或学习活动。","pos":["名词","动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/səˈko.lah/","zh":"学校；上学","phrases":[{"t":"sekolah dasar","zh":"小学"},{"t":"pergi ke sekolah","zh":"去上学"},{"t":"jam sekolah","zh":"上课时间"}],"examples":[{"t":"Adik saya sudah mulai sekolah tahun ini.","zh":"我弟弟今年已经开始上学了。"},{"t":"Sekolah itu terletak di dekat pusat kota.","zh":"那所学校位于市中心附近。"}]},"ders":[{"w":"sekolah","ipa":"/səˈko.lah/","zh":"学校；上学","phrase":{"t":"anak sekolah","zh":"在校学生"},"example":{"t":"Dia rajin sekolah setiap hari.","zh":"他每天都勤奋上学。"}},{"w":"bersekolah","ipa":"/bər.səˈko.lah/","zh":"在校学习；受教育","phrase":{"t":"bersekolah di luar negeri","zh":"在国外求学"},"example":{"t":"Mereka bersekolah di universitas yang sama.","zh":"他们在同一所大学求学。"}},{"w":"menyekolahkan","ipa":"/mə.ɲə.ko.la.kan/","zh":"送某人去上学；供某人读书","phrase":{"t":"menyekolahkan anak","zh":"供孩子上学"},"example":{"t":"Ayah bekerja keras untuk menyekolahkan kami.","zh":"父亲努力工作以供我们上学。"}},{"w":"persekolahan","ipa":"/pər.sə.ko.la.han/","zh":"学校教育；学校事务","phrase":{"t":"dunia persekolahan","zh":"学校教育界"},"example":{"t":"Pemerintah meningkatkan kualitas sistem persekolahan.","zh":"政府提高了学校教育系统的质量。"}}],"derSlugs":["sekolah","bersekolah","menyekolahkan","persekolahan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:37:28.175Z","src":"base"}