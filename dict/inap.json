{"root":"inap","ipa":"/iˈnap/","core":"指在某处过夜、住宿或留宿，通常指非正式的短期停留。","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/iˈnap/","zh":"住宿，留宿","phrases":[{"t":"inap di hotel","zh":"在酒店住宿"},{"t":"tempat inap","zh":"住宿地点"},{"t":"biaya inap","zh":"住宿费"}],"examples":[{"t":"Dia inap di rumah temannya semalam.","zh":"他昨晚在他朋友家留宿。"},{"t":"Kami mencari tempat inap yang murah.","zh":"我们正在寻找便宜的住宿地点。"}]},"ders":[{"w":"inap","ipa":"/iˈnap/","zh":"住宿","phrase":{"t":"izin inap","zh":"留宿许可"},"example":{"t":"Boleh saya inap di sini?","zh":"我可以留宿在这里吗？"}},{"w":"menginap","ipa":"/məˈŋi.nap/","zh":"过夜，投宿","phrase":{"t":"menginap di vila","zh":"在别墅过夜"},"example":{"t":"Mereka menginap di hotel selama tiga hari.","zh":"他们在酒店住了三天。"}},{"w":"penginapan","ipa":"/pə.ŋi.naˈpan/","zh":"旅馆，住宿处","phrase":{"t":"penginapan murah","zh":"廉价旅馆"},"example":{"t":"Banyak penginapan di sekitar pantai itu.","zh":"那片海滩附近有很多旅馆。"}},{"w":"menginapkan","ipa":"/mə.ŋi.naˈpkan/","zh":"使……留宿，提供住宿","phrase":{"t":"menginapkan tamu","zh":"接待客人留宿"},"example":{"t":"Dia menginapkan saudaranya di rumahnya.","zh":"他让他的亲戚住在自己家里。"}}],"derSlugs":["inap","menginap","penginapan","menginapkan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-27T16:37:20.548Z","src":"base"}