{"root":"junjung","ipa":"/dʒʊn.dʒʊŋ/","core":"尊崇，高举，拥戴","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/dʒʊn.dʒʊŋ/","zh":"尊崇、高举、拥戴","phrases":[{"t":"menjunjung tinggi","zh":"高度尊崇"},{"t":"junjung derajat","zh":"提升地位"},{"t":"dijunjung tinggi","zh":"备受尊崇"}],"examples":[{"t":"Kita harus menjunjung tinggi nilai-nilai Pancasila.","zh":"我们必须高度尊崇潘查西亚（印尼建国五项原则）价值观。"},{"t":"Keputusan raja dijunjung tinggi oleh rakyat.","zh":"国王的决定受到人民的拥戴和遵从。"}]},"ders":[{"w":"junjung","ipa":"/dʒʊn.dʒʊŋ/","zh":"尊崇，顶在头上","phrase":{"t":"junjung duli","zh":"觐见君王"},"example":{"t":"Dia berjalan dengan bakul di-junjung.","zh":"她头上顶着篮子走路。"}},{"w":"menjunjung","ipa":"/mən.dʒʊn.dʒʊŋ/","zh":"尊崇，顶戴，奉行","phrase":{"t":"menjunjung perintah","zh":"奉命"},"example":{"t":"Saya siap menjunjung perintah Anda.","zh":"我准备好奉行您的命令了。"}},{"w":"menjunjungkan","ipa":"/mən.dʒʊn.dʒʊŋ.kan/","zh":"使尊崇，为...而顶戴","phrase":{"t":"menjunjungkan kepala","zh":"抬起头"},"example":{"t":"Dia menjunjungkan bendera kebanggaan.","zh":"他高高举起了自豪的旗帜。"}},{"w":"terjunjung","ipa":"/tər.dʒʊn.dʒʊŋ/","zh":"被尊崇的，被顶在头上的","phrase":{"t":"nama terjunjung","zh":"备受尊崇的名字"},"example":{"t":"Jasa pahlawan selalu terjunjung tinggi.","zh":"英雄的功绩总是备受尊崇。"}},{"w":"junjungan","ipa":"/dʒʊn.dʒʊŋ.an/","zh":"领袖，尊崇的人，精神支柱","phrase":{"t":"nabi junjungan","zh":"备受尊崇的先知"},"example":{"t":"Nabi Muhammad adalah junjungan umat Islam.","zh":"穆罕默德先知是伊斯兰教徒尊崇的领袖。"}}],"derSlugs":["junjung","menjunjung","menjunjungkan","terjunjung","junjungan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T17:20:29.669Z","src":"base"}