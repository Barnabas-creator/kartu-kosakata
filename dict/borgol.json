{"root":"borgol","ipa":"/bor.ɡol/","core":"手铐，指用于锁住犯人或嫌疑人手腕的金属环装置。","pos":["名词","动词"],"scenes":["高频","工作"],"rootBlock":{"ipa":"/bor.ɡol/","zh":"手铐；用手铐铐住","phrases":[{"t":"memasang borgol","zh":"戴上手铐"},{"t":"terkena borgol","zh":"被铐住"},{"t":"borgol besi","zh":"铁手铐"}],"examples":[{"t":"Polisi memborgol tangan tersangka itu.","zh":"警察给那个嫌疑人戴上了手铐。"},{"t":"Dia mencoba melepaskan diri dari borgol.","zh":"他试图从手铐中挣脱。"}]},"ders":[{"w":"borgol","ipa":"/bor.ɡol/","zh":"手铐","phrase":{"t":"borgol tangan","zh":"手铐"},"example":{"t":"Borgol itu sangat kuat.","zh":"那副手铐非常坚固。"}},{"w":"memborgol","ipa":"/məm.bor.ɡol/","zh":"给...戴上手铐","phrase":{"t":"memborgol pelaku","zh":"给罪犯戴上手铐"},"example":{"t":"Petugas segera memborgol tangannya.","zh":"警员立即给他的双手戴上了手铐。"}},{"w":"terborgol","ipa":"/tər.bor.ɡol/","zh":"被铐住的","phrase":{"t":"tangan terborgol","zh":"被铐住的双手"},"example":{"t":"Dia duduk dengan tangan terborgol.","zh":"他双手被铐着坐在那里。"}},{"w":"pemborgolan","ipa":"/pəm.bor.ɡo.lan/","zh":"铐住的行为；戴手铐的过程","phrase":{"t":"proses pemborgolan","zh":"戴手铐的过程"},"example":{"t":"Pemborgolan itu dilakukan sesuai prosedur.","zh":"戴手铐的过程是按照程序进行的。"}}],"derSlugs":["borgol","memborgol","terborgol","pemborgolan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T08:24:29.451Z","src":"base"}