{"root":"pandang","ipa":"/ˈpand.aŋ/","core":"看，观察，视线，观点","pos":["动词","名词"],"scenes":["高频","工作"],"rootBlock":{"ipa":"/ˈpand.aŋ/","zh":"看，注视，观点","phrases":[{"t":"pandang bulu","zh":"带有偏见，看人下菜碟"},{"t":"pandang serong","zh":"斜视，不信任地看"},{"t":"sudut pandang","zh":"角度，观点"}],"examples":[{"t":"Jangan pandang remeh kemampuan orang lain.","zh":"不要轻视别人的能力。"},{"t":"Dia memandang ke luar jendela.","zh":"他向窗外望去。"}]},"ders":[{"w":"pandang","ipa":"/ˈpand.aŋ/","zh":"看，注视","phrase":{"t":"pandang pertama","zh":"第一眼"},"example":{"t":"Cinta pada pandang pertama itu nyata.","zh":"一见钟情是真的。"}},{"w":"memandang","ipa":"/məˈmand.aŋ/","zh":"注视，观察，视作","phrase":{"t":"memandang masa depan","zh":"展望未来"},"example":{"t":"Ibu memandang anaknya dengan penuh kasih sayang.","zh":"母亲充满爱意地看着她的孩子。"}},{"w":"memandangi","ipa":"/məˈmand.aŋ.i/","zh":"连续地看，凝视","phrase":{"t":"memandangi foto","zh":"凝视照片"},"example":{"t":"Dia terus memandangi layar ponselnya.","zh":"他一直凝视着手机屏幕。"}},{"w":"terpandang","ipa":"/tərˈmand.aŋ/","zh":"被看见的，声誉好的，显赫的","phrase":{"t":"orang terpandang","zh":"知名人士，有声望的人"},"example":{"t":"Keluarganya adalah keluarga yang terpandang di kota ini.","zh":"他的家族是这个城市里声誉显赫的家族。"}},{"w":"pandangan","ipa":"/panˈdaŋ.an/","zh":"视线，看法，观点","phrase":{"t":"pandangan hidup","zh":"人生观"},"example":{"t":"Bagaimana pandanganmu tentang masalah ini?","zh":"你对这个问题有什么看法？"}}],"derSlugs":["pandang","memandang","memandangi","terpandang","pandangan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T02:01:51.854Z","src":"base"}