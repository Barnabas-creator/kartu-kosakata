{"root":"norma","ipa":"/ˈnɔrma/","core":"规范，准则，标准，常态","pos":["名词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/ˈnɔrma/","zh":"指社会、组织或群体中公认的行为准则、标准或规范。","phrases":[{"t":"norma sosial","zh":"社会规范"},{"t":"norma hukum","zh":"法律准则"},{"t":"melanggar norma","zh":"违反规范"}],"examples":[{"t":"Setiap masyarakat memiliki norma yang harus dipatuhi.","zh":"每个社会都有必须遵守的规范。"},{"t":"Perilakunya tidak sesuai dengan norma yang berlaku di kantor ini.","zh":"他的行为不符合这家办公室通行的准则。"}]},"ders":[{"w":"norma","ipa":"/ˈnɔrma/","zh":"规范，准则","phrase":{"t":"norma kesopanan","zh":"礼貌准则"},"example":{"t":"Kita harus menghormati norma setempat.","zh":"我们必须尊重当地的规范。"}},{"w":"normal","ipa":"/nɔrˈmal/","zh":"正常的，标准的","phrase":{"t":"suhu normal","zh":"正常体温"},"example":{"t":"Kondisi kesehatannya sudah kembali normal.","zh":"他的健康状况已经恢复正常。"}},{"w":"normalisasi","ipa":"/nɔrmaliˈsasi/","zh":"正常化","phrase":{"t":"normalisasi hubungan","zh":"关系正常化"},"example":{"t":"Proses normalisasi ekonomi sedang berlangsung.","zh":"经济正常化的进程正在进行中。"}},{"w":"menormalkan","ipa":"/məˈnɔrmalkan/","zh":"使正常化，使符合规范","phrase":{"t":"menormalkan situasi","zh":"使局势正常化"},"example":{"t":"Pemerintah berusaha menormalkan harga pasar.","zh":"政府正努力使市场价格正常化。"}}],"derSlugs":["norma","normal","normalisasi","menormalkan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-30T15:52:57.850Z","src":"base"}