{"root":"tidak","ipa":"/ti.daʔ/","core":"用于否定动词、形容词或名词的否定副词，相当于中文的“不”或“不是”。","pos":["虚词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/ti.daʔ/","zh":"不，不是","phrases":[{"t":"tidak tahu","zh":"不知道"},{"t":"tidak apa-apa","zh":"没关系"},{"t":"tidak mungkin","zh":"不可能"}],"examples":[{"t":"Saya tidak pergi ke kantor hari ini.","zh":"我今天不去办公室。"},{"t":"Dia tidak suka makan pedas.","zh":"他不爱吃辣。"}]},"ders":[{"w":"tidak","ipa":"/ti.daʔ/","zh":"不","phrase":{"t":"tidak mau","zh":"不愿意"},"example":{"t":"Dia tidak mau makan.","zh":"他不肯吃饭。"}},{"w":"tidaknya","ipa":"/ti.daʔ.ɲa/","zh":"是否（用于疑问句末尾表示选择）","phrase":{"t":"kepastian tidaknya","zh":"是否确定"},"example":{"t":"Saya belum tahu jadi tidaknya acara itu.","zh":"我还没确定那个活动是否会举行。"}},{"w":"ketidakadaan","ipa":"/kə.ti.daʔ.a.da.an/","zh":"不存在，缺乏","phrase":{"t":"ketidakadaan bukti","zh":"缺乏证据"},"example":{"t":"Ketidakadaan dana menghambat proyek ini.","zh":"资金的匮乏阻碍了这个项目。"}}],"derSlugs":["tidak","tidaknya","ketidakadaan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:10:23.909Z","src":"base"}