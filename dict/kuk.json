{"root":"kuk","ipa":"/kuk/","core":"指代一种模仿鸡叫的声音，或在某些方言中指代鸡本身，常用于拟声词或特定语境。","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/kuk/","zh":"鸡叫声，拟声词","phrases":[{"t":"suara kuk","zh":"鸡叫声"},{"t":"bunyi kuk","zh":"咯咯声"},{"t":"menirukan kuk","zh":"模仿鸡叫"}],"examples":[{"t":"Terdengar suara kuk ayam di pagi hari.","zh":"清晨听到了鸡的叫声。"},{"t":"Anak itu menirukan suara kuk ayam dengan lucu.","zh":"那个孩子滑稽地模仿着鸡叫声。"}]},"ders":[{"w":"kuk","ipa":"/kuk/","zh":"鸡叫声","phrase":{"t":"kuk ayam","zh":"鸡鸣"},"example":{"t":"Kuk ayam membangunkan saya.","zh":"鸡鸣声把我叫醒了。"}},{"w":"berkuk","ipa":"/bər.kuk/","zh":"发出鸡叫声","phrase":{"t":"ayam berkuk","zh":"鸡在叫"},"example":{"t":"Ayam itu mulai berkuk saat fajar.","zh":"那只鸡在黎明时分开始啼叫。"}}],"derSlugs":["kuk","berkuk"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:47:47.268Z","src":"base"}