{"root":"tegang","ipa":"/təɡaŋ/","core":"形容紧张、紧绷、僵持的状态，既可指物理上的拉紧，也可指心理上的紧张或局势的严峻。","pos":["形容词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/təɡaŋ/","zh":"紧张的，紧绷的","phrases":[{"t":"suasana tegang","zh":"紧张的气氛"},{"t":"saraf tegang","zh":"神经紧张"},{"t":"hubungan yang tegang","zh":"紧张的关系"}],"examples":[{"t":"Tali itu ditarik sangat tegang.","zh":"那根绳子被拉得很紧。"},{"t":"Situasi politik di negara itu sedang tegang.","zh":"那个国家的政治局势正处于紧张状态。"}]},"ders":[{"w":"tegang","ipa":"/təɡaŋ/","zh":"紧张的","phrase":{"t":"otot tegang","zh":"肌肉紧绷"},"example":{"t":"Jangan terlalu tegang saat ujian.","zh":"考试时不要太紧张。"}},{"w":"ketegangan","ipa":"/kətəɡaŋan/","zh":"紧张状态，张力","phrase":{"t":"ketegangan otot","zh":"肌肉紧张"},"example":{"t":"Ketegangan di antara mereka mulai mereda.","zh":"他们之间的紧张关系开始缓和。"}},{"w":"menegang","ipa":"/mənəɡaŋ/","zh":"变得紧张，紧绷起来","phrase":{"t":"situasi menegang","zh":"局势变得紧张"},"example":{"t":"Wajahnya menegang saat mendengar berita itu.","zh":"听到那个消息时，他的表情变得紧绷。"}},{"w":"menegangkan","ipa":"/mənəɡaŋkan/","zh":"使紧张，令人紧张的","phrase":{"t":"film yang menegangkan","zh":"令人紧张的电影"},"example":{"t":"Pertandingan final itu sangat menegangkan.","zh":"那场决赛非常扣人心弦。"}}],"derSlugs":["tegang","ketegangan","menegang","menegangkan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-27T16:34:04.164Z","src":"base"}