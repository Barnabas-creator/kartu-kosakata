{"root":"pojok","ipa":"/po.dʒɔk/","core":"角落、拐角，指空间或物体边缘交汇的地方，也可引申为偏僻的地点。","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/po.dʒɔk/","zh":"角落、拐角","phrases":[{"t":"pojok ruangan","zh":"房间角落"},{"t":"di pojok jalan","zh":"在街角"},{"t":"pojok meja","zh":"桌角"}],"examples":[{"t":"Dia duduk di pojok kelas.","zh":"他坐在教室的角落里。"},{"t":"Ada toko kecil di pojok jalan itu.","zh":"在那条街的拐角处有一家小店。"}]},"ders":[{"w":"pojok","ipa":"/po.dʒɔk/","zh":"角落","phrase":{"t":"pojok rumah","zh":"屋角"},"example":{"t":"Debu menumpuk di pojok.","zh":"灰尘堆积在角落里。"}},{"w":"memojokkan","ipa":"/mə.mo.dʒɔk.kan/","zh":"使陷入困境、逼入死角","phrase":{"t":"memojokkan lawan","zh":"使对手陷入困境"},"example":{"t":"Pertanyaan itu memojokkan dia.","zh":"那个问题让他陷入了窘境。"}},{"w":"terpojok","ipa":"/tər.po.dʒɔk/","zh":"被逼入死角的、陷入困境的","phrase":{"t":"merasa terpojok","zh":"感到走投无路"},"example":{"t":"Dia merasa terpojok oleh bukti-bukti tersebut.","zh":"他感到被那些证据逼入了死角。"}}],"derSlugs":["pojok","memojokkan","terpojok"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T08:29:59.483Z","src":"base"}