{"root":"sabar","ipa":"/ˈsabar/","core":"耐心，容忍，冷静","pos":["形容词","名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈsabar/","zh":"有耐心的，耐心的，冷静的；耐心","phrases":[{"t":"harap sabar","zh":"请耐心"},{"t":"sabar ya","zh":"耐着性子哈"},{"t":"tetap sabar","zh":"保持耐心"}],"examples":[{"t":"Harap bersabar, antrean masih panjang.","zh":"请耐心等待，队伍还很长。"},{"t":"Dia sangat sabar menghadapi anak-anak itu.","zh":"他对待那些孩子非常有耐心。"}]},"ders":[{"w":"sabar","ipa":"/ˈsabar/","zh":"耐心的，耐心","phrase":{"t":"orang sabar","zh":"有耐心的人"},"example":{"t":"Jadilah orang yang sabar.","zh":"做一个有耐心的人。"}},{"w":"bersabar","ipa":"/bərˈsabar/","zh":"保持耐心，忍耐","phrase":{"t":"harus bersabar","zh":"必须忍耐"},"example":{"t":"Kita harus bersabar dalam situasi ini.","zh":"在这种情况下我们必须保持耐心。"}},{"w":"kesabaran","ipa":"/kə.saˈba.ran/","zh":"耐心，毅力","phrase":{"t":"uji kesabaran","zh":"考验耐心"},"example":{"t":"Kesabaranmu sangat dihargai.","zh":"你的耐心非常受赞赏。"}},{"w":"menyabarkan","ipa":"/mə.ɲaˈbar.kan/","zh":"使冷静，劝慰","phrase":{"t":"menyabarkan hati","zh":"平复心情"},"example":{"t":"Dia mencoba menyabarkan adiknya yang menangis.","zh":"他试图安慰正在哭泣的弟弟。"}}],"derSlugs":["sabar","bersabar","kesabaran","menyabarkan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T02:18:53.838Z","src":"base"}