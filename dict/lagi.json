{"root":"lagi","ipa":"/la.ɡi/","core":"表示动作的持续、重复或程度的加深，意为“再”、“又”、“还”、“正在”。","pos":["虚词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/la.ɡi/","zh":"再，又，还，正在","phrases":[{"t":"lagi pula","zh":"况且，而且"},{"t":"sekali lagi","zh":"再一次"},{"t":"lagi-lagi","zh":"总是，老是"}],"examples":[{"t":"Saya sedang makan lagi.","zh":"我正在吃东西。"},{"t":"Boleh minta tambah lagi?","zh":"可以再加一点吗？"}]},"ders":[{"w":"lagi","ipa":"/la.ɡi/","zh":"再，又，还","phrase":{"t":"lagi dan lagi","zh":"一次又一次"},"example":{"t":"Dia datang lagi hari ini.","zh":"他今天又来了。"}},{"w":"selagi","ipa":"/sə.la.ɡi/","zh":"当...的时候，只要","phrase":{"t":"selagi muda","zh":"趁年轻时"},"example":{"t":"Belajarlah selagi ada waktu.","zh":"趁有时间的时候学习吧。"}},{"w":"berlagi-lagi","ipa":"/bər.la.ɡi.la.ɡi/","zh":"反复地，多次地","phrase":{"t":"berlagi-lagi diingatkan","zh":"反复被提醒"},"example":{"t":"Masalah itu berlagi-lagi muncul.","zh":"那个问题反复出现。"}}],"derSlugs":["lagi","selagi","berlagi-lagi"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:14:57.227Z","src":"base"}