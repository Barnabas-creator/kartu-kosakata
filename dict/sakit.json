{"root":"sakit","ipa":"/sa.kɪt/","core":"指身体或心理上的不适、疼痛、患病或痛苦。","pos":["形容词","名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/sa.kɪt/","zh":"生病、疼痛、痛苦","phrases":[{"t":"sakit kepala","zh":"头痛"},{"t":"sakit hati","zh":"心痛、怨恨"},{"t":"sakit gigi","zh":"牙痛"}],"examples":[{"t":"Dia tidak masuk kerja karena sakit.","zh":"他因为生病没去上班。"},{"t":"Perut saya terasa sakit sekali.","zh":"我的肚子感觉非常痛。"}]},"ders":[{"w":"sakit","ipa":"/sa.kɪt/","zh":"生病、疼痛","phrase":{"t":"sakit perut","zh":"肚子痛"},"example":{"t":"Anak itu sedang sakit.","zh":"那个孩子正在生病。"}},{"w":"menyakiti","ipa":"/mə.ɲa.ki.ti/","zh":"伤害、使痛苦","phrase":{"t":"menyakiti perasaan","zh":"伤害感情"},"example":{"t":"Jangan menyakiti hati orang lain.","zh":"不要伤害别人的心。"}},{"w":"penyakit","ipa":"/pə.ɲa.kɪt/","zh":"疾病","phrase":{"t":"penyakit menular","zh":"传染病"},"example":{"t":"Dokter sedang meneliti penyakit itu.","zh":"医生正在研究那种疾病。"}},{"w":"kesakitan","ipa":"/kə.sa.ki.tan/","zh":"感到疼痛、痛苦的状态","phrase":{"t":"menjerit kesakitan","zh":"痛得尖叫"},"example":{"t":"Dia meringis kesakitan setelah jatuh.","zh":"他摔倒后痛得龇牙咧嘴。"}}],"derSlugs":["sakit","menyakiti","penyakit","kesakitan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:24:34.484Z","src":"base"}