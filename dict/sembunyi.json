{"root":"sembunyi","ipa":"/səm.bu.ɲi/","core":"隐藏，躲藏，隐蔽","pos":["动词","形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/səm.bu.ɲi/","zh":"指将某物置于他人视线之外，或自身躲避起来以防被发现。","phrases":[{"t":"sembunyi diri","zh":"躲藏起来"},{"t":"sembunyi-sembunyi","zh":"偷偷摸摸地"},{"t":"bersembunyi di balik","zh":"躲在……后面"}],"examples":[{"t":"Dia sembunyi di balik pintu.","zh":"他躲在门后。"},{"t":"Jangan sembunyi kebenaran dariku.","zh":"不要对我隐瞒真相。"}]},"ders":[{"w":"sembunyi","ipa":"/səm.bu.ɲi/","zh":"隐藏","phrase":{"t":"sembunyi barang","zh":"藏东西"},"example":{"t":"Anak itu sembunyi di bawah meja.","zh":"那个孩子躲在桌子底下。"}},{"w":"bersembunyi","ipa":"/bər.səm.bu.ɲi/","zh":"躲藏，潜伏","phrase":{"t":"bersembunyi dari musuh","zh":"躲避敌人"},"example":{"t":"Mereka bersembunyi di dalam gua.","zh":"他们躲在洞穴里。"}},{"w":"menyembunyikan","ipa":"/mə.ɲəm.bu.ɲi.kan/","zh":"把……藏起来，隐瞒","phrase":{"t":"menyembunyikan fakta","zh":"隐瞒事实"},"example":{"t":"Dia menyembunyikan hadiah itu di lemari.","zh":"他把礼物藏在柜子里。"}},{"w":"persembunyian","ipa":"/pər.səm.bu.ɲi.an/","zh":"藏身处，隐蔽所","phrase":{"t":"tempat persembunyian","zh":"藏身之地"},"example":{"t":"Polisi menemukan persembunyian pencuri itu.","zh":"警察发现了小偷的藏身处。"}},{"w":"tersembunyi","ipa":"/tər.səm.bu.ɲi/","zh":"被隐藏的，隐蔽的","phrase":{"t":"harta tersembunyi","zh":"隐藏的宝藏"},"example":{"t":"Ada bakat tersembunyi dalam dirinya.","zh":"他身上有一种隐藏的天赋。"}}],"derSlugs":["sembunyi","bersembunyi","menyembunyikan","persembunyian","tersembunyi"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:42:08.495Z","src":"base"}