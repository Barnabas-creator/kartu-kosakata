{"root":"balik","ipa":"/ba.lɪk/","core":"返回，回来，反转，相反","pos":["动词","形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ba.lɪk/","zh":"返回、回来或反转的状态","phrases":[{"t":"balik lagi","zh":"再回来"},{"t":"balik kanan","zh":"向右转"},{"t":"bolak-balik","zh":"来回，往返"}],"examples":[{"t":"Dia akan balik ke rumah besok.","zh":"他明天会回家。"},{"t":"Tolong balik kertas itu.","zh":"请把那张纸翻过来。"}]},"ders":[{"w":"balik","ipa":"/ba.lɪk/","zh":"返回，翻转","phrase":{"t":"balik modal","zh":"回本"},"example":{"t":"Saya harus balik sekarang.","zh":"我现在必须回去了。"}},{"w":"berbalik","ipa":"/bər.ba.lɪk/","zh":"转过身，掉头","phrase":{"t":"berbalik arah","zh":"掉头，改变方向"},"example":{"t":"Dia berbalik melihat ke belakang.","zh":"他转过身向后看。"}},{"w":"membalik","ipa":"/məm.ba.lɪk/","zh":"翻转，使倒置","phrase":{"t":"membalik halaman","zh":"翻页"},"example":{"t":"Ibu membalik ikan di penggorengan.","zh":"母亲在锅里翻动鱼。"}},{"w":"membalikkan","ipa":"/məm.ba.lɪk.kan/","zh":"使翻转，使倒置","phrase":{"t":"membalikkan keadaan","zh":"扭转局势"},"example":{"t":"Dia membalikkan telapak tangannya.","zh":"他翻转了他的手掌。"}},{"w":"terbalik","ipa":"/tər.ba.lɪk/","zh":"翻转的，颠倒的","phrase":{"t":"posisi terbalik","zh":"倒置的位置"},"example":{"t":"Gambar itu terbalik.","zh":"那张图片放反了。"}},{"w":"balikan","ipa":"/ba.lɪ.kan/","zh":"复合（指恋人），回赠物","phrase":{"t":"ajak balikan","zh":"请求复合"},"example":{"t":"Mereka memutuskan untuk balikan.","zh":"他们决定复合。"}}],"derSlugs":["balik","berbalik","membalik","membalikkan","terbalik","balikan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:45:41.618Z","src":"base"}