{"root":"tunduk","ipa":"/tun.duk/","core":"低头、屈服、顺从","pos":["动词","形容词"],"scenes":["高频","工作","教会"],"rootBlock":{"ipa":"/tun.duk/","zh":"低头，指身体前倾或低垂头部；引申为屈服、服从权威或意志。","phrases":[{"t":"tunduk patuh","zh":"顺从，服从"},{"t":"menundukkan kepala","zh":"低头"},{"t":"tunduk kepada hukum","zh":"服从法律"}],"examples":[{"t":"Dia tunduk malu saat ditegur gurunya.","zh":"当被老师责备时，他羞愧地低下了头。"},{"t":"Kita tidak boleh tunduk pada ketidakadilan.","zh":"我们不能向不公正屈服。"}]},"ders":[{"w":"tunduk","ipa":"/tun.duk/","zh":"低头；屈服","phrase":{"t":"tunduk hormat","zh":"鞠躬致敬"},"example":{"t":"Mereka tunduk saat berdoa.","zh":"他们在祈祷时低下了头。"}},{"w":"menunduk","ipa":"/mə.nun.duk/","zh":"低头（动作）","phrase":{"t":"menunduk ke bawah","zh":"向下低头"},"example":{"t":"Dia menunduk untuk mengambil pena yang jatuh.","zh":"他低头去捡掉落的钢笔。"}},{"w":"menundukkan","ipa":"/mə.nun.duk.kan/","zh":"使……低头；征服；压制","phrase":{"t":"menundukkan musuh","zh":"征服敌人"},"example":{"t":"Pemerintah berusaha menundukkan inflasi.","zh":"政府正努力抑制通货膨胀。"}},{"w":"tertunduk","ipa":"/tər.tun.duk/","zh":"低垂的；不自觉地低头","phrase":{"t":"kepala tertunduk","zh":"低垂的头"},"example":{"t":"Dia duduk dengan kepala tertunduk sedih.","zh":"他悲伤地低着头坐着。"}},{"w":"ketundukan","ipa":"/kə.tun.du.kan/","zh":"顺从；屈服（名词）","phrase":{"t":"ketundukan mutlak","zh":"绝对的顺从"},"example":{"t":"Ketundukan rakyat kepada raja sangat tinggi.","zh":"民众对国王的顺从度非常高。"}}],"derSlugs":["tunduk","menunduk","menundukkan","tertunduk","ketundukan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:31:23.669Z","src":"base"}