{"root":"eksekutif","ipa":"/ɛksɛkutɪf/","core":"指执行机构、行政部门或担任高级管理职务的人员。","pos":["名词","形容词"],"scenes":["工作","高频"],"rootBlock":{"ipa":"/ɛksɛkutɪf/","zh":"执行的；行政的；行政人员；主管","phrases":[{"t":"pejabat eksekutif","zh":"行政官员"},{"t":"kekuasaan eksekutif","zh":"行政权"},{"t":"eksekutif muda","zh":"年轻主管"}],"examples":[{"t":"Presiden adalah kepala cabang eksekutif pemerintah.","zh":"总统是政府行政部门的首脑。"},{"t":"Dia bekerja sebagai eksekutif di perusahaan multinasional.","zh":"他在一家跨国公司担任主管。"}]},"ders":[{"w":"eksekutif","ipa":"/ɛksɛkutɪf/","zh":"行政的；主管","phrase":{"t":"gaya eksekutif","zh":"行政风格"},"example":{"t":"Keputusan eksekutif itu sangat penting.","zh":"那项行政决策非常重要。"}},{"w":"mengeksekutifkan","ipa":"/məŋɛksɛkutɪfkən/","zh":"使……成为行政的；执行化","phrase":{"t":"mengeksekutifkan kebijakan","zh":"使政策执行化"},"example":{"t":"Mereka berusaha mengeksekutifkan rencana tersebut.","zh":"他们试图将该计划执行化。"}}],"derSlugs":["eksekutif","mengeksekutifkan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T09:07:19.705Z","src":"base"}