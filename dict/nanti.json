{"root":"nanti","ipa":"/nanti/","core":"副词，表示在将来某个时间点，意为“稍后”、“待会儿”或“以后”。","pos":["虚词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/nanti/","zh":"稍后，待会儿，以后","phrases":[{"t":"nanti dulu","zh":"等一下"},{"t":"sampai nanti","zh":"回头见"},{"t":"nanti malam","zh":"今天晚上"}],"examples":[{"t":"Saya akan meneleponmu nanti.","zh":"我稍后会给你打电话。"},{"t":"Jangan pergi sekarang, nanti saja.","zh":"现在别走，待会儿再说。"}]},"ders":[{"w":"nanti","ipa":"/nanti/","zh":"稍后，待会儿","phrase":{"t":"nanti sore","zh":"今天傍晚"},"example":{"t":"Kita bicarakan ini nanti.","zh":"我们稍后再谈这件事。"}},{"w":"menanti","ipa":"/mənanti/","zh":"等待，等候","phrase":{"t":"menanti kedatangan","zh":"等待到来"},"example":{"t":"Dia menanti kabar dari keluarganya.","zh":"他正在等待家人的消息。"}},{"w":"menantikan","ipa":"/mənantikan/","zh":"期待，盼望","phrase":{"t":"menantikan jawaban","zh":"期待答复"},"example":{"t":"Kami sangat menantikan kunjungan Anda.","zh":"我们非常期待您的到访。"}},{"w":"penantian","ipa":"/pənantian/","zh":"等待（过程），期待","phrase":{"t":"penantian panjang","zh":"漫长的等待"},"example":{"t":"Penantian itu akhirnya berakhir.","zh":"那场等待终于结束了。"}},{"w":"dinantikan","ipa":"/dinantikan/","zh":"被期待，被盼望","phrase":{"t":"yang dinantikan","zh":"所期待的"},"example":{"t":"Hasil ini sangat dinantikan oleh semua orang.","zh":"这个结果是所有人所期待的。"}}],"derSlugs":["nanti","menanti","menantikan","penantian","dinantikan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:34:19.020Z","src":"base"}