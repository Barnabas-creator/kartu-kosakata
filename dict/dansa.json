{"root":"dansa","ipa":"/ˈdansa/","core":"指随着音乐节奏有规律地移动身体，即跳舞。","pos":["动词","名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈdansa/","zh":"跳舞；舞蹈","phrases":[{"t":"dansa dansi","zh":"跳来跳去"},{"t":"ajak dansa","zh":"邀请跳舞"},{"t":"belajar dansa","zh":"学习舞蹈"}],"examples":[{"t":"Mereka suka dansa di pesta itu.","zh":"他们喜欢在那场派对上跳舞。"},{"t":"Dansa adalah hobi yang menyehatkan.","zh":"舞蹈是一项健康的爱好。"}]},"ders":[{"w":"dansa","ipa":"/ˈdansa/","zh":"跳舞","phrase":{"t":"dansa malam","zh":"晚会舞"},"example":{"t":"Dia pandai dansa.","zh":"他很擅长跳舞。"}},{"w":"berdansa","ipa":"/bərˈdansa/","zh":"进行跳舞活动","phrase":{"t":"berdansa bersama","zh":"一起跳舞"},"example":{"t":"Pasangan itu sedang berdansa dengan romantis.","zh":"那对伴侣正在浪漫地跳舞。"}},{"w":"mendansakan","ipa":"/mənˈdansakan/","zh":"使……跳舞；表演某种舞蹈","phrase":{"t":"mendansakan lagu","zh":"伴随歌曲跳舞"},"example":{"t":"Dia mendansakan tarian tradisional itu dengan anggun.","zh":"她优雅地表演了那段传统舞蹈。"}},{"w":"penari","ipa":"/pəˈnari/","zh":"舞者","phrase":{"t":"penari profesional","zh":"专业舞者"},"example":{"t":"Penari itu sangat lincah.","zh":"那位舞者非常灵巧。"}}],"derSlugs":["dansa","berdansa","mendansakan","penari"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:00:20.448Z","src":"base"}