{"root":"tengok","ipa":"/təŋɔk/","core":"看，瞧，观察（口语化表达，常用于马来语或印尼语方言，在标准印尼语中对应 melihat）","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/təŋɔk/","zh":"看，瞧","phrases":[{"t":"tengok saja","zh":"只是看看"},{"t":"tengok-tengok","zh":"随便看看，浏览"},{"t":"coba tengok","zh":"试着看看"}],"examples":[{"t":"Tengoklah apa yang terjadi di sana.","zh":"去看看那里发生了什么。"},{"t":"Saya hanya ingin tengok sebentar.","zh":"我只是想看一眼。"}]},"ders":[{"w":"tengok","ipa":"/təŋɔk/","zh":"看","phrase":{"t":"tengok kiri kanan","zh":"左右张望"},"example":{"t":"Tengok ke sini.","zh":"往这边看。"}},{"w":"menengok","ipa":"/mənəŋɔk/","zh":"探望，看望","phrase":{"t":"menengok orang sakit","zh":"探望病人"},"example":{"t":"Dia pergi menengok neneknya di desa.","zh":"他去乡下探望他的祖母。"}},{"w":"menengokkan","ipa":"/mənəŋɔkkan/","zh":"使……看，展示给……看","phrase":{"t":"menengokkan hasil","zh":"展示成果"},"example":{"t":"Dia menengokkan lukisannya kepada kami.","zh":"他把他的画展示给我们看。"}},{"w":"tertengok","ipa":"/tərtəŋɔk/","zh":"无意中看到，瞥见","phrase":{"t":"tak sengaja tertengok","zh":"不小心瞥见"},"example":{"t":"Saya tertengok dompetnya di atas meja.","zh":"我无意中瞥见桌上的钱包。"}}],"derSlugs":["tengok","menengok","menengokkan","tertengok"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T08:35:59.839Z","src":"base"}