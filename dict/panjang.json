{"root":"panjang","ipa":"/paɲdʒaŋ/","core":"指物体在空间上的延伸程度，即长度；也可引申为时间上的长久或话语的冗长。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/paɲdʒaŋ/","zh":"长的，长度","phrases":[{"t":"panjang lebar","zh":"详尽地，长篇大论"},{"t":"panjang umur","zh":"长寿"},{"t":"panjang akal","zh":"深谋远虑"}],"examples":[{"t":"Jalan itu sangat panjang.","zh":"那条路非常长。"},{"t":"Dia bercerita panjang lebar tentang pengalamannya.","zh":"他详尽地讲述了他的经历。"}]},"ders":[{"w":"panjang","ipa":"/paɲdʒaŋ/","zh":"长的","phrase":{"t":"tali panjang","zh":"长绳"},"example":{"t":"Rambutnya panjang sekali.","zh":"她的头发非常长。"}},{"w":"sepanjang","ipa":"/səpaɲdʒaŋ/","zh":"整个，沿着","phrase":{"t":"sepanjang hari","zh":"整天"},"example":{"t":"Dia menangis sepanjang malam.","zh":"他整晚都在哭。"}},{"w":"panjangnya","ipa":"/paɲdʒaŋɲa/","zh":"其长度","phrase":{"t":"panjangnya meja","zh":"桌子的长度"},"example":{"t":"Panjangnya mencapai dua meter.","zh":"它的长度达到了两米。"}},{"w":"memanjangkan","ipa":"/məmaɲdʒaŋkan/","zh":"延长，加长","phrase":{"t":"memanjangkan durasi","zh":"延长时长"},"example":{"t":"Pemerintah memanjangkan masa berlaku paspor.","zh":"政府延长了护照的有效期。"}},{"w":"perpanjangan","ipa":"/pərpaɲdʒaŋan/","zh":"延长，延期","phrase":{"t":"perpanjangan kontrak","zh":"合同延期"},"example":{"t":"Dia mengajukan perpanjangan visa.","zh":"他申请了签证延期。"}}],"derSlugs":["panjang","sepanjang","panjangnya","memanjangkan","perpanjangan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:39:04.015Z","src":"base"}