{"root":"dosa","ipa":"/ˈdosa/","core":"指违背宗教、道德或法律准则的行为，即罪、罪恶或过失。","pos":["名词"],"scenes":["高频","教会","生活"],"rootBlock":{"ipa":"/ˈdosa/","zh":"罪，罪恶","phrases":[{"t":"berbuat dosa","zh":"犯罪"},{"t":"pengampunan dosa","zh":"赦罪"},{"t":"dosa besar","zh":"大罪"}],"examples":[{"t":"Setiap orang pernah berbuat dosa dalam hidupnya.","zh":"每个人在生活中都曾犯过罪。"},{"t":"Dia memohon ampun atas segala dosanya.","zh":"他为自己所有的罪行祈求宽恕。"}]},"ders":[{"w":"dosa","ipa":"/ˈdosa/","zh":"罪，罪恶","phrase":{"t":"dosa turunan","zh":"原罪"},"example":{"t":"Janganlah kamu hidup dalam dosa.","zh":"不要活在罪中。"}},{"w":"berdosa","ipa":"/bərˈdosa/","zh":"有罪的，犯罪的","phrase":{"t":"manusia berdosa","zh":"有罪的人类"},"example":{"t":"Kita semua adalah manusia yang berdosa.","zh":"我们都是有罪的人。"}},{"w":"mendosakan","ipa":"/məndosaˈkan/","zh":"使……成为罪，定罪","phrase":{"t":"mendosakan orang lain","zh":"定他人的罪"},"example":{"t":"Janganlah kamu cepat-cepat mendosakan sesamamu.","zh":"不要轻易给你的邻舍定罪。"}}],"derSlugs":["dosa","berdosa","mendosakan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:02:33.792Z","src":"base"}