{"root":"lama","ipa":"/ˈlama/","core":"形容词：长久的，很久的；名词：旧时，过去。","pos":["形容词","名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈlama/","zh":"长久的，很久的","phrases":[{"t":"sudah lama","zh":"已经很久了"},{"t":"lama sekali","zh":"非常久"},{"t":"untuk waktu yang lama","zh":"很长一段时间"}],"examples":[{"t":"Saya sudah lama tinggal di sini.","zh":"我住在这里已经很久了。"},{"t":"Menunggu bus itu sangat lama.","zh":"等那辆公交车等了很久。"}]},"ders":[{"w":"lama","ipa":"/ˈlama/","zh":"长久的","phrase":{"t":"teman lama","zh":"老朋友"},"example":{"t":"Dia adalah teman lama saya.","zh":"他是我的老朋友。"}},{"w":"selama","ipa":"/səˈlama/","zh":"在...期间","phrase":{"t":"selama ini","zh":"在此期间"},"example":{"t":"Selama liburan, saya pergi ke Bali.","zh":"假期期间，我去了巴厘岛。"}},{"w":"kelamaan","ipa":"/kəlaˈmaan/","zh":"太久了","phrase":{"t":"jangan kelamaan","zh":"不要太久"},"example":{"t":"Jangan kelamaan di bawah matahari.","zh":"不要在太阳下待太久。"}},{"w":"melamakan","ipa":"/məlaˈmakan/","zh":"延长，拖延","phrase":{"t":"melamakan waktu","zh":"拖延时间"},"example":{"t":"Dia sengaja melamakan proses itu.","zh":"他故意拖延那个过程。"}},{"w":"terlama","ipa":"/tərˈlama/","zh":"最久的","phrase":{"t":"rekor terlama","zh":"最长纪录"},"example":{"t":"Ini adalah perjalanan terlama saya.","zh":"这是我最长的一次旅行。"}}],"derSlugs":["lama","selama","kelamaan","melamakan","terlama"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:18:49.891Z","src":"base"}