{"root":"risau","ipa":"/ri.sau/","core":"形容词，指内心感到不安、忧虑、担心或焦虑。","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ri.sau/","zh":"忧虑的，不安的，担心的。","phrases":[{"t":"merasa risau","zh":"感到忧虑"},{"t":"hati risau","zh":"内心不安"},{"t":"jangan risau","zh":"别担心"}],"examples":[{"t":"Dia merasa risau memikirkan masa depannya.","zh":"他因为思考自己的未来而感到忧虑。"},{"t":"Jangan risau, semuanya akan baik-baik saja.","zh":"别担心，一切都会好起来的。"}]},"ders":[{"w":"risau","ipa":"/ri.sau/","zh":"忧虑的","phrase":{"t":"risau akan sesuatu","zh":"为某事担忧"},"example":{"t":"Ibu risau akan kesehatan anaknya.","zh":"母亲为孩子的健康感到忧虑。"}},{"w":"merisaukan","ipa":"/mə.ri.sau.kan/","zh":"使人忧虑，为...感到担忧","phrase":{"t":"hal yang merisaukan","zh":"令人担忧的事情"},"example":{"t":"Kondisi ekonomi saat ini sangat merisaukan masyarakat.","zh":"当前的经济状况让民众感到非常担忧。"}},{"w":"kerisauan","ipa":"/kə.ri.sau.an/","zh":"忧虑，不安（名词）","phrase":{"t":"kerisauan hati","zh":"内心的不安"},"example":{"t":"Dia tidak bisa menyembunyikan kerisauannya.","zh":"他无法掩饰自己的不安。"}}],"derSlugs":["risau","merisaukan","kerisauan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-30T15:46:19.932Z","src":"base"}