{"root":"gusar","ipa":"/ɡusar/","core":"生气的，烦躁的，焦虑的","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ɡusar/","zh":"生气、烦躁或心神不定的状态","phrases":[{"t":"merasa gusar","zh":"感到烦躁"},{"t":"hati gusar","zh":"心情烦乱"},{"t":"jangan gusar","zh":"不要生气的"}],"examples":[{"t":"Dia tampak gusar mendengar berita itu.","zh":"听到那个消息时他显得很烦躁。"},{"t":"Janganlah gusar atas hal sepele seperti itu.","zh":"不要为这种琐事生闷气。"}]},"ders":[{"w":"gusar","ipa":"/ɡusar/","zh":"生气的，心神不定的","phrase":{"t":"wajah gusar","zh":"生气的面孔"},"example":{"t":"Pikirannya sedang gusar.","zh":"他现在心思烦乱。"}},{"w":"menggusari","ipa":"/mənɡusari/","zh":"对...生气，对...发怒","phrase":{"t":"menggusari anak","zh":"生孩子的气"},"example":{"t":"Ibu menggusari perbuatannya yang ceroboh.","zh":"母亲对他的粗心大意行为感到恼火。"}},{"w":"menggusarkan","ipa":"/mənɡusarkan/","zh":"使人烦躁，使人担忧","phrase":{"t":"menggusarkan hati","zh":"令人揪心"},"example":{"t":"Situasi ini sangat menggusarkan kami.","zh":"这种情况让我们非常担忧。"}},{"w":"kegusaran","ipa":"/kəɡusaran/","zh":"烦躁，怒气，焦虑","phrase":{"t":"menahan kegusaran","zh":"克制怒火"},"example":{"t":"Kegusarannya tidak dapat disembunyikan lagi.","zh":"他的烦躁情绪再也掩饰不住了。"}}],"derSlugs":["gusar","menggusari","menggusarkan","kegusaran"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T17:15:26.513Z","src":"base"}