{"root":"baring","ipa":"/ˈbariŋ/","core":"指身体平躺、横卧或侧卧的状态，通常用于描述人或动物的姿势。","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈbariŋ/","zh":"平躺，横卧","phrases":[{"t":"baring badan","zh":"平躺身体"},{"t":"posisi baring","zh":"平躺姿势"},{"t":"berbaring santai","zh":"悠闲地躺着"}],"examples":[{"t":"Dia sedang baring di atas sofa.","zh":"他正躺在沙发上。"},{"t":"Dokter menyarankan untuk baring sejenak.","zh":"医生建议躺一会儿。"}]},"ders":[{"w":"baring","ipa":"/ˈbariŋ/","zh":"平躺","phrase":{"t":"baring telentang","zh":"仰卧"},"example":{"t":"Jangan baring terlalu lama.","zh":"不要躺太久。"}},{"w":"berbaring","ipa":"/bərˈbariŋ/","zh":"躺着，卧着","phrase":{"t":"berbaring di tempat tidur","zh":"躺在床上"},"example":{"t":"Kucing itu suka berbaring di bawah sinar matahari.","zh":"那只猫喜欢躺在阳光下。"}},{"w":"membaringkan","ipa":"/məmˈbariŋkan/","zh":"使躺下，放下","phrase":{"t":"membaringkan bayi","zh":"把婴儿放下平躺"},"example":{"t":"Ibu membaringkan anak itu dengan perlahan.","zh":"母亲轻轻地把孩子放下平躺。"}},{"w":"terbaring","ipa":"/tərˈbariŋ/","zh":"躺着的，卧倒的","phrase":{"t":"terbaring lemah","zh":"虚弱地躺着"},"example":{"t":"Dia sudah berhari-hari terbaring sakit.","zh":"他已经卧病在床好几天了。"}},{"w":"pembaringan","ipa":"/pəmˈbariŋan/","zh":"卧处，床位","phrase":{"t":"tempat pembaringan","zh":"休息的地方"},"example":{"t":"Dia menuju ke pembaringannya untuk beristirahat.","zh":"他走向他的床位去休息。"}}],"derSlugs":["baring","berbaring","membaringkan","terbaring","pembaringan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:11:31.126Z","src":"base"}