{"root":"bengis","ipa":"/ˈbɛŋɪs/","core":"残忍的，凶狠的，冷酷无情的","pos":["形容词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈbɛŋɪs/","zh":"残忍的，凶狠的","phrases":[{"t":"sangat bengis","zh":"非常残忍"},{"t":"perilaku bengis","zh":"残暴的行为"},{"t":"hati yang bengis","zh":"铁石心肠"}],"examples":[{"t":"Penjahat itu memperlakukan sanderanya dengan sangat bengis.","zh":"那个罪犯极其残忍地对待他的人质。"},{"t":"Kami mengutuk tindakan bengis tersebut.","zh":"我们谴责这种残暴的行为。"}]},"ders":[{"w":"bengis","ipa":"/ˈbɛŋɪs/","zh":"残忍的，凶狠的","phrase":{"t":"sifat bengis","zh":"残忍的本性"},"example":{"t":"Dia dikenal karena sifatnya yang bengis.","zh":"他以残忍的性格而闻名。"}},{"w":"kebengisan","ipa":"/kəbɛŋˈisän/","zh":"残忍，暴行","phrase":{"t":"kebengisan musuh","zh":"敌人的暴行"},"example":{"t":"Dunia mengecam kebengisan perang ini.","zh":"全世界都在谴责这场战争的残暴。"}},{"w":"membengisi","ipa":"/mɛmbɛŋˈisi/","zh":"虐待，使变得残忍","phrase":{"t":"membengisi sesama","zh":"虐待同胞"},"example":{"t":"Janganlah membengisi orang yang sudah lemah.","zh":"不要虐待已经虚弱的人。"}}],"derSlugs":["bengis","kebengisan","membengisi"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T17:37:57.024Z","src":"base"}