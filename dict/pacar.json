{"root":"pacar","ipa":"/pa.tʃar/","core":"指恋人、情侣或未婚夫/妻，指代处于恋爱关系中的人。","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/pa.tʃar/","zh":"恋人，情侣","phrases":[{"t":"pacar baru","zh":"新恋人"},{"t":"mencari pacar","zh":"寻找对象"},{"t":"putus pacar","zh":"分手"}],"examples":[{"t":"Dia pergi ke bioskop bersama pacarnya.","zh":"他和他的恋人一起去电影院。"},{"t":"Sudah berapa lama kamu berpacaran dengannya?","zh":"你和他交往多久了？"}]},"ders":[{"w":"pacar","ipa":"/pa.tʃar/","zh":"恋人","phrase":{"t":"pacar gelap","zh":"情人（指不正当关系）"},"example":{"t":"Dia adalah pacar pertamaku.","zh":"他是我的初恋。"}},{"w":"berpacaran","ipa":"/bər.pa.tʃa.ran/","zh":"谈恋爱，交往","phrase":{"t":"sedang berpacaran","zh":"正在谈恋爱"},"example":{"t":"Mereka sudah berpacaran selama tiga tahun.","zh":"他们已经交往三年了。"}},{"w":"mempacari","ipa":"/məm.pa.tʃa.ri/","zh":"与某人谈恋爱，追求某人","phrase":{"t":"mempacari teman sendiri","zh":"与自己的朋友谈恋爱"},"example":{"t":"Dia mencoba mempacari gadis itu.","zh":"他试图追求那个女孩。"}},{"w":"pacaran","ipa":"/pa.tʃa.ran/","zh":"恋爱关系（口语）","phrase":{"t":"gaya pacaran","zh":"恋爱方式"},"example":{"t":"Pacaran di usia muda seringkali penuh tantangan.","zh":"年轻时的恋爱往往充满挑战。"}}],"derSlugs":["pacar","berpacaran","mempacari","pacaran"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:48:43.783Z","src":"base"}