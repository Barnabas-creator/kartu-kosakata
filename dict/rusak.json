{"root":"rusak","ipa":"/ˈrusak/","core":"损坏的，坏掉的，破损的","pos":["形容词","动词"],"scenes":["高频","生活","工作"],"rootBlock":{"ipa":"/ˈrusak/","zh":"指物体失去原有功能、完整性或处于无法正常工作的状态，也可指道德或系统的败坏。","phrases":[{"t":"rusak parah","zh":"严重损坏"},{"t":"barang rusak","zh":"损坏的物品"},{"t":"rusak total","zh":"完全报废"}],"examples":[{"t":"Komputer saya rusak kemarin.","zh":"我的电脑昨天坏了。"},{"t":"Jalan itu rusak akibat banjir.","zh":"那条路因洪水而损坏。"}]},"ders":[{"w":"rusak","ipa":"/ˈrusak/","zh":"损坏的","phrase":{"t":"mesin rusak","zh":"坏掉的机器"},"example":{"t":"Jangan pakai alat yang rusak itu.","zh":"不要使用那个坏掉的工具。"}},{"w":"merusak","ipa":"/məˈrusak/","zh":"破坏，损坏（某物）","phrase":{"t":"merusak lingkungan","zh":"破坏环境"},"example":{"t":"Tindakan itu merusak reputasinya.","zh":"那个行为破坏了他的名声。"}},{"w":"kerusakan","ipa":"/kəruˈsakan/","zh":"损坏，故障，破坏","phrase":{"t":"kerusakan teknis","zh":"技术故障"},"example":{"t":"Kerusakan pada mobil itu cukup parah.","zh":"那辆车的损坏程度相当严重。"}},{"w":"perusak","ipa":"/pəˈrusak/","zh":"破坏者","phrase":{"t":"perusak tanaman","zh":"植物破坏者（害虫）"},"example":{"t":"Polisi menangkap perusak fasilitas umum itu.","zh":"警察抓住了那个公共设施破坏者。"}},{"w":"dirusak","ipa":"/diˈrusak/","zh":"被破坏","phrase":{"t":"dirusak oleh orang","zh":"被人为破坏"},"example":{"t":"Pagar itu dirusak oleh angin kencang.","zh":"栅栏被强风吹坏了。"}}],"derSlugs":["rusak","merusak","kerusakan","perusak","dirusak"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:55:29.068Z","src":"base"}