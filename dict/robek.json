{"root":"robek","ipa":"/ro.bɛk/","core":"撕裂，扯破，撕开","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ro.bɛk/","zh":"撕裂，扯破","phrases":[{"t":"robek kertas","zh":"撕纸"},{"t":"robek baju","zh":"扯破衣服"},{"t":"robek hati","zh":"撕心裂肺"}],"examples":[{"t":"Dia robek surat itu menjadi potongan kecil.","zh":"他把那封信撕成了碎片。"},{"t":"Celananya robek karena tersangkut paku.","zh":"他的裤子因为挂在钉子上而破了。"}]},"ders":[{"w":"robek","ipa":"/ro.bɛk/","zh":"撕裂","phrase":{"t":"robek kain","zh":"撕布"},"example":{"t":"Jangan robek dokumen penting ini.","zh":"不要撕毁这份重要文件。"}},{"w":"merobek","ipa":"/mə.ro.bɛk/","zh":"撕开，扯破（及物动词）","phrase":{"t":"merobek amplop","zh":"撕开信封"},"example":{"t":"Dia merobek bungkusan kado itu dengan cepat.","zh":"他迅速地撕开了那个礼物包装。"}},{"w":"merobek-robek","ipa":"/mə.ro.bɛk.ro.bɛk/","zh":"反复撕碎，撕得粉碎","phrase":{"t":"merobek-robek foto","zh":"把照片撕得粉碎"},"example":{"t":"Anjing itu merobek-robek bantal sofa.","zh":"那只狗把沙发垫撕得稀烂。"}},{"w":"robekan","ipa":"/ro.bɛ.kan/","zh":"撕裂处，碎片","phrase":{"t":"robekan kertas","zh":"纸屑"},"example":{"t":"Ada robekan pada bagian lengan baju itu.","zh":"那件衣服的袖子处有一个破洞。"}},{"w":"terobek","ipa":"/tə.ro.bɛk/","zh":"被撕破的，意外撕裂的","phrase":{"t":"baju terobek","zh":"被撕破的衣服"},"example":{"t":"Kertas itu terobek secara tidak sengaja.","zh":"那张纸不小心被撕破了。"}}],"derSlugs":["robek","merobek","merobek-robek","robekan","terobek"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-27T16:35:14.849Z","src":"base"}