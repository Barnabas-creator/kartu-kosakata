{"root":"dukacita","ipa":"/dukatʃita/","core":"悲伤，哀悼，慰问","pos":["名词"],"scenes":["高频","生活","教会"],"rootBlock":{"ipa":"/dukatʃita/","zh":"悲伤，哀悼，令人悲伤的事情","phrases":[{"t":"mengucapkan dukacita","zh":"表达哀悼"},{"t":"kartu dukacita","zh":"吊唁卡"},{"t":"berita dukacita","zh":"讣告"}],"examples":[{"t":"Kami menyampaikan rasa dukacita yang mendalam atas kepergiannya.","zh":"对于他的离去，我们表达深切的哀悼。"},{"t":"Keluarga korban menerima banyak ucapan dukacita.","zh":"受害者家属收到了许多吊唁。"}]},"ders":[{"w":"dukacita","ipa":"/dukatʃita/","zh":"悲伤，哀悼","phrase":{"t":"rasa dukacita","zh":"悲伤之情"},"example":{"t":"Dukacita melanda keluarga tersebut.","zh":"悲伤笼罩着那个家庭。"}},{"w":"berdukacita","ipa":"/bərdukatʃita/","zh":"服丧，哀悼，悲痛","phrase":{"t":"sedang berdukacita","zh":"正在服丧"},"example":{"t":"Seluruh warga desa berdukacita atas bencana itu.","zh":"全村居民为那场灾难感到悲痛。"}},{"w":"mendukacitakan","ipa":"/məndukatʃitakan/","zh":"使悲伤，令人痛心","phrase":{"t":"hal yang mendukacitakan","zh":"令人痛心的事情"},"example":{"t":"Peristiwa itu sangat mendukacitakan hati kami.","zh":"那起事件让我们感到十分痛心。"}},{"w":"kedukacitaan","ipa":"/kədukatʃitaan/","zh":"悲哀状态，悲痛","phrase":{"t":"dalam kedukacitaan","zh":"处于悲痛之中"},"example":{"t":"Mereka dihibur dalam kedukacitaan mereka.","zh":"他们在悲痛中得到了安慰。"}}],"derSlugs":["dukacita","berdukacita","mendukacitakan","kedukacitaan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T16:49:03.250Z","src":"base"}