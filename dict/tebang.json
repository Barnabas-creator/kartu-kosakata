{"root":"tebang","ipa":"/təbaŋ/","core":"砍伐，伐木","pos":["动词"],"scenes":["生活","工作"],"rootBlock":{"ipa":"/təbaŋ/","zh":"砍伐，砍倒（树木）","phrases":[{"t":"tebang pohon","zh":"砍树"},{"t":"tebang habis","zh":"砍伐殆尽"},{"t":"sistem tebang pilih","zh":"择伐制度"}],"examples":[{"t":"Mereka harus menebang pohon yang sudah tua itu.","zh":"他们必须砍掉那棵老树。"},{"t":"Penebangan liar merusak ekosistem hutan.","zh":"非法砍伐破坏了森林生态系统。"}]},"ders":[{"w":"menebang","ipa":"/mənəbaŋ/","zh":"砍伐（动作）","phrase":{"t":"menebang kayu","zh":"伐木"},"example":{"t":"Ayah sedang menebang pohon di belakang rumah.","zh":"父亲正在屋后砍树。"}},{"w":"penebang","ipa":"/pənəbaŋ/","zh":"伐木工","phrase":{"t":"penebang kayu","zh":"伐木工人"},"example":{"t":"Penebang itu bekerja di hutan Kalimantan.","zh":"那位伐木工在加里曼丹的森林里工作。"}},{"w":"penebangan","ipa":"/pənəbaŋan/","zh":"砍伐（过程或行为）","phrase":{"t":"penebangan hutan","zh":"森林砍伐"},"example":{"t":"Penebangan hutan secara besar-besaran dilarang.","zh":"大规模的森林砍伐是被禁止的。"}},{"w":"tebangan","ipa":"/təbaŋan/","zh":"被砍伐的树木；砍伐区","phrase":{"t":"area tebangan","zh":"伐木区"},"example":{"t":"Kayu-kayu tebangan itu akan segera diangkut.","zh":"那些被砍伐的木材很快就会被运走。"}}],"derSlugs":["tebang","menebang","penebang","penebangan","tebangan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-10-01T02:12:17.664Z","src":"base"}