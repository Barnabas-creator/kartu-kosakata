{"root":"aju","ipa":"/a.dʒu/","core":"指提出、建议或呈交某事，通常用于正式场合或法律程序中。","pos":["动词"],"scenes":["工作","高频"],"rootBlock":{"ipa":"/a.dʒu/","zh":"提出，呈交，建议","phrases":[{"t":"aju pendapat","zh":"提出意见"},{"t":"aju usul","zh":"提出建议"},{"t":"aju permohonan","zh":"提交申请"}],"examples":[{"t":"Dia aju keberatan atas keputusan itu.","zh":"他针对那个决定提出了异议。"},{"t":"Kita perlu aju proposal ini segera.","zh":"我们需要尽快提交这份提案。"}]},"ders":[{"w":"aju","ipa":"/a.dʒu/","zh":"提出，呈交","phrase":{"t":"aju bukti","zh":"提交证据"},"example":{"t":"Saksi aju bukti baru di pengadilan.","zh":"证人在法庭上提交了新证据。"}},{"w":"mengajukan","ipa":"/mə.ŋa.dʒu.kan/","zh":"提出，呈交（及物动词）","phrase":{"t":"mengajukan pertanyaan","zh":"提出问题"},"example":{"t":"Dia mengajukan surat pengunduran diri.","zh":"他提交了辞职信。"}},{"w":"pengajuan","ipa":"/pə.ŋa.dʒu.an/","zh":"提交，申请，呈交（名词）","phrase":{"t":"proses pengajuan","zh":"申请流程"},"example":{"t":"Pengajuan dana itu telah disetujui.","zh":"那笔资金的申请已经获批。"}},{"w":"teraju","ipa":"/tə.ra.dʒu/","zh":"被提出的，被呈交的","phrase":{"t":"usul teraju","zh":"被提出的建议"},"example":{"t":"Masalah yang teraju dalam rapat itu sangat penting.","zh":"会议中被提出的问题非常重要。"}}],"derSlugs":["aju","mengajukan","pengajuan","teraju"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:13:23.805Z","src":"base"}