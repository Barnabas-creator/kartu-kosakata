{"root":"ubah","ipa":"/ˈubah/","core":"改变，更改，变更，变换","pos":["动词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/ˈubah/","zh":"改变，更改，变更，变换","phrases":[{"t":"ubah haluan","zh":"改变航向"},{"t":"ubah pikiran","zh":"改变主意"},{"t":"ubah nasib","zh":"改变命运"}],"examples":[{"t":"Dia ingin mengubah gaya hidupnya.","zh":"他想要改变他的生活方式。"},{"t":"Situasi ini sulit untuk diubah.","zh":"这种情况很难改变。"}]},"ders":[{"w":"ubah","ipa":"/ˈubah/","zh":"改变","phrase":{"t":"ubah posisi","zh":"改变位置"},"example":{"t":"Tolong ubah jadwal pertemuan kita.","zh":"请更改我们的会议时间。"}},{"w":"mengubah","ipa":"/məˈŋubah/","zh":"使改变，修改","phrase":{"t":"mengubah keputusan","zh":"修改决定"},"example":{"t":"Pemerintah sedang mengubah peraturan itu.","zh":"政府正在修改那项法规。"}},{"w":"perubahan","ipa":"/pəruˈbahan/","zh":"变化，变革","phrase":{"t":"perubahan iklim","zh":"气候变化"},"example":{"t":"Ada banyak perubahan dalam hidupnya.","zh":"他的生活中有很多变化。"}},{"w":"pengubah","ipa":"/pəŋuˈbah/","zh":"改变者，转换器","phrase":{"t":"pengubah arus","zh":"变流器"},"example":{"t":"Dia adalah pengubah sejarah bangsa ini.","zh":"他是这个国家历史的改变者。"}},{"w":"berubah","ipa":"/bəˈrubah/","zh":"变化，改变（不及物）","phrase":{"t":"berubah pikiran","zh":"改变想法"},"example":{"t":"Cuaca cepat sekali berubah.","zh":"天气变化得很快。"}},{"w":"terubah","ipa":"/təˈrubah/","zh":"可改变的，被改变了的","phrase":{"t":"tidak terubah","zh":"不可改变的"},"example":{"t":"Keadaan itu sudah terubah sepenuhnya.","zh":"那种情况已经被完全改变了。"}}],"derSlugs":["ubah","mengubah","perubahan","pengubah","berubah","terubah"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:29:22.379Z","src":"base"}