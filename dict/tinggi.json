{"root":"tinggi","ipa":"/ˈtiŋɡi/","core":"形容词：高的，高度的；名词：高度，海拔。","pos":["形容词","名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈtiŋɡi/","zh":"指物体从底部到顶部的距离，或指地位、程度、价格等处于较高水平。","phrases":[{"t":"tinggi sekali","zh":"非常高"},{"t":"harga tinggi","zh":"高价"},{"t":"gedung tinggi","zh":"高楼"}],"examples":[{"t":"Gunung itu sangat tinggi.","zh":"那座山非常高。"},{"t":"Dia memiliki cita-cita yang tinggi.","zh":"他有远大的志向。"}]},"ders":[{"w":"tinggi","ipa":"/ˈtiŋɡi/","zh":"高的","phrase":{"t":"tinggi badan","zh":"身高"},"example":{"t":"Berapa tinggi badanmu?","zh":"你的身高是多少？"}},{"w":"ketinggian","ipa":"/kətiŋɡian/","zh":"高度；过高","phrase":{"t":"ketinggian tempat","zh":"海拔高度"},"example":{"t":"Dia takut akan ketinggian.","zh":"他有恐高症。"}},{"w":"meninggikan","ipa":"/məniŋɡikan/","zh":"使升高；抬高","phrase":{"t":"meninggikan suara","zh":"提高嗓门"},"example":{"t":"Mereka sedang meninggikan pagar rumah.","zh":"他们正在加高房子的围墙。"}},{"w":"setinggi","ipa":"/sətiŋɡi/","zh":"一样高；高达","phrase":{"t":"setinggi langit","zh":"高耸入云"},"example":{"t":"Air banjir itu setinggi lutut.","zh":"洪水的高度没过膝盖。"}},{"w":"tertinggi","ipa":"/tərtiŋɡi/","zh":"最高的","phrase":{"t":"puncak tertinggi","zh":"最高峰"},"example":{"t":"Dia adalah siswa tertinggi di kelas.","zh":"他是班里最高的学生。"}}],"derSlugs":["tinggi","ketinggian","meninggikan","setinggi","tertinggi"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:44:09.384Z","src":"base"}