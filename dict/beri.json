{"root":"beri","ipa":"/bəri/","core":"给予、提供、赠送，指将某物交给某人或提供某种抽象的事物。","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/bəri/","zh":"给予","phrases":[{"t":"beri tahu","zh":"告知"},{"t":"beri makan","zh":"喂食"},{"t":"beri izin","zh":"准许"}],"examples":[{"t":"Dia memberi saya sebuah buku.","zh":"他给了我一本书。"},{"t":"Tolong beri saya waktu sebentar.","zh":"请给我一点时间。"}]},"ders":[{"w":"beri","ipa":"/bəri/","zh":"给予","phrase":{"t":"beri jalan","zh":"让路"},"example":{"t":"Beri dia kesempatan.","zh":"给他一个机会。"}},{"w":"memberi","ipa":"/məmbəri/","zh":"给予（主动语态）","phrase":{"t":"memberi bantuan","zh":"提供援助"},"example":{"t":"Ibu sedang memberi makan kucing.","zh":"妈妈正在喂猫。"}},{"w":"memberikan","ipa":"/məmbərikan/","zh":"把（某物）给予某人","phrase":{"t":"memberikan hadiah","zh":"赠送礼物"},"example":{"t":"Dia memberikan kunci itu kepada saya.","zh":"他把那把钥匙交给了我。"}},{"w":"pemberi","ipa":"/pəmbəri/","zh":"给予者","phrase":{"t":"pemberi kerja","zh":"雇主"},"example":{"t":"Tangan di atas lebih baik daripada tangan pemberi.","zh":"给予者比接受者更有福。"}},{"w":"pemberian","ipa":"/pəmbərian/","zh":"赠品、给予的行为","phrase":{"t":"pemberian Tuhan","zh":"上帝的恩赐"},"example":{"t":"Ini adalah pemberian dari sahabat saya.","zh":"这是我朋友送的礼物。"}},{"w":"diberi","ipa":"/dibəri/","zh":"被给予","phrase":{"t":"diberi tahu","zh":"被告知"},"example":{"t":"Dia diberi penghargaan atas prestasinya.","zh":"他因其成就而获得奖励。"}}],"derSlugs":["beri","memberi","memberikan","pemberi","pemberian","diberi"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:19:40.431Z","src":"base"}