{"root":"cadang","ipa":"/tʃadaŋ/","core":"意为提议、建议、储备或计划，常用于正式场合提出方案或指代预留的资源。","pos":["动词"],"scenes":["工作","高频"],"rootBlock":{"ipa":"/tʃadaŋ/","zh":"提议、建议；储备","phrases":[{"t":"cadang untuk","zh":"提议做某事"},{"t":"cadang awal","zh":"初步建议"},{"t":"cadang simpan","zh":"预留储备"}],"examples":[{"t":"Dia cadang untuk mengadakan rapat besok.","zh":"他提议明天召开会议。"},{"t":"Kami sudah cadang dana untuk proyek ini.","zh":"我们已经为该项目预留了资金。"}]},"ders":[{"w":"cadang","ipa":"/tʃadaŋ/","zh":"提议、储备","phrase":{"t":"cadang ide","zh":"提出想法"},"example":{"t":"Apa yang kamu cadang?","zh":"你有什么建议？"}},{"w":"cadangan","ipa":"/tʃadaŋan/","zh":"建议、储备金、备用","phrase":{"t":"dana cadangan","zh":"储备金"},"example":{"t":"Terima kasih atas cadangan Anda.","zh":"感谢您的建议。"}},{"w":"mencadangkan","ipa":"/mɛntʃadaŋkan/","zh":"提议、推荐、预留","phrase":{"t":"mencadangkan solusi","zh":"提出解决方案"},"example":{"t":"Dia mencadangkan nama saya untuk posisi itu.","zh":"他推荐我担任那个职位。"}},{"w":"pencadangan","ipa":"/pəntʃadaŋan/","zh":"提议过程、预留行为","phrase":{"t":"proses pencadangan","zh":"预留过程"},"example":{"t":"Pencadangan dana dilakukan secara transparan.","zh":"资金的预留是以透明的方式进行的。"}}],"derSlugs":["cadang","cadangan","mencadangkan","pencadangan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-27T16:28:51.197Z","src":"base"}