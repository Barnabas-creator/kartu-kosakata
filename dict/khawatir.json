{"root":"khawatir","ipa":"/xa.wa.tɪr/","core":"担心、忧虑；指对某事可能发生的不利结果感到不安或挂念。","pos":["形容词","动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/xa.wa.tɪr/","zh":"担心、忧虑","phrases":[{"t":"sangat khawatir","zh":"非常担心"},{"t":"khawatir akan","zh":"担心关于..."},{"t":"jangan khawatir","zh":"别担心"}],"examples":[{"t":"Saya khawatir dia tidak datang tepat waktu.","zh":"我担心他不能准时到达。"},{"t":"Ibu khawatir akan kesehatan anaknya.","zh":"母亲担心她孩子的健康。"}]},"ders":[{"w":"khawatir","ipa":"/xa.wa.tɪr/","zh":"担心","phrase":{"t":"merasa khawatir","zh":"感到担心"},"example":{"t":"Dia khawatir tentang masa depannya.","zh":"他为自己的未来感到担忧。"}},{"w":"dikhawatirkan","ipa":"/di.xa.wa.ti.rkan/","zh":"被担心；令人担忧的","phrase":{"t":"hal yang dikhawatirkan","zh":"令人担忧的事情"},"example":{"t":"Kondisi ekonomi saat ini sangat dikhawatirkan.","zh":"目前的经济状况非常令人担忧。"}},{"w":"kekhawatiran","ipa":"/kə.xa.wa.ti.ran/","zh":"忧虑、担心（名词）","phrase":{"t":"menghilangkan kekhawatiran","zh":"消除忧虑"},"example":{"t":"Dia mengungkapkan kekhawatirannya kepada saya.","zh":"他向我表达了他的忧虑。"}},{"w":"mengkhawatirkan","ipa":"/mə.ŋxa.wa.ti.rkan/","zh":"使人担心；担忧（及物动词）","phrase":{"t":"situasi yang mengkhawatirkan","zh":"令人担忧的局势"},"example":{"t":"Berita itu sangat mengkhawatirkan kami.","zh":"那个消息让我们非常担心。"}}],"derSlugs":["khawatir","dikhawatirkan","kekhawatiran","mengkhawatirkan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:34:00.087Z","src":"base"}