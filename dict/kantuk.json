{"root":"kantuk","ipa":"/ˈkantʊk/","core":"困意，睡意","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈkantʊk/","zh":"困意，睡意","phrases":[{"t":"rasa kantuk","zh":"困倦的感觉"},{"t":"menahan kantuk","zh":"强打精神，忍住困意"},{"t":"mengusir kantuk","zh":"驱赶困意"}],"examples":[{"t":"Rasa kantuk menyerangnya setelah makan siang.","zh":"午饭后睡意向他袭来。"},{"t":"Dia minum kopi untuk menghilangkan rasa kantuk.","zh":"他喝咖啡来消除困意。"}]},"ders":[{"w":"kantuk","ipa":"/ˈkantʊk/","zh":"困意，睡意","phrase":{"t":"serangan kantuk","zh":"困意袭来"},"example":{"t":"Kantuk yang hebat membuat matanya sulit terbuka.","zh":"极度困意使他的眼睛很难睁开。"}},{"w":"mengantuk","ipa":"/məˈnantʊk/","zh":"犯困，打瞌睡","phrase":{"t":"mulai mengantuk","zh":"开始犯困"},"example":{"t":"Anak itu mulai mengantuk di atas sofa.","zh":"那孩子在沙发上开始犯困了。"}},{"w":"mengantukkan","ipa":"/məˈnantʊkan/","zh":"使碰撞，使相撞","phrase":{"t":"mengantukkan kepala","zh":"碰撞头部"},"example":{"t":"Jangan mengantukkan kepala ke dinding.","zh":"不要把头撞到墙上。"}},{"w":"terkantuk","ipa":"/tərˈkantʊk/","zh":"打盹，瞌睡（不自主地）","phrase":{"t":"kepala terkantuk","zh":"头部因打瞌睡而垂下"},"example":{"t":"Kepalanya terkantuk-kantuk selama rapat.","zh":"开会期间他的头直打瞌睡下垂。"}},{"w":"pengantuk","ipa":"/pəˈnantʊk/","zh":"爱打瞌睡的人，瞌睡虫","phrase":{"t":"si pengantuk","zh":"这个爱打瞌睡的人"},"example":{"t":"Dia terkenal sebagai seorang pengantuk di kelas.","zh":"他以在课堂上爱打瞌睡而闻名。"}},{"w":"mengantuk-ngantukan","ipa":"/məˌnantʊkˈnantʊkan/","zh":"昏昏欲睡，半睡半醒","phrase":{"t":"duduk mengantuk-ngantukan","zh":"昏昏欲睡地坐着"},"example":{"t":"Mereka duduk mengantuk-ngantukan di ruang tunggu.","zh":"他们昏昏欲睡地坐在候车室里。"}}],"derSlugs":["kantuk","mengantuk","mengantukkan","terkantuk","pengantuk","mengantuk-ngantukan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T17:36:27.846Z","src":"base"}