{"root":"anggap","ipa":"/aŋɡap/","core":"认为，以为，视作","pos":["动词"],"scenes":["高频","工作"],"rootBlock":{"ipa":"/aŋɡap/","zh":"认为；以为；视作；假定","phrases":[{"t":"menganggap enteng","zh":"轻视，掉以轻心"},{"t":"dianggap sebagai","zh":"被视为"},{"t":"menganggap perlu","zh":"认为有必要"}],"examples":[{"t":"Saya menganggap dia sebagai teman baik.","zh":"我把他当作好朋友。"},{"t":"Jangan menganggap masalah ini mudah.","zh":"不要认为这个问题很简单。"}]},"ders":[{"w":"menganggap","ipa":"/məŋaŋɡap/","zh":"认为，视作","phrase":{"t":"menganggap benar","zh":"认为正确"},"example":{"t":"Mereka menganggap usul itu sangat bagus.","zh":"他们认为那个建议非常好。"}},{"w":"dianggap","ipa":"/diaŋɡap/","zh":"被认为，被视为","phrase":{"t":"dianggap sah","zh":"被视为合法"},"example":{"t":"Keputusan itu dianggap tidak adil.","zh":"那个决定被认为是不公平的。"}},{"w":"anggapan","ipa":"/aŋɡapan/","zh":"看法，观点，假设","phrase":{"t":"anggapan umum","zh":"普遍看法"},"example":{"t":"Itu hanyalah anggapan belaka.","zh":"那仅仅是一个假设而已。"}},{"w":"menganggap-anggap","ipa":"/məŋaŋɡap-aŋɡap/","zh":"反复认为，臆测","phrase":{"t":"menganggap-anggap sesuatu","zh":"臆测某事"},"example":{"t":"Dia selalu menganggap-anggap hal yang belum pasti.","zh":"他总是臆测那些还不确定的事情。"}}],"derSlugs":["anggap","menganggap","dianggap","anggapan","menganggap-anggap"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:52:11.918Z","src":"base"}