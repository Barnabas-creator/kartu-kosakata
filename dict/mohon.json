{"root":"mohon","ipa":"/mohon/","core":"请求、恳求、祈求，通常用于正式场合或表示礼貌的请求。","pos":["动词"],"scenes":["高频","工作"],"rootBlock":{"ipa":"/mohon/","zh":"请求、恳求","phrases":[{"t":"mohon maaf","zh":"请求原谅"},{"t":"mohon bantuan","zh":"请求帮助"},{"t":"mohon izin","zh":"请求许可"}],"examples":[{"t":"Saya mohon maaf atas kesalahan ini.","zh":"我为这个错误请求原谅。"},{"t":"Mohon perhatiannya sebentar.","zh":"请大家注意一下。"}]},"ders":[{"w":"mohon","ipa":"/mohon/","zh":"请求","phrase":{"t":"mohon diri","zh":"告辞"},"example":{"t":"Kami mohon diri dulu.","zh":"我们先告辞了。"}},{"w":"permohonan","ipa":"/pərmohonan/","zh":"申请、请求（名词）","phrase":{"t":"permohonan maaf","zh":"道歉信/道歉请求"},"example":{"t":"Permohonan Anda sedang diproses.","zh":"您的申请正在处理中。"}},{"w":"memohon","ipa":"/memohon/","zh":"恳求、请求（动词）","phrase":{"t":"memohon doa restu","zh":"祈求祝福"},"example":{"t":"Dia memohon agar diberikan kesempatan kedua.","zh":"他恳求能被给予第二次机会。"}}],"derSlugs":["mohon","permohonan","memohon"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:33:13.207Z","src":"base"}