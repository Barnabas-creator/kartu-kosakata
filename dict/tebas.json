{"root":"tebas","ipa":"/ˈtɛ.bas/","core":"砍，砍伐，劈","pos":["动词"],"scenes":["生活","高频"],"rootBlock":{"ipa":"/ˈtɛ.bas/","zh":"砍伐，猛砍，劈开","phrases":[{"t":"tebas pohon","zh":"砍树"},{"t":"menebas rumput","zh":"除草"},{"t":"tebas harga","zh":"大降价，大减价"}],"examples":[{"t":"Dia menebas dahan kayu yang menghalangi jalan.","zh":"他砍掉了挡路的树枝。"},{"t":"Petani itu menebas rumput liar di ladangnya.","zh":"那个农民砍掉了田里的杂草。"}]},"ders":[{"w":"tebas","ipa":"/ˈtɛ.bas/","zh":"砍，伐","phrase":{"t":"tebas tebang","zh":"乱砍滥伐"},"example":{"t":"Jangan tebas tanaman itu sembarangan.","zh":"不要随便砍伐那些植物。"}},{"w":"menebas","ipa":"/məˈnɛ.bas/","zh":"砍伐，割除","phrase":{"t":"menebas hutan","zh":"砍伐森林"},"example":{"t":"Mereka menebas semak belukar di belakang rumah.","zh":"他们砍掉了屋后的灌木丛。"}},{"w":"tebasan","ipa":"/təˈba.san/","zh":"砍伐的痕迹，砍伐物","phrase":{"t":"hasil tebasan","zh":"砍伐所得"},"example":{"t":"Kayu tebasan itu dikumpulkan di sudut halaman.","zh":"砍下来的木头被收集在院子的角落里。"}},{"w":"penebas","ipa":"/pəˈnɛ.bas/","zh":"砍伐者，收购商","phrase":{"t":"penebas buah","zh":"水果买断收购商"},"example":{"t":"Penebas itu membeli seluruh hasil panen mangga.","zh":"那个收购商买下了所有的芒果收成。"}},{"w":"penebasan","ipa":"/pə.nɛˈba.san/","zh":"砍伐行为，收购","phrase":{"t":"penebasan hutan","zh":"森林砍伐行为"},"example":{"t":"Penebasan liar harus segera dihentikan.","zh":"非法砍伐必须立即制止。"}}],"derSlugs":["tebas","menebas","tebasan","penebas","penebasan"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-26T17:35:17.557Z","src":"base"}