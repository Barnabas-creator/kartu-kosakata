{"root":"sambut","ipa":"/sam.but/","core":"迎接，接待，响应","pos":["动词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/sam.but/","zh":"迎接；接住；响应；采纳","phrases":[{"t":"sambut hangat","zh":"热烈欢迎"},{"t":"sambut baik","zh":"欢迎，赞同"},{"t":"sambut tantangan","zh":"迎接挑战"}],"examples":[{"t":"Kami menyambut kedatangan tamu dari luar negeri.","zh":"我们迎接了来自国外的客人。"},{"t":"Pemerintah menyambut baik usulan tersebut.","zh":"政府对该提议表示欢迎。"}]},"ders":[{"w":"sambut","ipa":"/sam.but/","zh":"迎接；接住","phrase":{"t":"sambut bola","zh":"接球"},"example":{"t":"Dia sambut bola itu dengan sigap.","zh":"他敏捷地接住了那个球。"}},{"w":"menyambut","ipa":"/mə.ɲam.but/","zh":"迎接；庆祝；响应","phrase":{"t":"menyambut hari raya","zh":"庆祝节日"},"example":{"t":"Masyarakat menyambut hari raya dengan gembira.","zh":"民众欢快地庆祝节日。"}},{"w":"sambutan","ipa":"/sam.bu.tan/","zh":"欢迎；致辞；反应","phrase":{"t":"kata sambutan","zh":"欢迎辞"},"example":{"t":"Pidato sambutan itu sangat inspiratif.","zh":"那篇欢迎辞非常鼓舞人心。"}},{"w":"penyambut","ipa":"/pə.ɲam.but/","zh":"迎接者；接待员","phrase":{"t":"penyambut tamu","zh":"接待员"},"example":{"t":"Dia bekerja sebagai penyambut tamu di hotel itu.","zh":"他在那家酒店担任接待员。"}},{"w":"menyambutkan","ipa":"/mə.ɲam.but.kan/","zh":"使……被迎接；用来迎接","phrase":{"t":"menyambutkan tamu","zh":"安排迎接客人"},"example":{"t":"Mereka menyambutkan karangan bunga untuk tamu kehormatan.","zh":"他们准备了花环来迎接贵宾。"}}],"derSlugs":["sambut","menyambut","sambutan","penyambut","menyambutkan"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-26T16:14:28.520Z","src":"base"}