{"root":"koreksi","ipa":"/ko.rɛk.si/","core":"指对错误、偏差或不准确之处进行的修正、校对或改正行为。","pos":["名词","动词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/ko.rɛk.si/","zh":"修正，校对，改正","phrases":[{"t":"koreksi diri","zh":"自我反省，自我纠正"},{"t":"melakukan koreksi","zh":"进行修正"},{"t":"koreksi warna","zh":"色彩校正"}],"examples":[{"t":"Guru memberikan koreksi pada tugas siswa.","zh":"老师对学生的作业进行了批改。"},{"t":"Perlu ada koreksi terhadap laporan keuangan ini.","zh":"这份财务报告需要进行修正。"}]},"ders":[{"w":"koreksi","ipa":"/ko.rɛk.si/","zh":"修正，校对","phrase":{"t":"koreksi kesalahan","zh":"错误修正"},"example":{"t":"Terima kasih atas koreksi Anda.","zh":"感谢您的指正。"}},{"w":"mengkoreksi","ipa":"/məŋ.ko.rɛk.si/","zh":"修正，批改（动词）","phrase":{"t":"mengkoreksi naskah","zh":"校对文稿"},"example":{"t":"Dia sedang mengkoreksi ujian murid-muridnya.","zh":"他正在批改学生们的试卷。"}},{"w":"terkoreksi","ipa":"/tər.ko.rɛk.si/","zh":"已被修正的","phrase":{"t":"data terkoreksi","zh":"已修正的数据"},"example":{"t":"Kesalahan itu sudah terkoreksi secara otomatis.","zh":"那个错误已经被自动修正了。"}},{"w":"korektor","ipa":"/ko.rɛk.tor/","zh":"校对员，校对器","phrase":{"t":"korektor naskah","zh":"文稿校对员"},"example":{"t":"Pekerjaan korektor sangat membutuhkan ketelitian.","zh":"校对员的工作非常需要细心。"}}],"derSlugs":["koreksi","mengkoreksi","terkoreksi","korektor"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-28T09:10:20.936Z","src":"base"}