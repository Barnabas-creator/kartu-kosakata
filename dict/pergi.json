{"root":"pergi","ipa":"/pər.ɡi/","core":"离开、去往某地，指从当前位置移动到另一个位置。","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/pər.ɡi/","zh":"离开、去","phrases":[{"t":"pergi ke sekolah","zh":"去学校"},{"t":"pergi jauh","zh":"远走高飞"},{"t":"pergi meninggalkan","zh":"离去"}],"examples":[{"t":"Dia pergi ke pasar pagi ini.","zh":"他今天早上去了市场。"},{"t":"Jangan pergi dulu, tunggu saya.","zh":"先别走，等我一下。"}]},"ders":[{"w":"pergi","ipa":"/pər.ɡi/","zh":"去、离开","phrase":{"t":"pergi berlibur","zh":"去度假"},"example":{"t":"Kami akan pergi besok.","zh":"我们明天要走。"}},{"w":"pergian","ipa":"/pər.ɡi.an/","zh":"出行、旅程","phrase":{"t":"pergian jauh","zh":"长途旅行"},"example":{"t":"Dia sedang bersiap untuk pergiannya.","zh":"他正在为他的出行做准备。"}},{"w":"bepergian","ipa":"/bə.pər.ɡi.an/","zh":"旅行、出差","phrase":{"t":"suka bepergian","zh":"喜欢旅行"},"example":{"t":"Dia sering bepergian ke luar negeri.","zh":"他经常出国旅行。"}},{"w":"kepergian","ipa":"/kə.pər.ɡi.an/","zh":"离开、去世","phrase":{"t":"kepergian mendadak","zh":"突然离世"},"example":{"t":"Kami sedih atas kepergiannya.","zh":"我们为他的离去感到悲伤。"}}],"derSlugs":["pergi","pergian","bepergian","kepergian"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:13:42.655Z","src":"base"}