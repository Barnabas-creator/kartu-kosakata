{"root":"itu","ipa":"/itu/","core":"指代远处的物体、人或概念，意为“那”、“那个”。","pos":["虚词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/itu/","zh":"那，那个，那儿","phrases":[{"t":"itu saja","zh":"仅此而已"},{"t":"seperti itu","zh":"像那样"},{"t":"bukan itu","zh":"不是那个"}],"examples":[{"t":"Siapa orang itu?","zh":"那个人是谁？"},{"t":"Saya tidak tahu tentang hal itu.","zh":"我不知道关于那件事的情况。"}]},"ders":[{"w":"itu","ipa":"/itu/","zh":"那，那个","phrase":{"t":"itu dia","zh":"就是那个"},"example":{"t":"Buku itu milik saya.","zh":"那本书是我的。"}},{"w":"begitu","ipa":"/bəɡitu/","zh":"那样，如此","phrase":{"t":"begitu saja","zh":"就这样"},"example":{"t":"Jangan bicara begitu.","zh":"别那样说话。"}},{"w":"begitupun","ipa":"/bəɡitupun/","zh":"同样地，也那样","phrase":{"t":"begitupun juga","zh":"同样也是"},"example":{"t":"Dia sedih, begitupun saya.","zh":"他很伤心，我也是。"}},{"w":"begitulah","ipa":"/bəɡitulah/","zh":"就是那样（表示感叹或总结）","phrase":{"t":"begitulah adanya","zh":"事实就是如此"},"example":{"t":"Begitulah nasib kami.","zh":"我们的命运就是如此。"}}],"derSlugs":["itu","begitu","begitupun","begitulah"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:10:28.184Z","src":"base"}