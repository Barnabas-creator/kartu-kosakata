{"root":"trauma","ipa":"/ˈtraʊ.ma/","core":"创伤，心灵创伤，精神打击","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈtraʊ.ma/","zh":"指由于外部暴力、灾难或严重心理刺激造成的身体伤害或精神创伤。","phrases":[{"t":"trauma psikologis","zh":"心理创伤"},{"t":"trauma masa kecil","zh":"童年阴影"},{"t":"pusat trauma","zh":"创伤中心"}],"examples":[{"t":"Pengalaman buruk itu meninggalkan trauma yang mendalam.","zh":"那次糟糕的经历留下了深刻的创伤。"},{"t":"Dia masih berjuang untuk mengatasi trauma masa lalunya.","zh":"他仍在努力克服过去的创伤。"}]},"ders":[{"w":"trauma","ipa":"/ˈtraʊ.ma/","zh":"创伤","phrase":{"t":"mengalami trauma","zh":"遭受创伤"},"example":{"t":"Trauma dapat disembuhkan dengan terapi.","zh":"创伤可以通过治疗治愈。"}},{"w":"traumatik","ipa":"/traʊˈma.tɪk/","zh":"创伤性的","phrase":{"t":"pengalaman traumatik","zh":"创伤性体验"},"example":{"t":"Itu adalah peristiwa yang sangat traumatik.","zh":"那是非常具创伤性的事件。"}},{"w":"traumatis","ipa":"/traʊˈma.tɪs/","zh":"造成创伤的，惊恐的","phrase":{"t":"dampak traumatis","zh":"创伤性影响"},"example":{"t":"Dampak traumatis itu masih dirasakan.","zh":"那种创伤性影响依然能被感受到。"}},{"w":"mentraumatis","ipa":"/mɛn.traʊˈma.tɪs/","zh":"使受创伤","phrase":{"t":"mentraumatis anak","zh":"使儿童受到创伤"},"example":{"t":"Peristiwa itu mentraumatis para korban.","zh":"那场事件使受害者们受到了精神创伤。"}},{"w":"tertrauma","ipa":"/tərˈtraʊ.ma/","zh":"受创伤的，留下阴影的","phrase":{"t":"merasa tertrauma","zh":"感到受了创伤"},"example":{"t":"Dia tertrauma setelah kecelakaan itu.","zh":"他在那场事故后留下了心理阴影。"}}],"derSlugs":["trauma","traumatik","traumatis","mentraumatis","tertrauma"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-28T04:32:28.064Z","src":"base"}