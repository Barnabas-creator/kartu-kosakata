{"root":"jika","ipa":"/ˈdʒika/","core":"表示假设条件的连词，意为“如果”、“假如”。用于引导条件从句，通常置于句首或主句之前。","pos":["虚词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/ˈdʒika/","zh":"如果，假如","phrases":[{"t":"jika saja","zh":"如果只是"},{"t":"jika mungkin","zh":"如果可能的话"},{"t":"jika tidak","zh":"如果不"}],"examples":[{"t":"Jika hujan turun, saya tidak akan pergi.","zh":"如果下雨，我就不去了。"},{"t":"Tolong beritahu saya jika Anda sudah sampai.","zh":"如果你到了，请告诉我。"}]},"ders":[{"w":"jika","ipa":"/ˈdʒika/","zh":"如果","phrase":{"t":"jika perlu","zh":"如果有必要"},"example":{"t":"Hubungi saya jika perlu bantuan.","zh":"如果需要帮助请联系我。"}},{"w":"sejika","ipa":"/səˈdʒika/","zh":"（罕见）如同如果，假若","phrase":{"t":"sejika itu benar","zh":"假若那是真的"},"example":{"t":"Sejika dia datang, kita akan mulai rapat.","zh":"假若他来了，我们就开始会议。"}}],"derSlugs":["jika","sejika"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:13:46.888Z","src":"base"}