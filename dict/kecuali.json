{"root":"kecuali","ipa":"/kəˈtʃuali/","core":"除了，排除在外，除非","pos":["虚词"],"scenes":["高频","工作","生活"],"rootBlock":{"ipa":"/kəˈtʃuali/","zh":"表示排除某人或某事，或作为连词表示条件","phrases":[{"t":"kecuali itu","zh":"除此之外"},{"t":"kecuali jika","zh":"除非"},{"t":"tanpa kecuali","zh":"无一例外"}],"examples":[{"t":"Semua orang hadir kecuali Budi.","zh":"除了布迪，所有人都出席了。"},{"t":"Saya tidak akan pergi kecuali dia ikut.","zh":"除非他去，否则我不会去。"}]},"ders":[{"w":"kecuali","ipa":"/kəˈtʃuali/","zh":"除了","phrase":{"t":"kecuali untuk","zh":"除了...之外"},"example":{"t":"Semua toko tutup kecuali toko buku.","zh":"除了书店，所有的商店都关门了。"}},{"w":"mengecualikan","ipa":"/məŋətʃualiˈkan/","zh":"排除，不包括","phrase":{"t":"mengecualikan diri","zh":"排除自己"},"example":{"t":"Aturan ini mengecualikan anak-anak.","zh":"这条规则将儿童排除在外。"}},{"w":"pengecualian","ipa":"/pəŋətʃualiˈan/","zh":"例外，除外","phrase":{"t":"tanpa pengecualian","zh":"毫无例外"},"example":{"t":"Ini adalah pengecualian dari aturan umum.","zh":"这是常规规则的一个例外。"}}],"derSlugs":["kecuali","mengecualikan","pengecualian"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:48:53.956Z","src":"base"}