{"root":"nama","ipa":"/ˈnama/","core":"名字，名称，名义","pos":["名词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈnama/","zh":"指代人、事物、地点或概念的称呼；亦可指名义或名声。","phrases":[{"t":"nama baik","zh":"好名声"},{"t":"atas nama","zh":"以...的名义"},{"t":"nama panggilan","zh":"昵称"}],"examples":[{"t":"Siapa nama Anda?","zh":"您叫什么名字？"},{"t":"Dia menulis namanya di buku itu.","zh":"他在那本书上写下了他的名字。"}]},"ders":[{"w":"nama","ipa":"/ˈnama/","zh":"名字","phrase":{"t":"nama keluarga","zh":"姓氏"},"example":{"t":"Tuliskan nama lengkap Anda.","zh":"请写下您的全名。"}},{"w":"menamai","ipa":"/məˈnamai/","zh":"给...命名","phrase":{"t":"menamai anak","zh":"给孩子取名"},"example":{"t":"Mereka menamai bayi itu Budi.","zh":"他们给那个婴儿取名为布迪。"}},{"w":"penamaan","ipa":"/pənaˈmaan/","zh":"命名，取名过程","phrase":{"t":"proses penamaan","zh":"命名过程"},"example":{"t":"Penamaan jalan itu dilakukan kemarin.","zh":"那条街道的命名仪式是昨天进行的。"}},{"w":"bernama","ipa":"/bərˈnama/","zh":"名叫，有名字的","phrase":{"t":"seorang pria bernama Andi","zh":"一个名叫安迪的男人"},"example":{"t":"Dia memiliki anjing bernama Bobby.","zh":"他有一只名叫博比的狗。"}}],"derSlugs":["nama","menamai","penamaan","bernama"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:22:56.343Z","src":"base"}