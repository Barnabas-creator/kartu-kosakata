{"root":"sandar","ipa":"/ˈsandar/","core":"靠，倚，依靠","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/ˈsandar/","zh":"依靠、靠着","phrases":[{"t":"sandar pada","zh":"依靠于"},{"t":"sandar di dinding","zh":"靠在墙上"},{"t":"tempat bersandar","zh":"依靠的地方"}],"examples":[{"t":"Jangan sandar di dinding yang baru dicat itu.","zh":"不要靠在刚刷过漆的墙上。"},{"t":"Kita harus sandar kepada kekuatan sendiri.","zh":"我们必须依靠自己的力量。"}]},"ders":[{"w":"sandar","ipa":"/ˈsandar/","zh":"靠，倚","phrase":{"t":"sandar badan","zh":"靠住身体"},"example":{"t":"Dia sandar ke bahu temannya.","zh":"他靠在朋友的肩膀上。"}},{"w":"bersandar","ipa":"/bərˈsandar/","zh":"靠着，依靠","phrase":{"t":"bersandar pada","zh":"依靠"},"example":{"t":"Anak itu bersandar di dada ibunya.","zh":"那孩子靠在母亲的胸口。"}},{"w":"menyandarkan","ipa":"/məɲanˈdarkan/","zh":"使靠着，把...靠在","phrase":{"t":"menyandarkan sepeda","zh":"把自行车靠好"},"example":{"t":"Dia menyandarkan sepedanya di pohon.","zh":"他把自行车靠在树上。"}},{"w":"tersandar","ipa":"/tərˈsandar/","zh":"被靠着，无意中靠着","phrase":{"t":"tersandar lelah","zh":"疲惫地靠着"},"example":{"t":"Kepalanya tersandar di kursi.","zh":"他的头靠在椅子上。"}},{"w":"sandaran","ipa":"/sanˈdaran/","zh":"靠背，依靠，支撑物","phrase":{"t":"sandaran kursi","zh":"椅子靠背"},"example":{"t":"Kursi ini memiliki sandaran yang empuk.","zh":"这把椅子有一个柔软的靠背。"}}],"derSlugs":["sandar","bersandar","menyandarkan","tersandar","sandaran"],"model":"gemini-3.5-flash-lite","createdAt":"2026-09-28T09:18:13.214Z","src":"base"}