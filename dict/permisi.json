{"root":"permisi","ipa":"/pər.mi.si/","core":"借光、打扰一下、请问（用于礼貌地引起注意或请求通过）","pos":["虚词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/pər.mi.si/","zh":"用于礼貌地请求通行或引起他人注意的表达方式，源自荷兰语“permissie”。","phrases":[{"t":"permisi dulu","zh":"先告辞了"},{"t":"minta permisi","zh":"请求许可"},{"t":"permisi ya","zh":"打扰一下（礼貌用语）"}],"examples":[{"t":"Permisi, bolehkah saya lewat?","zh":"打扰一下，我可以过去吗？"},{"t":"Saya permisi pulang duluan.","zh":"我先告辞回家了。"}]},"ders":[{"w":"permisi","ipa":"/pər.mi.si/","zh":"借光、打扰一下","phrase":{"t":"permisi sebentar","zh":"打扰一下片刻"},"example":{"t":"Permisi, apakah ini tempat duduk Anda?","zh":"打扰一下，这是您的座位吗？"}},{"w":"berpermisi","ipa":"/bər.pər.mi.si/","zh":"请求许可、告辞","phrase":{"t":"berpermisi kepada tamu","zh":"向客人告辞"},"example":{"t":"Dia berpermisi sebelum meninggalkan ruangan.","zh":"他在离开房间前请求许可（告辞）。"}}],"derSlugs":["permisi","berpermisi"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:49:34.464Z","src":"base"}