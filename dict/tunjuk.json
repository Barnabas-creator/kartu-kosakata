{"root":"tunjuk","ipa":"/tun.dʒʊk/","core":"指，指出，显示，表明","pos":["动词"],"scenes":["高频","生活"],"rootBlock":{"ipa":"/tun.dʒʊk/","zh":"指，指出，显示","phrases":[{"t":"tunjuk jalan","zh":"指路"},{"t":"tunjuk gigi","zh":"露齿（示威或威胁）"},{"t":"tunjuk muka","zh":"露面"}],"examples":[{"t":"Dia menunjuk ke arah gunung itu.","zh":"他指向那座山的方向。"},{"t":"Tolong tunjuk cara melakukannya.","zh":"请演示一下怎么做。"}]},"ders":[{"w":"tunjuk","ipa":"/tun.dʒʊk/","zh":"指，指出","phrase":{"t":"tunjuk arah","zh":"指明方向"},"example":{"t":"Jangan tunjuk orang lain.","zh":"不要指责别人。"}},{"w":"menunjuk","ipa":"/mə.nun.dʒʊk/","zh":"指着，指向","phrase":{"t":"menunjuk ke atas","zh":"指向上面"},"example":{"t":"Jari telunjuknya menunjuk ke peta.","zh":"他的食指指着地图。"}},{"w":"menunjukkan","ipa":"/mə.nun.dʒʊk.kan/","zh":"展示，表明，证明","phrase":{"t":"menunjukkan bukti","zh":"出示证据"},"example":{"t":"Hasil ini menunjukkan kemajuan.","zh":"这些结果表明了进步。"}},{"w":"petunjuk","ipa":"/pə.tun.dʒʊk/","zh":"指示，线索，指南","phrase":{"t":"petunjuk jalan","zh":"路标"},"example":{"t":"Ikuti petunjuk yang diberikan.","zh":"遵循给出的指示。"}},{"w":"pertunjukan","ipa":"/pər.tun.dʒʊk.kan/","zh":"表演，演出","phrase":{"t":"pertunjukan seni","zh":"艺术表演"},"example":{"t":"Kami menonton pertunjukan tari.","zh":"我们观看了舞蹈表演。"}},{"w":"tertunjuk","ipa":"/tər.tun.dʒʊk/","zh":"被指出的，被选中的","phrase":{"t":"orang tertunjuk","zh":"被选中者"},"example":{"t":"Dia adalah orang yang tertunjuk untuk tugas ini.","zh":"他是被选中执行这项任务的人。"}}],"derSlugs":["tunjuk","menunjuk","menunjukkan","petunjuk","pertunjukan","tertunjuk"],"model":"gemini-3.1-flash-lite","createdAt":"2026-09-25T09:28:10.679Z","src":"base"}